@model StockPortal.Models.DeviceForm
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = $"{Loc["Edit Device Form"]}: {Model.Name}";
    var availableTeams = ViewBag.AvailableTeams as string[] ?? StockPortal.Models.MaintenanceTeams.All;
    bool isMaintenance = CurrentUser.IsMaintenance();
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-shapes text-primary me-2"></i> @Loc["Edit Device Form"]: @Model.Name</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="deviceFormEditor">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Form" id="hiddenFormJson" />
                    <input type="hidden" asp-for="InstallableSoftwares" id="hiddenSoftwaresJson" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold">@(Loc.IsArabic ? "نوع الجهاز / اسم النموذج" : "Device Type / Template Name") <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold">@Loc["Target Maintenance Team"] <span class="text-danger">*</span></label>
                            @if (isMaintenance)
                            {
                                <input type="text" class="form-control bg-light fw-bold" value="@Loc.TargetTeam(Model.Department)" readonly />
                                <input type="hidden" asp-for="Department" />
                                <div class="form-text small text-success"><i class="fa-solid fa-lock me-1"></i> @(Loc.IsArabic ? "مقفل وفقاً لاختصاص فريق الصيانة الخاص بك." : "Locked to your maintenance engineering discipline.")</div>
                            }
                            else
                            {
                                <select asp-for="Department" class="form-select">
                                    @foreach (var t in availableTeams)
                                    {
                                        <option value="@t" selected="@(Model.Department == t)">@Loc.TargetTeam(t)</option>
                                    }
                                </select>
                            }
                        </div>
                    </div>

                    <!-- Installable Software Configuration -->
                    <div class="card bg-white border mb-4 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">
                                        <i class="fa-solid fa-laptop-code text-primary me-2"></i>
                                        @(Loc.IsArabic ? "هل توجد برامج يمكن تثبيتها على هذا الأصل؟" : "Are there softwares installable on this asset?")
                                    </h6>
                                    <div class="text-muted small">
                                        @(Loc.IsArabic ? "فعّل هذا الخيار إذا كان هذا الجهاز (مثل الحواسيب والمحطات والخوادم) يدعم تثبيت برامج وتطبيقات." : "Enable if this equipment (e.g. workstations, laptops, servers) supports installable softwares and applications.")
                                    </div>
                                </div>
                                <div class="form-check form-switch fs-4 mb-0">
                                    <input type="checkbox" asp-for="HasSoftware" class="form-check-input" id="chkHasSoftware" role="switch" />
                                </div>
                            </div>

                            <div id="softwareListSection" class="mt-3 pt-3 border-top" style="display: none;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="fw-semibold text-dark">
                                            <i class="fa-solid fa-cubes text-primary me-1"></i>
                                            @(Loc.IsArabic ? "قائمة البرامج القابلة للتثبيت" : "Installable Softwares List")
                                        </span>
                                        <small class="text-muted d-block">
                                            @(Loc.IsArabic ? "أدخل أسماء البرامج المتاحة يدوياً، وستظهر كخيارات متعددة عند إضافة أصل من هذا النوع" : "Enter software names manually. They will appear as multi-check options when registering an asset of this type.")
                                        </small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary" id="btnAddSoftwareLine">
                                        <i class="fa-solid fa-plus me-1"></i> @(Loc.IsArabic ? "إضافة سطر برنامج" : "Add Software Line")
                                    </button>
                                </div>

                                <div id="softwaresContainer" class="d-flex flex-column gap-2 mb-2">
                                    <!-- Dynamic software lines -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Visual Field Builder -->
                    <div class="card bg-light border mb-4">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-list-check text-primary me-2"></i> @Loc["Dynamic Specification Fields"]</h6>
                                <small class="text-muted">@(Loc.IsArabic ? "تعديل أو إضافة حقول مخصصة لنموذج مواصفات هذا الجهاز" : "Modify or add custom fields for this equipment specification form")</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" id="btnAddField">
                                <i class="fa-solid fa-plus me-1"></i> @Loc["Add Field"]
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-bordered align-middle mb-0" id="fieldsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 25%;">@Loc["Field Display Label"] <span class="text-danger">*</span></th>
                                            <th style="width: 20%;">@Loc["Variable Key"] <span class="text-danger">*</span></th>
                                            <th style="width: 15%;">@Loc["Field Type"]</th>
                                            <th style="width: 25%;">@Loc["Dropdown Options (Comma-separated)"]</th>
                                            <th style="width: 10%;" class="text-center">@Loc["Required?"]</th>
                                            <th style="width: 5%;" class="text-center">@Loc["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody id="fieldsContainer">
                                        <!-- Populated from existing JSON -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="fa-solid fa-floppy-disk me-1"></i> @Loc["Update Device Form"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isAr = document.documentElement.dir === 'rtl' || document.documentElement.lang.startsWith('ar');
        const fieldsContainer = document.getElementById("fieldsContainer");
        const btnAddField = document.getElementById("btnAddField");
        const formEl = document.getElementById("deviceFormEditor");
        const hiddenFormJson = document.getElementById("hiddenFormJson");
        const chkHasSoftware = document.getElementById("chkHasSoftware");
        const softwareSection = document.getElementById("softwareListSection");
        const btnAddSoftwareLine = document.getElementById("btnAddSoftwareLine");
        const softwaresContainer = document.getElementById("softwaresContainer");
        const hiddenSoftwaresJson = document.getElementById("hiddenSoftwaresJson");

        let initialSoftwares = [];
        try {
            initialSoftwares = JSON.parse(hiddenSoftwaresJson.value || "[]");
        } catch(e) {
            initialSoftwares = [];
        }

        function createSoftwareRow(name = "") {
            const row = document.createElement("div");
            row.className = "input-group software-row";
            row.innerHTML = `
                <span class="input-group-text bg-light text-primary"><i class="fa-solid fa-cube"></i></span>
                <input type="text" class="form-control software-line-input" value="${name ? name.replace(/"/g, '&quot;') : ''}" placeholder="${isAr ? 'أدخل اسم البرنامج يدوياً (مثال: Windows 11 Pro، حزمة Office 365، نظام PACS...)' : 'Enter software name manually (e.g. Windows 11 Pro, Office 365, PACS Viewer...)'}" />
                <button type="button" class="btn btn-outline-danger btn-remove-software" title="${isAr ? 'حذف السطر' : 'Remove Line'}"><i class="fa-solid fa-trash-can"></i></button>
            `;

            const inputEl = row.querySelector(".software-line-input");
            inputEl.addEventListener("keydown", function(e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    createSoftwareRow();
                }
            });

            row.querySelector(".btn-remove-software").addEventListener("click", function() {
                row.remove();
            });

            softwaresContainer.appendChild(row);
            inputEl.focus();
        }

        function toggleSoftwareSection() {
            if (chkHasSoftware && chkHasSoftware.checked) {
                softwareSection.style.display = "block";
                if (softwaresContainer.children.length === 0) {
                    createSoftwareRow();
                }
            } else if (softwareSection) {
                softwareSection.style.display = "none";
            }
        }

        if (chkHasSoftware) {
            chkHasSoftware.addEventListener("change", toggleSoftwareSection);
        }

        if (initialSoftwares.length > 0) {
            initialSoftwares.forEach(sw => createSoftwareRow(sw));
        }

        toggleSoftwareSection();

        if (btnAddSoftwareLine) {
            btnAddSoftwareLine.addEventListener("click", function() {
                createSoftwareRow();
            });
        }

        let initialFields = [];
        try {
            initialFields = JSON.parse(hiddenFormJson.value || "[]");
        } catch(e) {
            initialFields = [];
        }

        function createRow(field, index) {
            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td>
                    <input type="text" class="form-control form-control-sm field-label" value="${field.label || ''}" placeholder="${isAr ? 'مثال: المعالج / الذاكرة' : 'e.g. Processor / CPU'}" required />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm font-monospace field-name" value="${field.name || ''}" placeholder="e.g. CPU" required />
                </td>
                <td>
                    <select class="form-select form-select-sm field-type">
                        <option value="text" ${field.type === 'text' ? 'selected' : ''}>${isAr ? 'نص مدخل' : 'Text Input'}</option>
                        <option value="select" ${field.type === 'select' ? 'selected' : ''}>${isAr ? 'قائمة منسدلة' : 'Dropdown Select'}</option>
                        <option value="number" ${field.type === 'number' ? 'selected' : ''}>${isAr ? 'رقمي' : 'Numeric'}</option>
                        <option value="textarea" ${field.type === 'textarea' ? 'selected' : ''}>${isAr ? 'نص متعدد الأسطر' : 'Multi-line Text'}</option>
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm field-options" value="${(field.options || []).join(', ')}" placeholder="${isAr ? 'مثال: خيار 1، خيار 2' : 'e.g. Option 1, Option 2'}" ${field.type === 'select' ? '' : 'disabled'} />
                </td>
                <td class="text-center">
                    <input type="checkbox" class="form-check-input field-required" ${field.required ? 'checked' : ''} />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="fa-solid fa-trash-can"></i></button>
                </td>
            `;

            const labelInput = tr.querySelector(".field-label");
            const nameInput = tr.querySelector(".field-name");
            labelInput.addEventListener("input", function() {
                if (!nameInput.dataset.touched) {
                    nameInput.value = labelInput.value.replace(/[^a-zA-Z0-9]/g, '');
                }
            });
            nameInput.addEventListener("input", function() {
                nameInput.dataset.touched = "true";
            });

            const typeSelect = tr.querySelector(".field-type");
            const optionsInput = tr.querySelector(".field-options");
            typeSelect.addEventListener("change", function() {
                if (typeSelect.value === "select") {
                    optionsInput.disabled = false;
                    optionsInput.placeholder = isAr ? "مثال: خيار أ، خيار ب، خيار ج" : "e.g. Option A, Option B, Option C";
                } else {
                    optionsInput.disabled = true;
                    optionsInput.placeholder = isAr ? "غير متاح للنص/الرقم" : "N/A for text/number";
                }
            });

            tr.querySelector(".btn-remove").addEventListener("click", function() {
                tr.remove();
            });

            fieldsContainer.appendChild(tr);
        }

        initialFields.forEach((f, idx) => createRow(f, idx));

        btnAddField.addEventListener("click", function () {
            createRow({ name: "", label: "", type: "text", options: [], required: false }, fieldsContainer.children.length);
        });

        formEl.addEventListener("submit", function (e) {
            const rows = fieldsContainer.querySelectorAll("tr");
            const fields = [];

            rows.forEach(tr => {
                const label = tr.querySelector(".field-label").value.trim();
                let name = tr.querySelector(".field-name").value.trim();
                const type = tr.querySelector(".field-type").value;
                const optionsRaw = tr.querySelector(".field-options").value;
                const required = tr.querySelector(".field-required").checked;

                if (!name && label) {
                    name = label.replace(/[^a-zA-Z0-9]/g, '');
                }

                if (label && name) {
                    const options = (type === "select" && optionsRaw)
                        ? optionsRaw.split(",").map(s => s.trim()).filter(s => s.length > 0)
                        : [];

                    fields.push({
                        name: name,
                        label: label,
                        type: type,
                        options: options,
                        required: required
                    });
                }
            });

            if (fields.length === 0) {
                alert(isAr ? "يرجى تحديد حقل مواصفات واحد على الأقل لهذا الجهاز." : "Please define at least one specification field for this device.");
                e.preventDefault();
                return false;
            }

            hiddenFormJson.value = JSON.stringify(fields);

            if (chkHasSoftware && chkHasSoftware.checked) {
                const swInputs = softwaresContainer.querySelectorAll(".software-line-input");
                const softwares = [];
                swInputs.forEach(inp => {
                    const val = inp.value.trim();
                    if (val && !softwares.includes(val)) softwares.push(val);
                });
                hiddenSoftwaresJson.value = JSON.stringify(softwares);
            } else if (hiddenSoftwaresJson) {
                hiddenSoftwaresJson.value = "[]";
            }
        });
    });
</script>
}
