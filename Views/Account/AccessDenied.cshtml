@{
    Layout = null;
    string reason = (ViewBag.Reason as string) ?? "NotFound";
    string username = (ViewBag.Username as string) ?? Environment.UserName;
    string pcName = (ViewBag.PcName as string) ?? Environment.MachineName;
    string clientIp = (ViewBag.ClientIp as string) ?? "127.0.0.1";
    var asset = ViewBag.MatchedAsset as StockPortal.Models.Asset;
    var rooms = ViewBag.Rooms as List<StockPortal.Models.Room> ?? new();
    int? submittedTicketId = TempData["SubmittedTicketId"] as int?;

    bool isTicketSubmitted = reason.Equals("TicketSubmitted", StringComparison.OrdinalIgnoreCase) || submittedTicketId.HasValue;
    bool isInactive = reason.Equals("Inactive", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="@Loc.CurrentCulture" dir="@Loc.Direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Loc.IsArabic ? "تم تقييد الوصول - بوابة العهد والتذاكر" : "Access Denied - Stock & Ticket Portal")</title>
    
    <!-- Google Fonts: Cairo (Arabic) & Inter (English) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 (RTL / LTR) & FontAwesome 6 CDN -->
    @if (Loc.IsArabic)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        body {
            font-family: @(Loc.IsArabic ? "'Cairo', " : "") 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            color: #1e293b;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 1.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
            max-width: 680px;
            width: 100%;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .auth-header {
            padding: 2.25rem 2rem 1.25rem 2rem;
            text-align: center;
        }

        .icon-circle {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .icon-inactive {
            background-color: #fef2f2;
            color: #ef4444;
            border: 3px solid #fecaca;
        }

        .icon-notfound {
            background-color: #fffbeb;
            color: #d97706;
            border: 3px solid #fde68a;
        }

        .icon-submitted {
            background-color: #f0fdf4;
            color: #16a34a;
            border: 3px solid #bbf7d0;
        }

        .diagnostic-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            padding: 0.85rem 1.15rem;
            font-size: 0.85rem;
        }

        .auto-ticket-panel {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 0.85rem;
            padding: 1.35rem;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        @if (reason.Equals("ForbiddenResource", StringComparison.OrdinalIgnoreCase))
        {
            var currentUser = ViewBag.CurrentUser as StockPortal.Models.User;
            <div class="auth-header">
                <div class="icon-circle icon-inactive">
                    <i class="fa-solid fa-ban"></i>
                </div>
                <h3 class="fw-bold text-danger mb-2">@Loc["403 - Access Forbidden"]</h3>
                <p class="text-muted mb-0">
                    @(Loc.IsArabic ? "ليس لديك الصلاحية اللازمة للوصول إلى هذا المورد أو تعديله." : "You do not have permission to view or modify the requested resource.")
                </p>
            </div>
            <div class="px-4 pb-4">
                <div class="alert alert-warning border-0 small mb-4">
                    <div><strong>@(Loc.IsArabic ? "الحساب الحالي:" : "Logged In Identity:")</strong> @(currentUser?.DisplayFullName ?? (Loc.IsArabic ? "موظف" : "Staff Member")) (@(currentUser?.DisplayRole ?? "END_USER"))</div>
                    @if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.MaintenanceTeam))
                    {
                        <div><strong>@(Loc.IsArabic ? "الفريق المسند:" : "Assigned Team:")</strong> @Loc.TargetTeam(currentUser.MaintenanceTeam)</div>
                    }
                    <div class="mt-2 text-dark">
                        @(Loc.IsArabic ? "وفقاً لصلاحيات النظام (RBAC)، لا يمكن عرض أو تعديل الأجهزة والتذاكر التابعة لأقسام أخرى." : "Under Role-Based Access Control (RBAC), hospital equipment and tickets belonging to other departments cannot be viewed or edited.")
                    </div>
                </div>
                <div class="d-grid gap-2 mb-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                        <i class="fa-solid fa-house me-1"></i> @Loc["Return to Main Dashboard"]
                    </a>
                    <a href="@Url.Action("Index", "Assets")" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-boxes-stacked me-1"></i> @Loc["Back to Hospital Assets"]
                    </a>
                </div>
            </div>
        }
        else if (isTicketSubmitted)
        {
            <div class="auth-header">
                <div class="icon-circle icon-submitted">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h3 class="fw-bold text-success mb-2">@(Loc.IsArabic ? "تم إرسال تذكرة الدعم الآلية بنجاح!" : "Automated Support Ticket Dispatched!")</h3>
                <p class="text-muted mb-0">
                    @(Loc.IsArabic ? "تم فتح تذكرة دعم فني مباشرة في قائمة مهام الدعم الفني الخاصة بجهازك." : "A technical support ticket has been created directly in the IT queue for your workstation.")
                </p>
            </div>
            <div class="px-4 pb-4">
                <div class="alert alert-success border-0 shadow-xs mb-4">
                    <div class="d-flex align-items-center gap-2 fw-bold fs-5 mb-1">
                        <i class="fa-solid fa-ticket"></i>
                        <span>@(Loc.IsArabic ? "رقم مرجع التذكرة:" : "Ticket Reference:") #@(submittedTicketId ?? 0)</span>
                    </div>
                    <div class="small">
                        @(Loc.IsArabic ? $"تم إرسال بيانات الجهاز (اسم الجهاز: {pcName}، العنوان: {clientIp}) والملاحظات إلى فريق الدعم الفني." : $"Your workstation telemetry (PC: {pcName}, IP: {clientIp}) and issue notes were forwarded to IT Helpdesk.")
                    </div>
                </div>
                <div class="d-grid gap-2 mb-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-rotate-right me-1"></i> @Loc["Retry Login"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="auth-header">
                @if (isInactive)
                {
                    <div class="icon-circle icon-inactive">
                        <i class="fa-solid fa-user-lock"></i>
                    </div>
                    <h3 class="fw-bold text-danger mb-1">@Loc["Account Deactivated"]</h3>
                    <p class="text-muted mb-0 small">
                        @(Loc.IsArabic ? "حساب الجهاز" : "Your PC username") <code class="fw-bold text-dark bg-light px-2 py-0.5 rounded">@username</code> @(Loc.IsArabic ? "مسجل في النظام ولكن حالته معطل." : "is registered but marked Inactive.")
                    </p>
                }
                else
                {
                    <div class="icon-circle icon-notfound">
                        <i class="fa-solid fa-user-xmark"></i>
                    </div>
                    <h3 class="fw-bold text-warning-emphasis mb-1">@Loc["Access Restricted"]</h3>
                    <p class="text-muted mb-0 small">
                        @(Loc.IsArabic ? "مستخدم الجهاز" : "Workstation user") <code class="fw-bold text-dark bg-light px-2 py-0.5 rounded">@username</code> @(Loc.IsArabic ? "غير مسجل في دليل المستخدمين المصرح لهم." : "is not recognized in the authorized user directory.")
                    </p>
                }
            </div>

            <div class="px-4 pb-4">
                <!-- Status Diagnostic Strip -->
                <div class="diagnostic-box mb-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <span class="text-muted small">@Loc["PC / Windows Username"]:</span>
                            <span class="font-monospace fw-bold text-dark d-block">@username</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small">@Loc["Machine / Host:"]:</span>
                            <span class="font-monospace text-primary fw-semibold d-block">@pcName</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small">@Loc["Status"]:</span>
                            <span class="badge @(isInactive ? "bg-danger" : "bg-warning text-dark")">@(Loc.IsArabic ? "مرفوض (403 غير مصرح)" : "Rejected (403 Forbidden)")</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small">@Loc["Asset Tag"]:</span>
                            <span class="text-dark fw-semibold">@(asset?.HospitalNo ?? (Loc.IsArabic ? "غير مسجل" : "Unregistered"))</span>
                        </div>
                    </div>
                </div>

                <!-- Automated PC Ticket Section (Appears ONLY when user cannot login) -->
                <div class="auto-ticket-panel mb-3">
                    <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                        <div class="stat-icon bg-warning bg-opacity-25 text-warning-emphasis p-2 rounded" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">@Loc["Generate Automated Support Ticket"]</h6>
                            <span class="text-muted" style="font-size: 0.75rem;">@(Loc.IsArabic ? "فتح تذكرة دعم فني آلية مع إرسال بيانات الجهاز وموقعه." : "Opens an automated technical ticket for IT support with your PC telemetry.")</span>
                        </div>
                    </div>

                    <form asp-action="SubmitAccessTicket" method="post" id="accessTicketForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="pcName" value="@pcName" />
                        <input type="hidden" name="assetId" value="@(asset?.Id)" />

                        <!-- Workstation Specs Readout -->
                        <div class="row g-2 mb-3 small">
                            <div class="col-md-6">
                                <span class="text-muted d-block" style="font-size: 0.72rem;">@Loc["Stock & Assets"]:</span>
                                <strong class="text-dark">@(asset != null ? $"{asset.Brand} {asset.ModelNo} (S/N: {asset.SerialNo})" : (Loc.IsArabic ? "جهاز كمبيوتر (غير مرقم)" : "Workstation (Not Tagged)"))</strong>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted d-block" style="font-size: 0.72rem;">@(Loc.IsArabic ? "تأكيد الغرفة / الموقع:" : "Confirm Room / Location:")</label>
                                <select name="roomId" class="form-select form-select-sm">
                                    <option value="">@(Loc.IsArabic ? "-- اختر الغرفة / المكتب --" : "-- Select Your Room / Office --")</option>
                                    @foreach (var r in rooms)
                                    {
                                        <option value="@r.Id" selected="@(asset?.RoomId == r.Id)">@r.DisplayName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Quick Request Templates -->
                        <div class="mb-2">
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 quick-chip" style="font-size: 0.72rem;"
                                        data-msg="@(Loc.IsArabic ? $"يرجى تفعيل حسابي للجهاز {pcName}. أحتاج الصلاحية للعمل اليومي." : $"Please activate my account for workstation {pcName}. I require access for daily operations.")">
                                    🔑 @(Loc.IsArabic ? "طلب تفعيل الحساب" : "Request Activation")
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 quick-chip" style="font-size: 0.72rem;"
                                        data-msg="@(Loc.IsArabic ? $"تم نقل الجهاز {pcName} لي مؤخراً. يرجى تسجيل مستخدم الحاسوب '{username}' في الدليل." : $"Workstation {pcName} recently reassigned. Please register PC username '{username}' in the directory.")">
                                    🖥️ @(Loc.IsArabic ? "جهاز جديد" : "New Workstation")
                                </button>
                                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2 quick-chip" style="font-size: 0.72rem;"
                                        data-msg="@(Loc.IsArabic ? "عاجل: لا يمكن الوصول للنظام من قبل الكادر. يرجى التدخل الفوري." : "Urgent: Clinical/department staff member locked out. Immediate IT assistance required.")">
                                    🚨 @(Loc.IsArabic ? "مساعدة عاجلة" : "Urgent Assistance")
                                </button>
                            </div>
                        </div>

                        <!-- Manual Notes Box (Editable by User) -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-dark mb-1">
                                <i class="fa-solid fa-pen me-1 text-primary"></i> @(Loc.IsArabic ? "ملاحظات / وصف المشكلة (قابل للتعديل):" : "Notes / Issue Description (Editable):")
                            </label>
                            <textarea name="notes" id="ticketNotes" class="form-control form-control-sm" rows="3"
                                      placeholder="@(Loc.IsArabic ? "اشرح طلبك أو المشكلة التي تمنعك من الدخول..." : "Explain your access request or describe the issue preventing you from logging in...")" required>@(Loc.IsArabic ? $"يرجى مراجعة صلاحيات الحساب '{username}' على الجهاز '{pcName}'." : $"Please review access for PC username '{username}' on workstation '{pcName}'. Account is currently rejected.")</textarea>
                            <div class="form-text small" style="font-size: 0.7rem;">
                                @(Loc.IsArabic ? "سيتم إرسال هذه الملاحظات مباشرة إلى قسم الدعم الفني." : "These notes will be sent directly to the IT helpdesk queue.")
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-sm text-dark fw-bold py-2 shadow-xs d-flex align-items-center justify-content-center gap-2">
                                <i class="fa-solid fa-paper-plane"></i>
                                <span>@Loc["Submit Support Ticket to IT"]</span>
                            </button>
                        </div>
                    </form>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 text-muted small" style="font-size: 0.75rem;">
                    <span>@(Loc.IsArabic ? "الدعم الفني للمستشفى • التحويلة الداخلية: " : "Hospital Helpdesk • Internal Ext: ")<strong>4444</strong></span>
                    <a href="@Url.Action("Index", "Home")" class="text-decoration-none">
                        <i class="fa-solid fa-rotate-right me-1"></i> @Loc["Retry Login"]
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.quick-chip').forEach(btn => {
            btn.addEventListener('click', function () {
                const box = document.getElementById('ticketNotes');
                if (box) {
                    box.value = this.getAttribute('data-msg');
                    box.focus();
                }
            });
        });
    </script>
</body>
</html>
