@model StockPortal.ViewModels.LoginViewModel
@inject StockPortal.Services.ILocalizationService Loc
@{
    Layout = null;
    var isArabic = Loc.IsArabic;
    var currentCulture = Loc.CurrentCulture;
    var dir = Loc.Direction;
    var returnUrl = Model?.ReturnUrl;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(isArabic ? "تسجيل الدخول - نظام سولفيس الطبي" : "Sign In - SOLVIS Hospital System")</title>
    <link rel="icon" type="image/png" href="~/images/solvis-icon-transparent.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    
    <!-- Google Fonts: Cairo (Arabic) & Inter (English) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 (RTL / LTR) & FontAwesome 6 CDN -->
    @if (isArabic)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        body {
            font-family: @(isArabic ? "'Cairo', " : "") 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            color: #1e293b;
        }

        .auth-card {
            background: #ffffff;
            border-radius: 1.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45);
            max-width: 480px;
            width: 100%;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .auth-header {
            padding: 2.5rem 2rem 1.25rem 2rem;
            text-align: center;
            background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
            border-bottom: 1px solid #f1f5f9;
        }

        .brand-icon {
            width: 68px;
            height: 68px;
            border-radius: 1rem;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 2rem;
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
            margin-bottom: 1rem;
        }

        .auth-body {
            padding: 2rem;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            transform: scale(.85) translateY(-0.75rem) translateX(0.15rem);
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: #94a3b8;
            font-size: 0.85rem;
        }
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e2e8f0;
        }
        .divider:not(:empty)::before {
            margin-@(isArabic ? "left" : "right"): .75em;
        }
        .divider:not(:empty)::after {
            margin-@(isArabic ? "right" : "left"): .75em;
        }

        .telemetry-bar {
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            padding: 0.85rem 1.5rem;
            font-size: 0.8rem;
            color: #64748b;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <!-- Top bar with Language Switcher -->
        <div class="d-flex justify-content-between align-items-center px-4 pt-3">
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 py-1 px-2">
                <i class="fa-solid fa-hospital me-1"></i> SOLVIS
            </span>
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-globe me-1"></i> @(isArabic ? "العربية" : "English")
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><a class="dropdown-item @(isArabic ? "active" : "")" href="?culture=ar"><i class="fa-solid fa-check me-2 @(isArabic ? "" : "invisible")"></i> العربية</a></li>
                    <li><a class="dropdown-item @(!isArabic ? "active" : "")" href="?culture=en"><i class="fa-solid fa-check me-2 @(!isArabic ? "" : "invisible")"></i> English</a></li>
                </ul>
            </div>
        </div>

        <!-- Header -->
        <div class="auth-header">
            <div class="brand-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h4 class="fw-bold mb-1 text-dark">@(isArabic ? "تسجيل الدخول إلى النظام" : "Sign In to SOLVIS")</h4>
            <p class="text-muted small mb-0">
                @(isArabic ? "أدخل اسم المستخدم وكلمة المرور للدخول إلى البوابة" : "Enter your username and password to access the portal")
            </p>
        </div>

        <!-- Body -->
        <div class="auth-body">
            @{
                bool canAccessPassword = ViewBag.CanAccessUsingUsernameAndPassword ?? true;
                bool canAccessWindowsAuth = ViewBag.CanAccessUsingWindowsAuth ?? true;
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center mb-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2 fs-5 flex-shrink-0"></i>
                    <div>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0 text-danger" })
                    </div>
                </div>
            }

            @if (canAccessPassword)
            {
                <form asp-action="Login" asp-controller="Account" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Username -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold small text-muted">
                            @(isArabic ? "اسم المستخدم أو النطاق" : "Username / Domain")
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="fa-solid fa-user"></i>
                            </span>
                            <input asp-for="Username" class="form-control" placeholder="@(isArabic ? "مثال: abbas أو hOuta" : "e.g. abbas or hOuta")" required autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-semibold small text-muted mb-0">
                                @(isArabic ? "كلمة المرور" : "Password")
                            </label>
                        </div>
                        <div class="input-group mt-1">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="••••••••" required />
                            <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePasswordVisibility()">
                                <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Remember Me -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                            <label class="form-check-label small text-muted" for="rememberMeCheck">
                                @(isArabic ? "تذكرني على هذا الجهاز" : "Remember me on this device")
                            </label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span>@(isArabic ? "تسجيل الدخول" : "Log In")</span>
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-3">
                    <i class="fa-solid fa-circle-info me-2 fs-5 flex-shrink-0"></i>
                    <div>
                        @(isArabic ? "تسجيل الدخول باستخدام كلمة المرور معطل حالياً من قبل مسؤول النظام." : "Username & password login is currently disabled by system administrator.")
                    </div>
                </div>
            }

            @if (canAccessPassword && canAccessWindowsAuth)
            {
                <div class="divider">@(isArabic ? "أو الدخول عبر النطاق" : "or Windows SSO")</div>
            }

            @if (canAccessWindowsAuth)
            {
                <!-- Windows SSO One-Click Auto-Login -->
                <a asp-action="AutoLogin" asp-controller="Account" asp-route-returnUrl="@returnUrl" class="btn btn-light border w-100 py-2 d-flex align-items-center justify-content-center gap-2 text-dark">
                    <i class="fa-brands fa-windows text-primary fs-5"></i>
                    <span class="fw-semibold">@(isArabic ? "الدخول التلقائي بحساب ويندوز (SSO)" : "Sign In with Windows Domain (Auto-Login)")</span>
                </a>
                <div class="text-center mt-2">
                    <small class="text-muted">
                        @(isArabic ? "متاح للأجهزة والحواسيب المرتبطة بنطاق المستشفى المحلي" : "Available for domain workstations on hospital LAN")
                    </small>
                </div>
            }
        </div>

        <!-- Telemetry & Support Footer -->
        <div class="telemetry-bar d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <i class="fa-solid fa-network-wired me-1 text-primary"></i>
                <span>IP: <strong>@(ViewBag.ClientIp ?? "127.0.0.1")</strong></span>
                <span class="mx-1">•</span>
                <span>Host: <strong>@(ViewBag.ClientDevice ?? "Local")</strong></span>
            </div>
            <div>
                <a asp-action="AccessDenied" asp-controller="Account" class="text-decoration-none small text-muted">
                    <i class="fa-solid fa-headset me-1"></i> @(isArabic ? "طلب مساعدة / فتح تذكرة" : "Support / Request Access")
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePasswordVisibility() {
            var passInput = document.getElementById("passwordInput");
            var icon = document.getElementById("togglePasswordIcon");
            if (passInput.type === "password") {
                passInput.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                passInput.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>
