@model StockPortal.Models.User
@{
    ViewData["Title"] = Loc["My Domain Profile"];
    var myAssets = ViewBag.MyAssets as List<StockPortal.Models.Asset> ?? new();
    var myTickets = ViewBag.MyTickets as List<StockPortal.Models.Ticket> ?? new();
    var allUsers = ViewBag.AllUsers as List<StockPortal.Models.User> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">@Loc["Domain Account & Custody Profile"]</h4>
        <small class="text-muted">@Loc["Single Sign-On authenticated domain profile & assigned equipment"]</small>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- User Profile Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body text-center p-4">
                <div style="width: 72px; height: 72px; border-radius: 50%; background: #0284c7; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: bold; margin: 0 auto 1rem auto;">
                    @(Model.DisplayFullName != null ? Model.DisplayFullName.Substring(0, 1) : "U")
                </div>
                <h5 class="fw-bold mb-1">@Model.DisplayFullName</h5>
                <div class="badge bg-primary bg-opacity-10 text-primary mb-2">@Model.DisplayRole</div>
                <div class="small text-muted mb-3">@(Model.Department?.DisplayName ?? Loc["General Staff"])</div>

                <div class="p-2 bg-light rounded text-start small font-monospace mb-3">
                    <div class="d-flex justify-content-between text-muted">
                        <span>@Loc["Domain Username:"]</span>
                        <strong class="text-dark">@(Model.DomainUser ?? Environment.UserName)</strong>
                    </div>
                    <div class="d-flex justify-content-between text-muted mt-1">
                        <span>@Loc["Machine / Host:"]</span>
                        <strong class="text-dark">@Environment.UserDomainName</strong>
                    </div>
                    <div class="d-flex justify-content-between text-muted mt-1">
                        <span>@Loc["Authentication:"]</span>
                        <span class="badge bg-success py-0">@Loc["Windows SSO (No Password)"]</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Role / User Switcher for Admin & Testing -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-users-viewfinder text-primary me-2"></i> @Loc["Switch Identity (Testing Mode)"]</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">
                    @Loc["Switch active profile to test views from another technician, doctor, or staff member's perspective."]
                </p>
                <div class="list-group list-group-flush">
                    @foreach (var u in allUsers)
                    {
                        <form method="post" asp-action="SwitchUser" asp-controller="Account" class="m-0 p-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@u.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center small py-2 w-100 border-0 text-start @(u.Id == Model.Id ? "active text-white" : "")">
                                <div>
                                    <div class="fw-semibold">@u.DisplayFullName</div>
                                    <div class="@(u.Id == Model.Id ? "text-light" : "text-muted")" style="font-size: 0.72rem;">@u.DisplayRole &bull; @u.DomainUser</div>
                                </div>
                                @if (u.Id == Model.Id)
                                {
                                    <span class="badge bg-white text-primary">@Loc["Active"]</span>
                                }
                            </button>
                        </form>
                    }
                </div>
                <div class="mt-3 pt-2 border-top text-center">
                    <form method="post" asp-action="SwitchUser" asp-controller="Account">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="0" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="fa-solid fa-rotate-left me-1"></i> @Loc["Reset to Default Windows User"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: My Assets & Tickets -->
    <div class="col-lg-8">
        <!-- My Assets -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i> @Loc["Equipment in My Custody"] (@myAssets.Count)</h6>
                <a href="@Url.Action("Index", "Assets")" class="btn btn-sm btn-outline-primary">@Loc["Browse All Assets"]</a>
            </div>
            <div class="card-body p-0">
                @if (!myAssets.Any())
                {
                    <div class="text-center text-muted py-4">@Loc["No equipment currently assigned to your custody."]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["Asset Tag"]</th>
                                    <th>@Loc["Brand & Model"]</th>
                                    <th>@Loc["Type"]</th>
                                    <th>@Loc["Location"]</th>
                                    <th>@Loc["Custodian"]</th>
                                    <th>@Loc["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in myAssets)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("Details", "Assets", new { id = a.Id })" class="fw-bold text-decoration-none">
                                                @a.HospitalNo
                                            </a>
                                        </td>
                                        <td>@a.Brand</td>
                                        <td><span class="badge bg-light text-dark border">@a.DisplayType</span></td>
                                        <td>@(a.Room?.DisplayName ?? Loc["Unassigned"])</td>
                                        <td>@(a.CustodyType?.DisplayType ?? Loc["Personal"])</td>
                                        <td>
                                            <a href="@Url.Action("Create", "Tickets", new { assetId = a.Id })" class="btn btn-sm btn-outline-warning py-0">
                                                @Loc["Report Issue"]
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- My Tickets -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-ticket text-warning me-2"></i> @Loc["My Support Requests"] (@myTickets.Count)</h6>
                <a href="@Url.Action("Create", "Tickets")" class="btn btn-sm btn-primary">@Loc["Open Ticket"]</a>
            </div>
            <div class="card-body p-0">
                @if (!myTickets.Any())
                {
                    <div class="text-center text-muted py-4">@Loc["You have not submitted any service tickets."]</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Loc["Type"]</th>
                                    <th>@Loc["Stock & Assets"]</th>
                                    <th>@Loc["Status"]</th>
                                    <th>@Loc["Date Opened"]</th>
                                    <th>@Loc["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in myTickets)
                                {
                                    <tr>
                                        <td class="fw-bold">#@t.Id</td>
                                        <td><span class="badge bg-light text-dark border">@Loc.TicketType(t.Type)</span></td>
                                        <td>@(t.Asset?.HospitalNo ?? Loc["General"])</td>
                                        <td>
                                            <span class="badge @(t.StatusId == 5 ? "bg-success" : t.StatusId == 1 ? "bg-danger" : "bg-warning text-dark")">
                                                @(t.Status?.DisplayStatus ?? Loc.Status(t.Status?.Status))
                                            </span>
                                        </td>
                                        <td>@t.OpenedDT?.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <a href="@Url.Action("Details", "Tickets", new { id = t.Id })" class="btn btn-sm btn-outline-primary py-0">
                                                @Loc["View Details"]
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
