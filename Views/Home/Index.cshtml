@model StockPortal.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = Loc.IsArabic ? "لوحة التحكم والتحليلات" : "Executive IT & Maintenance Dashboard";
    bool isAr = Loc.IsArabic;
}

<!-- Navigation Tabs -->
<ul class="nav nav-tabs nav-tabs-bordered mb-4" id="dashboardTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab != "analytics" ? "active" : "") fw-bold px-4 py-2" id="overview-tab" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button" role="tab" aria-controls="tab-overview" aria-selected="@(Model.ActiveTab != "analytics" ? "true" : "false")">
            <i class="fa-solid fa-chart-line me-2 text-primary"></i> @Loc["Executive Overview"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(Model.ActiveTab == "analytics" ? "active" : "") fw-bold px-4 py-2" id="analytics-tab" data-bs-toggle="tab" data-bs-target="#tab-analytics" type="button" role="tab" aria-controls="tab-analytics" aria-selected="@(Model.ActiveTab == "analytics" ? "true" : "false")">
            <i class="fa-solid fa-users-gear me-2 text-info"></i> @Loc["Maintenance Team Analytics"]
            @if (Model.FilteredClosedTickets > 0)
            {
                <span class="badge bg-success ms-1">@Model.FilteredClosedTickets @Loc["Closed Resolved"]</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content" id="dashboardTabsContent">
    <!-- ========================================== -->
    <!-- TAB 1: EXECUTIVE OVERVIEW -->
    <!-- ========================================== -->
    <div class="tab-pane fade @(Model.ActiveTab != "analytics" ? "show active" : "")" id="tab-overview" role="tabpanel" aria-labelledby="overview-tab">
        <!-- Department Filter / Scope Indicator for Executive Overview -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
            <div class="d-flex align-items-center gap-2">
                @if (Model.CanFilterTeam)
                {
                    <span class="small fw-bold text-muted"><i class="fa-solid fa-filter me-1 text-primary"></i> @(isAr ? "تصفية حسب القسم:" : "Department Filter:")</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <a href="@Url.Action("Index", "Home", new { tab = "overview", teamFilter = "ALL" })" 
                           class="btn @(Model.SelectedTeam == "ALL" ? "btn-primary fw-bold" : "btn-outline-secondary bg-white")">
                            <i class="fa-solid fa-hospital me-1"></i> @(isAr ? "كافة الأقسام" : "All Departments")
                        </a>
                        <a href="@Url.Action("Index", "Home", new { tab = "overview", teamFilter = "IT" })" 
                           class="btn @(Model.SelectedTeam == "IT" ? "btn-primary fw-bold" : "btn-outline-secondary bg-white")">
                            <i class="fa-solid fa-laptop me-1"></i> @(isAr ? "تقنية المعلومات (IT)" : "IT")
                        </a>
                        <a href="@Url.Action("Index", "Home", new { tab = "overview", teamFilter = "BIOMEDICAL" })" 
                           class="btn @(Model.SelectedTeam == "BIOMEDICAL" ? "btn-success fw-bold text-white" : "btn-outline-secondary bg-white")">
                            <i class="fa-solid fa-heart-pulse me-1"></i> @(isAr ? "الهندسة الطبية" : "Biomedical")
                        </a>
                        <a href="@Url.Action("Index", "Home", new { tab = "overview", teamFilter = "GENERAL" })" 
                           class="btn @(Model.SelectedTeam == "GENERAL" ? "btn-warning fw-bold text-dark" : "btn-outline-secondary bg-white")">
                            <i class="fa-solid fa-wrench me-1"></i> @(isAr ? "الصيانة العامة" : "General")
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(Model.SelectedTeam == "BIOMEDICAL" ? "bg-success" : Model.SelectedTeam == "GENERAL" ? "bg-warning text-dark" : "bg-primary") px-3 py-2 fs-6 rounded-pill shadow-sm">
                            <i class="fa-solid @(Model.SelectedTeam == "BIOMEDICAL" ? "fa-heart-pulse" : Model.SelectedTeam == "GENERAL" ? "fa-wrench" : "fa-laptop") me-1"></i>
                            @(isAr ? $"بيانات قسم: {Loc.TargetTeam(Model.SelectedTeam)}" : $"{Loc.TargetTeam(Model.SelectedTeam)} Department Overview")
                        </span>
                        <span class="small text-muted"><i class="fa-solid fa-shield-halved text-success me-1"></i> @(isAr ? "معاينة معزولة خاصة بقسم الصيانة الخاص بك" : "Private department-isolated view")</span>
                    </div>
                }
            </div>
            @if (Model.CanFilterTeam && Model.SelectedTeam != "ALL")
            {
                <div>
                    <span class="badge bg-info-subtle text-dark border">
                        @(isAr ? $"المعاينة الحالية: {Loc.TargetTeam(Model.SelectedTeam)}" : $"Filtered by: {Loc.TargetTeam(Model.SelectedTeam)}")
                    </span>
                    <a href="@Url.Action("Index", "Home", new { tab = "overview", teamFilter = "ALL" })" class="btn btn-sm btn-link text-decoration-none py-0 text-muted">
                        <i class="fa-solid fa-xmark me-1"></i> @(isAr ? "إلغاء التصفية" : "Reset to All")
                    </a>
                </div>
            }
        </div>

        <!-- Key Metric Stat Cards -->
        <div class="row g-3 mb-4">
            <!-- Assets Card -->
            <div class="col-xl-3 col-md-6">
                <a href="@Url.Action("Index", "Assets")" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-blue shadow-sm h-100 card-hover-lift">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.05em;">@Loc["Total Assets"]</div>
                                <div class="h2 fw-bold text-primary mb-1">@Model.TotalAssets</div>
                                <div class="small text-muted">
                                    <span class="text-success fw-semibold">@Model.InServiceAssets</span> @Loc["in service"] &bull; 
                                    <span class="text-warning fw-semibold">@Model.UnderMaintenanceAssets</span> @Loc["in repair"]
                                </div>
                            </div>
                            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top border-light-subtle d-flex justify-content-between small">
                            <span class="text-muted">@Loc["Total Asset Value"]:</span>
                            <span class="fw-bold text-dark">$@Model.TotalInventoryValue.ToString("N0")</span>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Active Tickets Card -->
            <div class="col-xl-3 col-md-6">
                <a href="@Url.Action("Index", "Tickets", new { statusId = -1 })" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-amber shadow-sm h-100 card-hover-lift">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.05em;">@Loc["Open & Active Tickets"]</div>
                                <div class="h2 fw-bold text-warning mb-1">@(Model.OpenTickets + Model.PendingTickets)</div>
                                <div class="small text-muted">
                                    <span class="text-danger fw-semibold">@Model.OpenTickets</span> @Loc["unassigned"] &bull; 
                                    <span class="text-info fw-semibold">@Model.PendingTickets</span> @Loc["in progress"]
                                </div>
                            </div>
                            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                                <i class="fa-solid fa-ticket"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top border-light-subtle d-flex justify-content-between small">
                            <span class="text-muted">@Loc["Closed Resolved"]:</span>
                            <span class="fw-bold text-success">@Model.ClosedTickets</span>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Preventive Maintenance & Calibration Alert Card -->
            <div class="col-xl-3 col-md-6">
                <a href="@Url.Action("Index", "Maintenance")" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-rose shadow-sm h-100 card-hover-lift">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.05em;">@Loc["Maintenance Alerts"]</div>
                                <div class="h2 fw-bold @((Model.OverduePeriodicAssets.Count + Model.OverdueCalibrationAssets.Count) > 0 ? "text-danger" : "text-success") mb-1">
                                    @(Model.OverduePeriodicAssets.Count + Model.OverdueCalibrationAssets.Count)
                                </div>
                                <div class="small text-muted">
                                    @if ((Model.OverduePeriodicAssets.Count + Model.OverdueCalibrationAssets.Count) > 0)
                                    {
                                        <span>@Model.OverduePeriodicAssets.Count @Loc["Maintenance"] &bull; @Model.OverdueCalibrationAssets.Count @Loc["Calibration Overdue"]</span>
                                    }
                                    else
                                    {
                                        <span>@Loc["Scheduled Maintenance Up-to-date"]</span>
                                    }
                                </div>
                            </div>
                            <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top border-light-subtle d-flex justify-content-between small">
                            <span class="text-muted">@Loc["Expiring in 30 Days"]:</span>
                            <span class="fw-bold text-dark">@(Model.UpcomingPeriodicAssets.Count + Model.UpcomingCalibrationAssets.Count)</span>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Resolved Tickets / Health Card -->
            <div class="col-xl-3 col-md-6">
                <a href="@Url.Action("Index", "Tickets", new { statusId = 5 })" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-emerald shadow-sm h-100 card-hover-lift">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-uppercase fw-bold text-muted" style="font-size: 0.72rem; letter-spacing: 0.05em;">@Loc["Service Resolution Rate"]</div>
                                @{
                                    int total = Model.TotalTickets;
                                    int rate = total > 0 ? (int)((double)Model.ClosedTickets / total * 100) : 100;
                                }
                                <div class="h2 fw-bold text-success mb-1">@rate%</div>
                                <div class="small text-muted">
                                    <span>@Model.ClosedTickets / @total @Loc["Closed Resolved"]</span>
                                </div>
                            </div>
                            <div class="stat-icon bg-success bg-opacity-10 text-success">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top border-light-subtle d-flex justify-content-between small">
                            <span class="text-muted">@Loc["delayed"]:</span>
                            <span class="fw-bold text-danger">@Model.DelayedTickets</span>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Urgent Attention Alert Row (if any) -->
        @if (Model.OverduePeriodicAssets.Any() || Model.OverdueCalibrationAssets.Any() || Model.UrgentTickets.Any())
        {
            <div class="row g-3 mb-4">
                @if (Model.OverduePeriodicAssets.Any())
                {
                    <div class="col-lg-@(Model.OverdueCalibrationAssets.Any() ? "4" : "6")">
                        <div class="card border-danger shadow-sm h-100">
                            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold"><i class="fa-solid fa-bell me-2"></i> @Loc["Overdue Preventive Maintenance"]</span>
                                <a href="@Url.Action("Index", "Maintenance")" class="btn btn-sm btn-light py-0">@Loc["View Details"]</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var asset in Model.OverduePeriodicAssets.Take(4))
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold text-dark">@asset.HospitalNo &bull; @asset.Brand (@asset.DisplayType)</div>
                                                <div class="small text-muted">
                                                    <i class="fa-solid fa-location-dot me-1"></i> @(asset.Room?.DisplayName ?? Loc["Unassigned"]) &bull; 
                                                    @Loc["Custodian"]: @(asset.User?.DisplayFullName ?? Loc["None"])
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-danger">@Loc["Next Periodic Due"]: @asset.NextPeriodic?.ToString("MMM dd, yyyy")</span>
                                                <div class="mt-1">
                                                    <a href="@Url.Action("Log", "Maintenance", new { assetId = asset.Id })" class="btn btn-sm btn-outline-danger py-0" style="font-size: 0.75rem;">
                                                        @Loc["Maintenance"]
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.OverdueCalibrationAssets.Any())
                {
                    <div class="col-lg-@(Model.OverduePeriodicAssets.Any() ? "4" : "6")">
                        <div class="card border-danger shadow-sm h-100">
                            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold"><i class="fa-solid fa-scale-balanced me-2"></i> @Loc["Calibration Overdue"]</span>
                                <a href="@Url.Action("Index", "Maintenance")" class="btn btn-sm btn-light py-0">@Loc["View Details"]</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var asset in Model.OverdueCalibrationAssets.Take(4))
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold text-dark">@asset.HospitalNo &bull; @asset.Brand (@asset.DisplayType)</div>
                                                <div class="small text-muted">
                                                    <i class="fa-solid fa-certificate me-1 text-danger"></i> @(asset.CalibrationCertNo ?? "No Cert") &bull; 
                                                    @Loc["Next Calibration Due"]: @asset.NextCalibration?.ToString("MMM dd, yyyy")
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-danger">@Loc["Calibration Overdue"]</span>
                                                <div class="mt-1">
                                                    <a href="@Url.Action("Details", "Assets", new { id = asset.Id })" class="btn btn-sm btn-outline-danger py-0" style="font-size: 0.75rem;">
                                                        @Loc["Log / Renew Calibration"]
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.UrgentTickets.Any())
                {
                    <div class="col-lg-@((Model.OverduePeriodicAssets.Any() && Model.OverdueCalibrationAssets.Any()) ? "4" : "6")">
                        <div class="card border-warning shadow-sm h-100">
                            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                                <span class="fw-bold"><i class="fa-solid fa-fire me-2"></i> @Loc["High & Urgent Priority Tickets"]</span>
                                <a href="@Url.Action("Index", "Tickets")" class="btn btn-sm btn-dark py-0">@Loc["View Details"]</a>
                            </div>
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var ticket in Model.UrgentTickets.Take(4))
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold text-dark">
                                                    <a href="@Url.Action("Details", "Tickets", new { id = ticket.Id })" class="text-decoration-none">
                                                        #@ticket.Id &bull; @ticket.DisplayType
                                                    </a>
                                                </div>
                                                <div class="small text-muted">
                                                    @Loc["Asset Tag"]: @(ticket.Asset?.HospitalNo ?? "N/A") &bull; @Loc["Opened by Me"]: @(ticket.OpenedByUser?.DisplayFullName ?? "Unknown")
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge @(ticket.Priority == 4 ? "bg-danger" : "bg-warning text-dark")">
                                                    @ticket.DisplayPriority
                                                </span>
                                                <div class="small text-muted mt-1">@ticket.OpenedDT?.ToString("MMM dd HH:mm")</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Recent Activity Tables -->
        <div class="row g-4">
            <!-- Recent Tickets -->
            <div class="col-lg-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-ticket text-primary me-2"></i> @Loc["Recent Helpdesk Tickets"]</h6>
                        <a href="@Url.Action("Index", "Tickets")" class="btn btn-sm btn-outline-secondary">@Loc["All Tickets"]</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>@Loc["Asset Tag"]</th>
                                        <th>@Loc["Type"]</th>
                                        <th>@Loc["Priority Level"]</th>
                                        <th>@Loc["Operational Status"]</th>
                                        <th>@Loc["Assigned Technician"]</th>
                                        <th>@Loc["Actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.RecentTickets.Any())
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">@Loc["No notifications found"]</td>
                                        </tr>
                                    }
                                    @foreach (var ticket in Model.RecentTickets)
                                    {
                                        <tr>
                                            <td class="fw-bold">#@ticket.Id</td>
                                            <td>
                                                @if (ticket.Asset != null)
                                                {
                                                    <a href="@Url.Action("Details", "Assets", new { id = ticket.Asset.Id })" class="text-decoration-none fw-semibold">
                                                        @ticket.Asset.HospitalNo
                                                    </a>
                                                    <div class="small text-muted">@ticket.Asset.Brand</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None</span>
                                                }
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@ticket.DisplayType</span></td>
                                            <td>
                                                @switch (ticket.Priority)
                                                {
                                                    case 4: <span class="badge bg-danger">@ticket.DisplayPriority</span>; break;
                                                    case 3: <span class="badge bg-warning text-dark">@ticket.DisplayPriority</span>; break;
                                                    case 2: <span class="badge bg-info text-dark">@ticket.DisplayPriority</span>; break;
                                                    default: <span class="badge bg-secondary">@ticket.DisplayPriority</span>; break;
                                                }
                                            </td>
                                            <td>
                                                @switch (ticket.StatusId)
                                                {
                                                    case 1: <span class="badge bg-danger bg-opacity-10 text-danger border border-danger"><i class="fa-solid fa-circle-dot me-1"></i> @Loc["opened"]</span>; break;
                                                    case 2: <span class="badge bg-warning bg-opacity-10 text-warning border border-warning"><i class="fa-solid fa-spinner me-1"></i> @Loc["pending"]</span>; break;
                                                    case 3: <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary"><i class="fa-solid fa-clock me-1"></i> @Loc["delayed"]</span>; break;
                                                    case 4: <span class="badge bg-dark bg-opacity-10 text-dark border border-dark"><i class="fa-solid fa-ban me-1"></i> @Loc["canceled"]</span>; break;
                                                    case 5: <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="fa-solid fa-circle-check me-1"></i> @Loc["closed"]</span>; break;
                                                    case 6: <span class="badge bg-info bg-opacity-10 text-info border border-info"><i class="fa-solid fa-screwdriver-wrench me-1"></i> @Loc["maintenance"]</span>; break;
                                                    case 7: <span class="badge bg-warning bg-opacity-10 text-dark border border-warning" style="background-color: rgba(234, 179, 8, 0.2) !important;"><i class="fa-solid fa-circle-pause me-1 text-warning"></i> @Loc["hold"]</span>; break;
                                                    default: <span class="badge bg-light text-dark border">@Loc.Status(ticket.Status?.Status)</span>; break;
                                                }
                                            </td>
                                            <td>
                                                @if (ticket.Handler?.TechUser != null)
                                                {
                                                    <span class="small fw-semibold"><i class="fa-solid fa-user-gear text-muted me-1"></i> @ticket.Handler.TechUser.DisplayFullName</span>
                                                }
                                                else
                                                {
                                                    <span class="small text-muted fst-italic">@Loc["Unassigned"]</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Tickets", new { id = ticket.Id })" class="btn btn-sm btn-light border py-1 px-2" title="@Loc["View Details"]">
                                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Maintenance Logs -->
            <div class="col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="fa-solid fa-wrench text-warning me-2"></i> @Loc["Recent Maintenance Work"]</h6>
                        <a href="@Url.Action("Index", "Maintenance")" class="btn btn-sm btn-outline-secondary">@Loc["Inspection Schedule"]</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @if (!Model.RecentMaintenance.Any())
                            {
                                <div class="text-center text-muted py-4">@Loc["No notifications found"]</div>
                            }
                            @foreach (var log in Model.RecentMaintenance)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="badge @(log.MaintenanceType == 2 ? "bg-info text-dark" : "bg-danger")">
                                            @log.DisplayTypeName
                                        </span>
                                        <small class="text-muted">@log.TimStamp?.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <div class="fw-semibold text-dark">
                                        @(log.Asset?.HospitalNo ?? "Asset #" + log.AssetId) &bull; @log.Asset?.Brand
                                    </div>
                                    <p class="small text-muted mb-1 text-truncate" title="@log.Description">
                                        @log.Description
                                    </p>
                                    <div class="small d-flex justify-content-between text-secondary">
                                        <span><i class="fa-solid fa-user-check me-1"></i> @(log.Technician?.DisplayFullName ?? Loc["Maintenance Provider"])</span>
                                        @if (log.TicketId.HasValue)
                                        {
                                            <a href="@Url.Action("Details", "Tickets", new { id = log.TicketId.Value })" class="text-decoration-none">
                                                #@log.TicketId
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 2: MAINTENANCE & TEAMS ANALYTICS -->
    <!-- ========================================== -->
    <div class="tab-pane fade @(Model.ActiveTab == "analytics" ? "show active" : "")" id="tab-analytics" role="tabpanel" aria-labelledby="analytics-tab">
        
        <!-- Filter Bar Card -->
        <div class="card shadow-sm border-0 mb-4 bg-light">
            <div class="card-body p-3">
                <form method="get" asp-action="Index" id="analyticsFilterForm" class="row g-2 align-items-center">
                    <input type="hidden" name="tab" value="analytics" />
                    <input type="hidden" name="datePreset" id="datePresetInput" value="@Model.DatePreset" />

                    <!-- Presets Row -->
                    <div class="col-12 mb-2 d-flex flex-wrap gap-1 align-items-center">
                        <span class="small fw-bold text-muted me-2"><i class="fa-solid fa-clock-rotate-left me-1"></i> @Loc["Quick Presets"]:</span>
                        <button type="button" class="btn btn-sm @(Model.DatePreset == "today" ? "btn-primary" : "btn-outline-secondary bg-white")" onclick="setPreset('today')">@Loc["Today"]</button>
                        <button type="button" class="btn btn-sm @(Model.DatePreset == "7days" ? "btn-primary" : "btn-outline-secondary bg-white")" onclick="setPreset('7days')">@Loc["Last 7 Days"]</button>
                        <button type="button" class="btn btn-sm @(Model.DatePreset == "30days" ? "btn-primary" : "btn-outline-secondary bg-white")" onclick="setPreset('30days')">@Loc["Last 30 Days"]</button>
                        <button type="button" class="btn btn-sm @(Model.DatePreset == "month" ? "btn-primary" : "btn-outline-secondary bg-white")" onclick="setPreset('month')">@Loc["This Month"]</button>
                        <button type="button" class="btn btn-sm @(Model.DatePreset == "quarter" ? "btn-primary" : "btn-outline-secondary bg-white")" onclick="setPreset('quarter')">@Loc["This Quarter"]</button>
                        <button type="button" class="btn btn-sm @(Model.DatePreset == "year" ? "btn-primary" : "btn-outline-secondary bg-white")" onclick="setPreset('year')">@Loc["This Year"]</button>
                        <button type="button" class="btn btn-sm @(Model.DatePreset == "all" ? "btn-primary" : "btn-outline-secondary bg-white")" onclick="setPreset('all')">@Loc["All Time"]</button>
                    </div>

                    <!-- Date & Team & Technician Pickers (Dynamic Real-time Filtering) -->
                    <div class="col-md-2 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-calendar me-1"></i> @Loc["From Date"]</span>
                            <input type="date" name="fromDate" id="filterFromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" onchange="onDateFilterChanged()">
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-calendar-check me-1"></i> @Loc["To Date"]</span>
                            <input type="date" name="toDate" id="filterToDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" onchange="onDateFilterChanged()">
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        @if (Model.CanFilterTeam)
                        {
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-filter me-1"></i> @Loc["Maintenance Team"]</span>
                                <select name="teamFilter" id="filterTeamSelect" class="form-select" onchange="onTeamFilterChanged()">
                                    <option value="ALL" selected="@(Model.SelectedTeam == "ALL")">@Loc["All Maintenance Teams"]</option>
                                    <option value="IT" selected="@(Model.SelectedTeam == "IT")">IT - @(LocHelper.TranslateTargetTeam("IT"))</option>
                                    <option value="BIOMEDICAL" selected="@(Model.SelectedTeam == "BIOMEDICAL")">Biomedical - @(LocHelper.TranslateTargetTeam("BIOMEDICAL"))</option>
                                    <option value="GENERAL" selected="@(Model.SelectedTeam == "GENERAL")">General Maintenance - @(LocHelper.TranslateTargetTeam("GENERAL"))</option>
                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" name="teamFilter" value="@Model.SelectedTeam" />
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-lock me-1"></i> @Loc["Maintenance Team"]</span>
                                <span class="form-control bg-light fw-bold text-primary">
                                    @(isAr ? LocHelper.TranslateTargetTeam(Model.SelectedTeam) : Model.SelectedTeam)
                                </span>
                            </div>
                        }
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-user-gear me-1"></i> @Loc["Team Member / Specialist"]</span>
                            <select name="techId" id="filterTechId" class="form-select" onchange="onTechFilterChanged()">
                                <option value="">@Loc["All Team Members"]</option>
                                @foreach (var member in Model.AvailableTechnicians)
                                {
                                    <option value="@member.Id" selected="@(Model.SelectedTechUserId == member.Id)">@member.DisplayFullName (@member.RoleDisplay)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2 col-sm-12 d-flex gap-2 align-items-center">
                        <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-2 w-100 d-flex align-items-center justify-content-center gap-1 small" title="@(isAr ? "التصفية تعمل فوراً وتلقائياً عند تغيير أي خيار" : "Filters update instantly on selection")">
                            <i class="fa-solid fa-bolt text-success"></i> @(isAr ? "تصفية فورية" : "Live Filter")
                        </span>
                        <a href="@Url.Action("Index", new { tab = "analytics", teamFilter = Model.SelectedTeam, datePreset = "30days" })" class="btn btn-sm btn-outline-secondary" title="@Loc["Reset Filters"]">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.SelectedTechUserId.HasValue)
        {
            var selectedTech = Model.AvailableTechnicians.FirstOrDefault(u => u.Id == Model.SelectedTechUserId.Value);
            if (selectedTech != null)
            {
                <div class="alert alert-primary border-primary shadow-sm d-flex justify-content-between align-items-center mb-4 py-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-user-check fs-4 text-primary"></i>
                        <div>
                            <div class="fw-bold text-dark">@(isAr ? $"عرض التحليلات الفردية للفني: {selectedTech.DisplayFullName}" : $"Viewing Individual Analysis for: {selectedTech.DisplayFullName}")</div>
                            <div class="small text-muted">@(selectedTech.DomainUser) &bull; @(selectedTech.RoleDisplay) &bull; @(isAr ? LocHelper.TranslateTargetTeam(selectedTech.MaintenanceTeam) : selectedTech.MaintenanceTeam)</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="@Url.Action("PrintMemberReport", new { userId = selectedTech.Id, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), datePreset = Model.DatePreset })" target="_blank" class="btn btn-sm btn-primary fw-semibold shadow-xs">
                            <i class="fa-solid fa-print me-1"></i> @Loc["Print Member Activity Report"]
                        </a>
                        <a href="@Url.Action("Index", new { tab = "analytics", teamFilter = Model.SelectedTeam, datePreset = Model.DatePreset, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd") })" class="btn btn-sm btn-outline-secondary">
                            <i class="fa-solid fa-xmark me-1"></i> @Loc["Clear Member Filter"]
                        </a>
                    </div>
                </div>
            }
        }

        <!-- Period KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-2 col-md-4 col-sm-6">
                <a href="#closedTicketsTable" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-emerald shadow-sm h-100 card-hover-lift">
                        <div class="text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;">@Loc["Closed Resolved"]</div>
                        <div class="h2 fw-bold text-success my-1">@Model.FilteredClosedTickets</div>
                        <div class="small text-muted"><i class="fa-solid fa-circle-check text-success me-1"></i> @(isAr ? "في الفترة المحددة" : "In selected range")</div>
                    </div>
                </a>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <a href="#closedTicketsTable" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-blue shadow-sm h-100 card-hover-lift">
                        <div class="text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;">@Loc["Average Resolution Time"]</div>
                        <div class="h2 fw-bold text-primary my-1">
                            @if (Model.FilteredAverageResolutionHours > 24)
                            {
                                <span>@Math.Round(Model.FilteredAverageResolutionHours / 24.0, 1) <small class="fs-6 fw-normal">@Loc["Days"]</small></span>
                            }
                            else
                            {
                                <span>@Model.FilteredAverageResolutionHours <small class="fs-6 fw-normal">@Loc["Hours"]</small></span>
                            }
                        </div>
                        <div class="small text-muted"><i class="fa-solid fa-stopwatch text-primary me-1"></i> MTTR (@(isAr ? "متوسط سرعة الإنجاز" : "Turnaround"))</div>
                    </div>
                </a>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <a href="@Url.Action("Index", "Tickets", new { statusId = 5 })" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-emerald shadow-sm h-100 card-hover-lift">
                        <div class="text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;">@Loc["Service Resolution Rate"]</div>
                        <div class="h2 fw-bold text-success my-1">@Model.FilteredResolutionRate%</div>
                        <div class="small text-muted"><i class="fa-solid fa-percent text-success me-1"></i> @Model.FilteredClosedTickets / @Model.FilteredTotalTickets @(isAr ? "تذكرة" : "tickets")</div>
                    </div>
                </a>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <a href="@Url.Action("Index", "Tickets", new { statusId = -1 })" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-amber shadow-sm h-100 card-hover-lift">
                        <div class="text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;">@Loc["Active Queue"]</div>
                        <div class="h2 fw-bold text-warning my-1">@Model.FilteredActiveTickets</div>
                        <div class="small text-muted"><i class="fa-solid fa-list-check text-warning me-1"></i> @(isAr ? "قيد المتابعة والعمل" : "Open / in progress")</div>
                    </div>
                </a>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <a href="@Url.Action("Index", "Maintenance")" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-blue shadow-sm h-100 card-hover-lift">
                        <div class="text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;">@Loc["Work Orders Logged"]</div>
                        <div class="h2 fw-bold text-info my-1">@Model.FilteredMaintenanceLogsCount</div>
                        <div class="small text-muted"><i class="fa-solid fa-screwdriver-wrench text-info me-1"></i> @(isAr ? "سجلات صيانة منفذة" : "Maintenance records")</div>
                    </div>
                </a>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <a href="@Url.Action("Index", "Tickets", new { statusId = 0 })" class="text-decoration-none d-block h-100">
                    <div class="card stat-card stat-card-rose shadow-sm h-100 card-hover-lift">
                        <div class="text-uppercase fw-bold text-muted small" style="font-size: 0.7rem;">@Loc["Total Handled"]</div>
                        <div class="h2 fw-bold text-dark my-1">@Model.FilteredTotalTickets</div>
                        <div class="small text-muted"><i class="fa-solid fa-ticket text-secondary me-1"></i> @(isAr ? "حجم العمل الكلي" : "Total workload volume")</div>
                    </div>
                </a>
            </div>
        </div>

        <!-- SECTION 1: Technician & Specialist Workload Scorecard ("Who Managed What") -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-user-check text-primary me-2"></i> @Loc["Technician & Specialist Workload Scorecard"]
                    </h5>
                    <small class="text-muted">@(isAr ? "تحليل إنتاجية الفنيين وعدد التذاكر المنجزة لكل مختص (مع احتساب مشاركة عدة فنيين في حل التذكرة الواحدة)" : "Technician productivity scorecard and ticket volume credited per specialist, including multi-technician closures.")</small>
                </div>
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">
                    <i class="fa-solid fa-users me-1"></i> @Model.TechnicianStats.Count @(isAr ? "فني ومختص" : "Technicians")
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th>@Loc["Technician / Specialist"]</th>
                                <th>@Loc["Maintenance Team"]</th>
                                <th class="text-center">@Loc["Closed Tickets Count"]</th>
                                <th class="text-center">@Loc["Active Queue"]</th>
                                <th class="text-center">@Loc["Total Handled"]</th>
                                <th class="text-center">@Loc["Average Resolution Time"]</th>
                                <th class="text-center">@Loc["Work Orders Logged"]</th>
                                <th style="min-width: 130px;">@(isAr ? "مؤشر المساهمة" : "Workload Share")</th>
                                <th class="text-center" style="min-width: 140px;">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.TechnicianStats.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">@Loc["No notifications found"]</td>
                                </tr>
                            }
                            @{
                                int maxClosed = Model.TechnicianStats.Any() ? Math.Max(1, Model.TechnicianStats.Max(s => s.ClosedTicketsCount)) : 1;
                            }
                            @foreach (var tech in Model.TechnicianStats)
                            {
                                int sharePct = (int)Math.Round(((double)tech.ClosedTicketsCount / maxClosed) * 100);
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                                <i class="fa-solid fa-user-gear"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@tech.DisplayFullName</div>
                                                <div class="small text-muted font-monospace">@(tech.DomainUser ?? ("ID #" + tech.UserId)) &bull; @tech.RoleDisplay</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(tech.MaintenanceTeam == "IT" ? "bg-info text-dark" : tech.MaintenanceTeam == "BIOMEDICAL" ? "bg-success" : "bg-warning text-dark")">
                                            @(isAr ? LocHelper.TranslateTargetTeam(tech.MaintenanceTeam) : tech.MaintenanceTeam)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success fs-6 px-3 py-1 fw-bold">@tech.ClosedTicketsCount</span>
                                    </td>
                                    <td class="text-center">
                                        @if (tech.ActiveTicketsCount > 0)
                                        {
                                            <span class="badge bg-warning text-dark">@tech.ActiveTicketsCount</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center fw-semibold text-dark">@tech.TotalHandledTickets</td>
                                    <td class="text-center">
                                        @if (tech.ClosedTicketsCount > 0 && tech.AverageResolutionHours > 0)
                                        {
                                            if (tech.AverageResolutionHours > 24)
                                            {
                                                <span class="badge bg-light text-dark border">@Math.Round(tech.AverageResolutionHours / 24.0, 1) @Loc["Days"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark border">@tech.AverageResolutionHours @Loc["Hours"]</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary">@tech.MaintenanceWorkOrdersCount</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @sharePct%;" aria-valuenow="@sharePct" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <span class="small text-muted" style="min-width: 32px;">@sharePct%</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <a href="@Url.Action("PrintMemberReport", new { userId = tech.UserId, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), datePreset = Model.DatePreset })" target="_blank" class="btn btn-sm btn-outline-primary py-1 px-2" title="@Loc["Print Member Activity Report"]">
                                                <i class="fa-solid fa-print me-1"></i> <span class="small">@Loc["Print Report"]</span>
                                            </a>
                                            @if (Model.SelectedTechUserId != tech.UserId)
                                            {
                                                <a href="@Url.Action("Index", new { tab = "analytics", teamFilter = Model.SelectedTeam, techId = tech.UserId, fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), datePreset = Model.DatePreset })" class="btn btn-sm btn-light border py-1 px-2" title="@Loc["Filter by this member"]">
                                                    <i class="fa-solid fa-filter text-secondary"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTION 2: Maintenance Teams Comparison & Issue Category Breakdown -->
        <div class="row g-4 mb-4">
            <!-- Team Performance Cards -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="fa-solid fa-chart-column text-success me-2"></i> @(Model.CanFilterTeam ? Loc["Team Performance Comparison"] : Loc["My Team Analysis"])
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var team in Model.TeamStats)
                            {
                                <div class="@(Model.TeamStats.Count == 1 ? "col-12" : "col-md-4")">
                                    <div class="border rounded p-3 bg-light h-100 d-flex flex-column justify-content-between">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="badge @(team.TeamCode == "IT" ? "bg-info text-dark" : team.TeamCode == "BIOMEDICAL" ? "bg-success" : "bg-warning text-dark") fs-6">
                                                    @(isAr ? LocHelper.TranslateTargetTeam(team.TeamCode) : team.TeamCode)
                                                </span>
                                                <span class="small fw-bold text-success">@team.ResolutionRate%</span>
                                            </div>
                                            <div class="progress mb-3" style="height: 6px;">
                                                <div class="progress-bar bg-success" style="width: @team.ResolutionRate%;"></div>
                                            </div>
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span>@Loc["Closed Resolved"]:</span>
                                                <span class="fw-bold text-success">@team.ClosedTickets</span>
                                            </div>
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span>@Loc["Active Queue"]:</span>
                                                <span class="fw-bold text-warning">@team.ActiveTickets</span>
                                            </div>
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span>@Loc["Urgent"]:</span>
                                                <span class="fw-bold text-danger">@team.UrgentTickets</span>
                                            </div>
                                        </div>
                                        <div class="border-top pt-2 mt-2 d-flex justify-content-between small">
                                            <span class="text-muted">@Loc["Avg Turnaround"]:</span>
                                            <span class="fw-bold text-dark">
                                                @(team.AverageResolutionHours > 24 ? $"{Math.Round(team.AverageResolutionHours / 24.0, 1)} {Loc["Days"]}" : $"{team.AverageResolutionHours} {Loc["Hours"]}")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Issue Categories Breakdown -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="fa-solid fa-layer-group text-info me-2"></i> @Loc["Issue Categories Breakdown"]
                        </h6>
                    </div>
                    <div class="card-body">
                        @if (!Model.CategoryStats.Any())
                        {
                            <div class="text-muted text-center py-4">@Loc["No notifications found"]</div>
                        }
                        @foreach (var cat in Model.CategoryStats)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small fw-semibold mb-1">
                                    <span>@cat.DisplayCategory</span>
                                    <span>@cat.Count (@cat.Percentage%)</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-info" style="width: @cat.Percentage%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- SECTION 3: Closed Tickets Management & Audit Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-box-archive text-success me-2"></i> @Loc["Closed Tickets Management & Resolution Audit"]
                    </h5>
                    <small class="text-muted">@(isAr ? "سجل مفصل لجميع التذاكر المغلقة، مع الفنيين المشاركين وملاحظات الحل" : "Detailed audit log of all closed tickets, participant technicians, and resolution summaries.")</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 250px;">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" id="closedTicketsSearch" class="form-control" placeholder="@Loc["Search closed tickets..."]" onkeyup="filterClosedTable()">
                    </div>
                    <span class="badge bg-success fs-6 px-3 py-2">
                        @Model.FilteredClosedTicketsLog.Count @Loc["Closed Resolved"]
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="closedTicketsTable">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th>#@Loc["Ticket"]</th>
                                <th>@Loc["Asset Tag"]</th>
                                <th>@Loc["Maintenance Team"]</th>
                                <th>@Loc["Type"]</th>
                                <th>@Loc["Opened by Me"]</th>
                                <th>@Loc["Date Closed"]</th>
                                <th>@Loc["Turnaround Time"]</th>
                                <th style="min-width: 200px;">@Loc["Closed by Technicians"]</th>
                                <th style="min-width: 200px;">@Loc["Resolution Summary"]</th>
                                <th>@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.FilteredClosedTicketsLog.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-folder-open fs-2 mb-2 d-block text-secondary"></i>
                                        @Loc["No closed tickets found in this period"]
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model.FilteredClosedTicketsLog)
                            {
                                <tr class="closed-ticket-row" data-search="@item.TicketId @(item.EquipmentTag?.ToLower()) @(item.RequesterName?.ToLower()) @(item.Type?.ToLower()) @(item.TargetTeam?.ToLower()) @(item.ResolutionNotes?.ToLower())">
                                    <td class="fw-bold">
                                        <a href="@Url.Action("Details", "Tickets", new { id = item.TicketId })" class="text-decoration-none">
                                            #@item.TicketId
                                        </a>
                                    </td>
                                    <td>
                                        @if (item.AssetId.HasValue)
                                        {
                                            <a href="@Url.Action("Details", "Assets", new { id = item.AssetId.Value })" class="text-decoration-none fw-semibold">
                                                @item.EquipmentTag
                                            </a>
                                            @if (!string.IsNullOrEmpty(item.EquipmentBrand))
                                            {
                                                <div class="small text-muted">@item.EquipmentBrand</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@(item.EquipmentTag ?? "N/A")</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(item.TargetTeam == "IT" ? "bg-info text-dark" : item.TargetTeam == "BIOMEDICAL" ? "bg-success" : "bg-warning text-dark")">
                                            @(isAr ? LocHelper.TranslateTargetTeam(item.TargetTeam) : item.TargetTeam)
                                        </span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@LocHelper.TranslateTicketType(item.Type)</span></td>
                                    <td class="small">@item.RequesterName</td>
                                    <td class="small text-nowrap">
                                        @item.ClosedDT?.ToString("yyyy/MM/dd HH:mm")
                                    </td>
                                    <td class="text-nowrap small fw-semibold">
                                        @if (item.TurnaroundHours > 24)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="fa-solid fa-stopwatch me-1 text-primary"></i>
                                                @Math.Round(item.TurnaroundHours / 24.0, 1) @Loc["Days"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="fa-solid fa-stopwatch me-1 text-primary"></i>
                                                @item.TurnaroundHours @Loc["Hours"]
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ResolvedByUsers.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var user in item.ResolvedByUsers)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success d-inline-flex align-items-center gap-1 py-1 px-2" title="@user.DisplayFullName">
                                                        <i class="fa-solid fa-user-check"></i>
                                                        <span>@user.DisplayFullName</span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">@(isAr ? "غير محدد" : "Unspecified")</span>
                                        }
                                    </td>
                                    <td>
                                        <p class="small text-muted mb-0 text-truncate" style="max-width: 250px;" title="@item.ResolutionNotes">
                                            @(string.IsNullOrWhiteSpace(item.ResolutionNotes) ? "-" : item.ResolutionNotes)
                                        </p>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Tickets", new { id = item.TicketId })" class="btn btn-sm btn-outline-primary" title="@Loc["View Details"]">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    function setPreset(preset) {
        document.getElementById('datePresetInput').value = preset;
        document.getElementById('filterFromDate').value = '';
        document.getElementById('filterToDate').value = '';
        document.getElementById('analyticsFilterForm').submit();
    }

    function onDateFilterChanged() {
        document.getElementById('datePresetInput').value = 'custom';
        document.getElementById('analyticsFilterForm').submit();
    }

    function onTeamFilterChanged() {
        var techSelect = document.getElementById('filterTechId');
        if (techSelect) techSelect.value = '';
        document.getElementById('analyticsFilterForm').submit();
    }

    function onTechFilterChanged() {
        document.getElementById('analyticsFilterForm').submit();
    }

    function clearPreset() {
        document.getElementById('datePresetInput').value = 'custom';
    }

    function filterClosedTable() {
        var query = (document.getElementById('closedTicketsSearch')?.value || '').toLowerCase().trim();
        var rows = document.querySelectorAll('#closedTicketsTable .closed-ticket-row');
        rows.forEach(function(row) {
            var searchData = (row.getAttribute('data-search') || '').toLowerCase();
            row.style.display = (!query || searchData.indexOf(query) >= 0) ? '' : 'none';
        });
    }

    // Keep active tab synced in URL without full reload when switching tabs manually
    document.addEventListener("DOMContentLoaded", function () {
        var triggerTabList = [].slice.call(document.querySelectorAll('#dashboardTabs button'));
        triggerTabList.forEach(function (triggerEl) {
            triggerEl.addEventListener('shown.bs.tab', function (event) {
                var targetId = event.target.getAttribute('data-bs-target');
                var tabName = targetId === '#tab-analytics' ? 'analytics' : 'overview';
                var url = new URL(window.location.href);
                url.searchParams.set('tab', tabName);
                window.history.replaceState({}, '', url.toString());
            });
        });
    });
</script>
}