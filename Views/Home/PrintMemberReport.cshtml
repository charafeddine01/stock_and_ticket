@model StockPortal.ViewModels.TechnicianReportViewModel
@{
    Layout = null;
    bool isAr = Loc.IsArabic;
    var tech = Model.Technician;
}
<!DOCTYPE html>
<html lang="@Loc.CurrentCulture" dir="@Loc.Direction">
<head>
    <meta charset="utf-8" />
    <title>@(isAr ? $"تقرير أداء الفني - {tech.DisplayFullName}" : $"Technician Activity Report - {tech.FullName}")</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    @if (isAr)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        @@media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; font-size: 12px !important; }
            .sheet { border: none !important; box-shadow: none !important; width: 100% !important; padding: 10px 0 !important; }
            .page-break { page-break-before: always; }
        }
        body {
            background-color: #f1f5f9;
            font-family: @(isAr ? "'Cairo', " : "") 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 2rem 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .sheet {
            width: 960px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        .stat-box {
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            border-radius: 6px;
            padding: 12px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="no-print mb-4 d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow-sm">
            <i class="fa-solid fa-print me-2"></i> @(isAr ? "طباعة التقرير" : "Print Report")
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg">
            @(isAr ? "إغلاق النافذة" : "Close")
        </button>
    </div>

    <div class="sheet">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center pb-3 border-bottom border-2 border-primary mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="fa-solid fa-hospital fs-3 text-primary"></i>
                    <h4 class="fw-bold mb-0 text-dark">@(isAr ? "مستشفى الرعاية الصحية التخصصي" : "Specialized Healthcare Hospital")</h4>
                </div>
                <div class="text-muted small">
                    <i class="fa-solid fa-screwdriver-wrench me-1 text-secondary"></i>
                    @(isAr ? "إدارة الصيانة والخدمات الطبية والتقنية" : "Department of Maintenance, Clinical & IT Engineering")
                </div>
            </div>
            <div class="text-end">
                <span class="badge bg-primary fs-6 px-3 py-2 text-uppercase">
                    @(isAr ? "تقرير أداء ونشاط الفني" : "Technician Activity Report")
                </span>
                <div class="text-muted small mt-1">
                    @(isAr ? "تاريخ الإصدار:" : "Generated on:") @DateTime.Now.ToString("yyyy/MM/dd HH:mm")
                </div>
            </div>
        </div>

        <!-- Technician Info & Period Card -->
        <div class="card border-0 bg-light mb-4">
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 54px; height: 54px;">
                                <i class="fa-solid fa-user-gear"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@tech.DisplayFullName</h5>
                                <div class="text-muted small font-monospace">@(tech.DomainUser ?? ("ID #" + tech.Id)) &bull; @tech.RoleDisplay</div>
                                <div class="mt-1">
                                    <span class="badge @(tech.MaintenanceTeam == "IT" ? "bg-info text-dark" : tech.MaintenanceTeam == "BIOMEDICAL" ? "bg-success" : "bg-warning text-dark")">
                                        <i class="fa-solid fa-users-gear me-1"></i> @(isAr ? LocHelper.TranslateTargetTeam(tech.MaintenanceTeam) : tech.MaintenanceTeam)
                                    </span>
                                    @if (tech.Department != null)
                                    {
                                        <span class="badge bg-light text-dark border ms-1">@tech.Department.Name</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded p-2 bg-white h-100 d-flex flex-column justify-content-center">
                            <div class="small fw-bold text-secondary mb-1">
                                <i class="fa-solid fa-calendar-days text-primary me-1"></i> @(isAr ? "النطاق الزمني للتقرير:" : "Reporting Period:")
                            </div>
                            <div class="fw-bold text-dark fs-6">
                                @Model.FromDate.ToString("yyyy/MM/dd") &mdash; @Model.ToDate.ToString("yyyy/MM/dd")
                            </div>
                            <div class="small text-muted">
                                @(isAr ? "تم احتساب جميع التذاكر وسجلات الصيانة المنفذة خلال هذه الفترة" : "Covers all ticket resolutions and maintenance logs completed in this timeframe")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI Metrics Row -->
        <div class="row g-3 mb-4">
            <div class="col-3">
                <div class="stat-box">
                    <div class="text-muted small text-uppercase fw-bold">@(isAr ? "التذاكر المنجزة والمغلقة" : "Resolved / Closed")</div>
                    <div class="h3 fw-bold text-success my-1">@Model.ClosedTicketsCount</div>
                    <div class="small text-muted"><i class="fa-solid fa-check-double text-success me-1"></i> @(isAr ? "تذكرة مكتملة" : "Tickets resolved")</div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-box">
                    <div class="text-muted small text-uppercase fw-bold">@(isAr ? "متوسط سرعة الحل" : "Avg Turnaround")</div>
                    <div class="h3 fw-bold text-primary my-1">
                        @if (Model.AverageResolutionHours > 24)
                        {
                            <span>@Math.Round(Model.AverageResolutionHours / 24.0, 1) <small class="fs-6 fw-normal">@(isAr ? "أيام" : "Days")</small></span>
                        }
                        else
                        {
                            <span>@Model.AverageResolutionHours <small class="fs-6 fw-normal">@(isAr ? "ساعات" : "Hours")</small></span>
                        }
                    </div>
                    <div class="small text-muted"><i class="fa-solid fa-stopwatch text-primary me-1"></i> MTTR</div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-box">
                    <div class="text-muted small text-uppercase fw-bold">@(isAr ? "التذاكر النشطة المسندة" : "Active In-Progress")</div>
                    <div class="h3 fw-bold text-warning my-1">@Model.ActiveTicketsCount</div>
                    <div class="small text-muted"><i class="fa-solid fa-list-check text-warning me-1"></i> @(isAr ? "قيد المتابعة" : "Open queue")</div>
                </div>
            </div>
            <div class="col-3">
                <div class="stat-box">
                    <div class="text-muted small text-uppercase fw-bold">@(isAr ? "أوامر الصيانة المنفذة" : "Work Orders Logged")</div>
                    <div class="h3 fw-bold text-info my-1">@Model.WorkOrdersCount</div>
                    <div class="small text-muted"><i class="fa-solid fa-screwdriver-wrench text-info me-1"></i> @(isAr ? "صيانة دورية وإصلاح" : "Maintenance logs")</div>
                </div>
            </div>
        </div>

        <!-- Section: Itemized Closed Tickets -->
        <div class="mb-4">
            <h6 class="fw-bold border-bottom pb-2 text-dark d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-ticket text-primary me-2"></i> @(isAr ? "التذاكر المغلقة والمنجزة بواسطة الفني" : "Tickets Resolved & Handled by Technician")</span>
                <span class="badge bg-success">@Model.ResolvedTickets.Count @(isAr ? "تذكرة" : "tickets")</span>
            </h6>

            @if (!Model.ResolvedTickets.Any())
            {
                <div class="text-center py-4 text-muted bg-light rounded border">
                    @(isAr ? "لا توجد تذاكر مغلقة لهذا الفني خلال الفترة الزمنية المحددة." : "No closed tickets recorded for this technician in the selected timeframe.")
                </div>
            }
            else
            {
                <table class="table table-bordered table-sm align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">#</th>
                            <th>@(isAr ? "الأصل / الجهاز" : "Asset Tag / Equipment")</th>
                            <th>@(isAr ? "فئة المشكلة" : "Category")</th>
                            <th>@(isAr ? "مقدم البلاغ" : "Requester")</th>
                            <th>@(isAr ? "تاريخ الإغلاق" : "Closed Date")</th>
                            <th>@(isAr ? "مدة الحل" : "Duration")</th>
                            <th>@(isAr ? "المشاركون في الحل" : "Collaborators")</th>
                            <th style="width: 250px;">@(isAr ? "ملخص الحل والإجراء" : "Resolution Summary")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.ResolvedTickets)
                        {
                            <tr>
                                <td class="fw-bold">#@t.TicketId</td>
                                <td>
                                    <div class="fw-semibold">@t.EquipmentTag</div>
                                    @if (!string.IsNullOrEmpty(t.EquipmentBrand))
                                    {
                                        <small class="text-muted">@t.EquipmentBrand</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@LocHelper.TranslateTicketType(t.Type)</span></td>
                                <td>@t.RequesterName</td>
                                <td class="text-nowrap small">@t.ClosedDT?.ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="text-nowrap small">
                                    @(t.TurnaroundHours > 24 ? $"{Math.Round(t.TurnaroundHours / 24.0, 1)} {(isAr ? "أيام" : "Days")}" : $"{t.TurnaroundHours} {(isAr ? "ساعات" : "Hrs")}")
                                </td>
                                <td>
                                    @if (t.ResolvedByUsers.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var c in t.ResolvedByUsers)
                                            {
                                                <span class="badge @(c.Id == tech.Id ? "bg-primary" : "bg-light text-dark border")" style="font-size: 0.7rem;">
                                                    @c.DisplayFullName
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-dark" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(t.ResolutionNotes) ? "-" : t.ResolutionNotes)</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Section: Maintenance Work Orders Performed -->
        @if (Model.MaintenanceLogs.Any())
        {
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 text-dark d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-wrench text-warning me-2"></i> @(isAr ? "سجلات وأوامر الصيانة المنفذة بواسطة الفني" : "Maintenance Work Orders Completed by Technician")</span>
                    <span class="badge bg-info text-dark">@Model.MaintenanceLogs.Count</span>
                </h6>
                <table class="table table-bordered table-sm align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th>@(isAr ? "رقم الأصل" : "Asset Tag")</th>
                            <th>@(isAr ? "الجهاز" : "Device Brand")</th>
                            <th>@(isAr ? "نوع الصيانة" : "Type")</th>
                            <th>@(isAr ? "تاريخ التنفيذ" : "Date")</th>
                            <th>@(isAr ? "وصف العمل المنفذ" : "Work Description")</th>
                            <th>@(isAr ? "قطع الغيار المستبدلة" : "Parts Replaced")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.MaintenanceLogs)
                        {
                            <tr>
                                <td class="fw-bold">@(log.Asset?.HospitalNo ?? ("Asset #" + log.AssetId))</td>
                                <td>@(log.Asset?.Brand ?? "N/A")</td>
                                <td>
                                    <span class="badge @(log.MaintenanceType == 2 ? "bg-info text-dark" : "bg-danger")">
                                        @log.DisplayTypeName
                                    </span>
                                </td>
                                <td class="text-nowrap small">@log.TimStamp?.ToString("yyyy/MM/dd")</td>
                                <td><div class="small">@log.Description</div></td>
                                <td><small class="text-muted">@(string.IsNullOrEmpty(log.PartsReplaced) ? "-" : log.PartsReplaced)</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Section: Category Distribution -->
        @if (Model.CategoryBreakdown.Any())
        {
            <div class="mb-4">
                <h6 class="fw-bold border-bottom pb-2 text-dark">
                    <i class="fa-solid fa-layer-group text-info me-2"></i> @(isAr ? "توزيع التذاكر المنجزة حسب فئات المشاكل" : "Resolved Tickets by Issue Category")
                </h6>
                <div class="row g-2">
                    @foreach (var cat in Model.CategoryBreakdown)
                    {
                        <div class="col-md-3 col-sm-6">
                            <div class="border rounded p-2 bg-light d-flex justify-content-between align-items-center">
                                <span class="small fw-semibold text-dark">@cat.DisplayCategory</span>
                                <span class="badge bg-primary">@cat.Count (@cat.Percentage%)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Sign-off & Audit Stamp Section -->
        <div class="pt-4 mt-4 border-top">
            <div class="row text-center">
                <div class="col-4">
                    <div class="fw-bold text-dark mb-1">@(isAr ? "توقيع الفني المختص" : "Technician Signature")</div>
                    <div class="text-muted small mb-4">@tech.DisplayFullName</div>
                    <div class="border-bottom mx-4" style="border-style: dotted !important;"></div>
                </div>
                <div class="col-4">
                    <div class="fw-bold text-dark mb-1">@(isAr ? "اعتماد رئيس وحدة الصيانة" : "Maintenance Unit Supervisor")</div>
                    <div class="text-muted small mb-4">@(isAr ? "رئيس قسم " + LocHelper.TranslateTargetTeam(tech.MaintenanceTeam) : $"{tech.MaintenanceTeam} Lead")</div>
                    <div class="border-bottom mx-4" style="border-style: dotted !important;"></div>
                </div>
                <div class="col-4">
                    <div class="fw-bold text-dark mb-1">@(isAr ? "إدارة الجودة والاعتماد" : "Quality & Compliance Office")</div>
                    <div class="text-muted small mb-4">@(isAr ? "ختم الاعتماد الرسمي" : "Official Audit Stamp")</div>
                    <div class="border-bottom mx-4" style="border-style: dotted !important;"></div>
                </div>
            </div>
        </div>

    </div>
</body>
</html>
