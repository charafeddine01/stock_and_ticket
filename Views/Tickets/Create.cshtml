@model StockPortal.Models.Ticket
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = Loc["Open New Ticket"];
    int currentUserId = ViewBag.CurrentUserId ?? CurrentUser.GetUserId();
    int userAssetsCount = ViewBag.UserAssetsCount ?? 0;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-ticket text-primary me-2"></i> @Loc["Open New Technical Support Ticket"]</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="createTicketForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="OpenedBy" value="@currentUserId" />
                    <!-- Hidden target team input submitted with the form -->
                    <input type="hidden" asp-for="TargetTeam" id="hiddenTargetTeam" value="IT" />

                    <div class="row g-3 mb-3">
                        <!-- Requester & On-Behalf -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@Loc["Reported By"]</label>
                            <input type="text" class="form-control bg-light" value="@CurrentUser.GetFullName() (@CurrentUser.GetRole())" readonly />
                            <div class="form-text small">@(Loc.IsArabic ? "مستخدم ويندوز الحالي مقدم التذكرة." : "Logged-in domain user submitting this ticket.")</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OnBehalfOf" class="form-label fw-semibold">@Loc["On Behalf Of"]</label>
                            <select asp-for="OnBehalfOf" id="OnBehalfOf" class="form-select" asp-items="ViewBag.Users">
                                <option value="@currentUserId" selected>@(Loc.IsArabic ? $"نفسي ({CurrentUser.GetFullName()})" : $"Myself ({CurrentUser.GetFullName()})")</option>
                            </select>
                            <div class="form-text small">@(Loc.IsArabic ? "اختر موظفاً آخر إذا كنت تقدم البلاغ نيابة عن زميل." : "Select another staff member if submitting for a colleague.")</div>
                        </div>

                        <!-- 1. Equipment Assigned to Current User (Visible when ticket is for myself) -->
                        <div class="col-md-12" id="myAssetsContainer">
                            <label asp-for="AssetId" class="form-label fw-semibold d-flex justify-content-between align-items-center">
                                <span><i class="fa-solid fa-laptop text-primary me-1"></i> @Loc["Your Assigned Hardware Asset"]</span>
                                <span class="badge bg-light text-muted border fw-normal">@userAssetsCount @Loc["assigned items"]</span>
                            </label>
                            <select asp-for="AssetId" id="AssetId" class="form-select">
                                <option value="" data-team="" data-type="">@(Loc.IsArabic ? "-- طلب خدمة عام (بدون جهاز محدد) --" : "-- General Service Request (No specific hardware) --")</option>
                                @if (ViewBag.UserAssetsList != null)
                                {
                                    foreach (var item in ViewBag.UserAssetsList)
                                    {
                                        <option value="@item.Id" data-team="@item.MaintenanceTeam" data-type="@item.Type">@item.Display</option>
                                    }
                                }
                            </select>
                            @if (userAssetsCount == 0)
                            {
                                <div class="alert alert-light border small text-muted mt-2 py-2">
                                    <i class="fa-solid fa-circle-info text-primary me-1"></i> @(Loc.IsArabic ? "لا توجد أجهزة مسندة لعهدتك الشخصية حالياً. إذا كان البلاغ لجهاز مشترك، اختر طلباً عاماً أو حدد التفاصيل أدناه." : "No equipment is currently registered to your personal custody. If reporting an issue with a shared workstation, select general request or describe it below.")
                                </div>
                            }
                            else
                            {
                                <div class="form-text small">@(Loc.IsArabic ? "اختر الجهاز من عهدتك الذي يواجه المشكلة الفنية." : "Choose the specific equipment from your custody experiencing technical issues.")</div>
                            }
                        </div>

                        <!-- 2. Manual Asset Specification (Visible ONLY when On-Behalf is selected) -->
                        <div class="col-md-12" id="onBehalfAssetContainer" style="display: none;">
                            <div class="alert alert-warning py-2 small mb-2 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-user-pen fs-6"></i>
                                <div>
                                    <strong>@(Loc.IsArabic ? "التقديم نيابة عن زميل:" : "Filing on behalf of a colleague:")</strong> @(Loc.IsArabic ? "يرجى تحديد جهاز أو كود العهدة الخاص به أدناه." : "Please specify their workstation or equipment tag below. It will be recorded directly into the service ticket message.")
                                </div>
                            </div>
                            <label class="form-label fw-semibold text-dark">
                                @Loc["Target Asset / Workstation Tag (Manual Entry)"]
                            </label>
                            <input type="text" name="manualAsset" id="manualAssetInput" class="form-control" 
                                   placeholder="@(Loc.IsArabic ? "أدخل اسم الكمبيوتر، رقم الأصل، الغرفة، أو الرقم التسلسلي..." : "Enter PC Name, Asset Tag, Room, or Serial (e.g. HOSP-LAP-012, Room 301 Workstation, Dell OptiPlex 7080)...")" />
                            <div class="form-text small">@(Loc.IsArabic ? "سيتم تسجيل تفاصيل الجهاز مباشرة في رسالة البلاغ للفنيين." : "Equipment details entered here will be logged directly into the technician's dispatch message.")</div>
                        </div>

                        <!-- Target Maintenance Team (Relocked to Equipment Department Scope) -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">@Loc["Responsible Department"]</label>
                            
                            <!-- Container when an asset is selected: LOCKED from editing -->
                            <div id="lockedTeamContainer">
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-primary border-end-0">
                                        <i class="fa-solid fa-lock text-primary"></i>
                                    </span>
                                    <input type="text" id="lockedTeamText" class="form-control bg-light fw-bold text-dark border-start-0" readonly value="@Loc["IT Maintenance"]" />
                                </div>
                                <div class="form-text small text-success">
                                    <i class="fa-solid fa-circle-check me-1"></i> @(Loc.IsArabic ? "تم قفل القسم وفقاً لتخصص الجهاز." : "Department locked to equipment scope.")
                                </div>
                            </div>

                            <!-- Container when no asset is selected: General request department selector -->
                            <div id="selectableTeamContainer" style="display: none;">
                                <select id="selectTargetTeam" class="form-select">
                                    <option value="IT" selected>@Loc["IT Maintenance"]</option>
                                    <option value="BIOMEDICAL">@Loc["Biomedical Engineering"]</option>
                                    <option value="GENERAL">@Loc["General Facility Maintenance"]</option>
                                </select>
                                <div class="form-text small text-muted">
                                    <i class="fa-solid fa-circle-info me-1"></i> @(Loc.IsArabic ? "القسم المسؤول عن معالجة الطلب العام." : "Department handling general request.")
                                </div>
                            </div>
                        </div>

                        <!-- Dynamic Issue Category -->
                        <div class="col-md-4">
                            <label asp-for="Type" class="form-label fw-semibold">@Loc["Issue Category"]</label>
                            <select asp-for="Type" id="ticketTypeSelect" class="form-select" required>
                                <!-- Populated dynamically by JavaScript -->
                            </select>
                            <div class="form-text small text-muted">@(Loc.IsArabic ? "مخصص حسب الجهاز / الفريق المختار." : "Specific to selected equipment / team.")</div>
                        </div>

                        <!-- Priority Level -->
                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold">@Loc["Priority Level"]</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="1">@(Loc.IsArabic ? "منخفضة - استفسار عام" : "Low - General Inquiry")</option>
                                <option value="2" selected>@(Loc.IsArabic ? "متوسطة - تأثير عمل اعتيادي" : "Medium - Normal Work Impact")</option>
                                <option value="3">@(Loc.IsArabic ? "مرتفعة - تعطيل في القسم" : "High - Department Bottleneck")</option>
                                <option value="4">@(Loc.IsArabic ? "طارئة - توقف خدمة حرجة / سريرية" : "Urgent - Clinical / Critical Service Down")</option>
                            </select>
                            <div class="form-text small text-muted">@(Loc.IsArabic ? "درجة استعجال المعالجة الفنية." : "Urgency of service response.")</div>
                        </div>

                        <!-- Specialist / Technician in Responsible Department: Assignable by End User & Staff -->
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-user-gear text-primary me-1"></i> @Loc["Assign to Specialist in Responsible Department (Optional)"]
                            </label>
                            <select name="assignedTechId" id="assignedTechSelect" class="form-select">
                                <option value="">@(Loc.IsArabic ? "-- غير معين (قائمة مهام القسم) --" : "-- Unassigned (Department Queue) --")</option>
                                @if (ViewBag.TechniciansList != null)
                                {
                                    foreach (var tech in ViewBag.TechniciansList)
                                    {
                                        <option value="@tech.Id" data-team="@tech.MaintenanceTeam">@tech.FullName (@tech.RoleDisplay)</option>
                                    }
                                }
                            </select>
                            <div class="form-text small text-muted" id="techFilterNotice">
                                <i class="fa-solid fa-circle-info me-1"></i> @(Loc.IsArabic ? "عرض المختصين في القسم المسؤول." : "Showing specialists for the responsible department.")
                            </div>
                        </div>

                        <!-- Issue Description & Message -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">@Loc["Issue Description & Symptoms"]</label>
                            <textarea name="initialMessage" class="form-control" rows="4" placeholder="@(Loc.IsArabic ? "اشرح بالتفصيل رسائل الخطأ، الأعطال الظاهرة، الأعراض، أو خطوات تكرار المشكلة..." : "Detail error messages, physical damage, symptoms, or steps to reproduce...")" required></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="fa-solid fa-paper-plane me-1"></i> @Loc["Submit Ticket"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isAr = document.documentElement.dir === 'rtl' || document.documentElement.lang.startsWith('ar');
        const currentUserId = @currentUserId;
        const onBehalfSelect = document.getElementById("OnBehalfOf");
        const myAssetsContainer = document.getElementById("myAssetsContainer");
        const onBehalfAssetContainer = document.getElementById("onBehalfAssetContainer");
        const assetSelect = document.getElementById("AssetId");
        const manualAssetInput = document.getElementById("manualAssetInput");

        const hiddenTargetTeam = document.getElementById("hiddenTargetTeam");
        const lockedTeamContainer = document.getElementById("lockedTeamContainer");
        const lockedTeamText = document.getElementById("lockedTeamText");
        const selectableTeamContainer = document.getElementById("selectableTeamContainer");
        const selectTargetTeam = document.getElementById("selectTargetTeam");
        const ticketTypeSelect = document.getElementById("ticketTypeSelect");
        const assignedTechSelect = document.getElementById("assignedTechSelect");
        const techFilterNotice = document.getElementById("techFilterNotice");

        const categoriesByTeam = {
            "IT": isAr ? [
                { value: "Hardware Breakdown", label: "عطل عتادي / توقف كامل / انقطاع الطاقة" },
                { value: "OS & Software Crash", label: "انهيار نظام التشغيل / الشاشة الزرقاء / خطأ بالبرامج" },
                { value: "Network & Connectivity", label: "الشبكة والإنترنت / الشبكة المحلية / واي فاي / تعارض IP" },
                { value: "Account & Password", label: "حساب المستخدم / تسجيل الدخول / الصلاحيات / كلمة المرور" },
                { value: "Printer & Peripherals", label: "الطابعة / الماسح الضوئي / قارئ الباركود / الشاشة" },
                { value: "Server & Storage", label: "الخادم / المجلدات المشتركة / التخزين الشبكي" },
                { value: "Cybersecurity Alert", label: "تنبيه مضاد الفيروسات / برمجيات خبيثة / نشاط مريب" },
                { value: "Data Backup & Recovery", label: "استعادة الملفات / النسخ الاحتياطي" },
                { value: "Preventive IT Inspection", label: "فحص دوري وقائي لمحطة العمل" }
            ] : [
                { value: "Hardware Breakdown", label: "Hardware Fault / Breakdown / No Power" },
                { value: "OS & Software Crash", label: "OS / Windows Crash / Blue Screen / App Errors" },
                { value: "Network & Connectivity", label: "Network & Internet / LAN / Wi-Fi / IP Conflict" },
                { value: "Account & Password", label: "User Account / Domain Login / Permissions / Password" },
                { value: "Printer & Peripherals", label: "Printer / Scanner / Barcode Reader / Display" },
                { value: "Server & Storage", label: "Server / Shared Folder / NAS / Cloud Access" },
                { value: "Cybersecurity Alert", label: "Antivirus Alert / Malware / Suspicious Activity" },
                { value: "Data Backup & Recovery", label: "File Recovery / Backup Restoration" },
                { value: "Preventive IT Inspection", label: "Preventive IT Inspection / Workstation Servicing" }
            ],
            "BIOMEDICAL": isAr ? [
                { value: "Patient Monitor / Sensor", label: "شاشة مراقبة المريض / حساسات التخطيط والحرارة والأكسجين" },
                { value: "Ventilator Alarm / Flow", label: "جهاز التنفس الصناعي / تدفق الغازات / إنذار الضغط" },
                { value: "Defibrillator / Pacing", label: "جهاز الصدمات الكهربائية / البطارية / الفحص الدوري" },
                { value: "Ultrasound / Probe", label: "جهاز السونار / مجس الفحص / جودة الصورة" },
                { value: "X-Ray & Imaging Unit", label: "جهاز الأشعة / المولد / كاشف الإشعاع" },
                { value: "Infusion & Syringe Pump", label: "مضخة التسريب الوريدي / مضخة الحقن / معايرة التدفق" },
                { value: "Dialysis System Error", label: "جهاز غسيل الكلى / السوائل / إنذار الموصلية" },
                { value: "Surgical Diathermy", label: "جهاز الكي الجراحي / لوحة التماس الأرضي" },
                { value: "Sensor & Device Calibration", label: "معايرة الحساسات والمقاييس الطبية" },
                { value: "Periodic Safety Inspection", label: "فحص السلامة الكهربائية الدوري للأجهزة الطبية" }
            ] : [
                { value: "Patient Monitor / Sensor", label: "Patient Monitor / ECG / SpO2 / NIBP Sensor Error" },
                { value: "Ventilator Alarm / Flow", label: "Ventilator Flow / Gas Pressure / Sensor Alarm" },
                { value: "Defibrillator / Pacing", label: "Defibrillator Battery / Shock / Pacing Failure" },
                { value: "Ultrasound / Probe", label: "Ultrasound Probe Damage / Image Artifact / Transducer" },
                { value: "X-Ray & Imaging Unit", label: "X-Ray / Generator / Exposure Warning / Radiation Detector" },
                { value: "Infusion & Syringe Pump", label: "Infusion Pump / Occlusion / Flow Rate Calibration" },
                { value: "Dialysis System Error", label: "Dialysis Machine / Fluidics / Conductivity Alarm" },
                { value: "Surgical Diathermy", label: "Electrosurgical Unit / Diathermy Plate Contact" },
                { value: "Sensor & Device Calibration", label: "Transducer & Gauge Zero Calibration" },
                { value: "Periodic Safety Inspection", label: "Periodic Biomedical Safety & Electrical Leakage (PM)" }
            ],
            "GENERAL": isAr ? [
                { value: "HVAC & Temperature", label: "التكييف المركزي / التبريد / ارتفاع حرارة الغرفة" },
                { value: "Cleanroom HEPA & Pressure", label: "غرف العزل والعمليات / ضغط الهواء / فلاتر HEPA" },
                { value: "Emergency Generator & ATS", label: "مولد الطوارئ / محول التبديل التلقائي ATS" },
                { value: "Central UPS & Clean Power", label: "وحدات UPS الطبية / تذبذب الجهد الكهربائي" },
                { value: "Medical Gas & Vacuum", label: "الغازات الطبية / الأكسجين / شبكة الشفط المركزي" },
                { value: "Plumbing & Water Supply", label: "السباكة / تسريب مياه / شبكة مياه التناضح العكسي RO" },
                { value: "Fire Alarm & Sprinklers", label: "إنذار الحريق / كواشف الدخان / رشاشات الإطفاء" },
                { value: "Electrical Power & Outlets", label: "القواطع الكهربائية / المقابس / لوحات الإنارة" },
                { value: "Door Access & Security", label: "الأبواب الإلكترونية / قارئات البطاقات / أقفال الأبواب" },
                { value: "Facility Structural Repairs", label: "إصلاحات عامة في الأسقف / الأرضيات / الجدران" },
                { value: "Plant Room & Boiler", label: "المراجل / خطوط البخار / فحص غرف المضخات" }
            ] : [
                { value: "HVAC & Temperature", label: "HVAC / Air Conditioning / Chiller / Room Overheating" },
                { value: "Cleanroom HEPA & Pressure", label: "Cleanroom / Negative Pressure / HEPA Filter Drop" },
                { value: "Emergency Generator & ATS", label: "Emergency Generator / Auto Transfer Switch / ATS Test" },
                { value: "Central UPS & Clean Power", label: "Central Medical UPS / Voltage Fluctuation" },
                { value: "Medical Gas & Vacuum", label: "Medical Gas / Oxygen / Medical Air / Vacuum Pressure" },
                { value: "Plumbing & Water Supply", label: "Plumbing / Pipe Leak / Drainage / Reverse Osmosis Water" },
                { value: "Fire Alarm & Sprinklers", label: "Fire Alarm System / Smoke Detector / Sprinkler Warning" },
                { value: "Electrical Power & Outlets", label: "Electrical Outlets / Circuit Breaker / Lighting Fixture" },
                { value: "Door Access & Security", label: "Automated Doors / Access Control / Keycard / Physical Lock" },
                { value: "Facility Structural Repairs", label: "Ceiling / Wall / Floor / Architectural Repair" },
                { value: "Plant Room & Boiler", label: "Boiler / Steam Line / Pump & Plant Room Check" }
            ]
        };

        function getTeamFriendlyName(teamKey) {
            switch ((teamKey || "").toUpperCase()) {
                case "BIOMEDICAL": return isAr ? "الهندسة الطبية الحيوية" : "Biomedical Engineering";
                case "GENERAL": return isAr ? "الصيانة العامة والمرافق" : "General Facility Maintenance";
                default: return isAr ? "صيانة تقنية المعلومات" : "IT Maintenance";
            }
        }

        function filterTechniciansByTeam(team) {
            if (!assignedTechSelect) return;
            const normalizedTeam = (team || "IT").toUpperCase();
            let visibleCount = 0;
            const options = assignedTechSelect.options;

            for (let i = 0; i < options.length; i++) {
                const opt = options[i];
                const techTeam = opt.getAttribute("data-team");
                if (!techTeam || opt.value === "") {
                    opt.style.display = "";
                    continue;
                }
                if (techTeam.toUpperCase() === normalizedTeam) {
                    opt.style.display = "";
                    visibleCount++;
                } else {
                    opt.style.display = "none";
                    if (opt.selected) {
                        assignedTechSelect.value = "";
                    }
                }
            }

            if (techFilterNotice) {
                techFilterNotice.innerHTML = `<i class="fa-solid fa-circle-check text-success me-1"></i> ${isAr ? `عرض أخصائيي <strong>${getTeamFriendlyName(normalizedTeam)}</strong> (${visibleCount} متاح).` : `Showing specialists for <strong>${getTeamFriendlyName(normalizedTeam)}</strong> (${visibleCount} available).`}`;
            }
        }

        function populateCategories(team) {
            const normalizedTeam = (team || "IT").toUpperCase();
            const list = categoriesByTeam[normalizedTeam] || categoriesByTeam["IT"];
            const currentSelected = ticketTypeSelect.value;

            ticketTypeSelect.innerHTML = "";
            let matched = false;

            list.forEach((item, idx) => {
                const opt = document.createElement("option");
                opt.value = item.value;
                opt.textContent = item.label;
                if (item.value === currentSelected || idx === 0) {
                    opt.selected = true;
                    matched = true;
                }
                ticketTypeSelect.appendChild(opt);
            });
        }

        function syncTeamAndCategories() {
            let activeTeam = "IT";
            let hasAsset = false;

            if (assetSelect && assetSelect.value) {
                const selectedOpt = assetSelect.options[assetSelect.selectedIndex];
                const teamData = selectedOpt ? selectedOpt.getAttribute("data-team") : null;
                if (teamData) {
                    activeTeam = teamData.toUpperCase();
                    hasAsset = true;
                }
            }

            if (hasAsset) {
                if (lockedTeamContainer) lockedTeamContainer.style.display = "block";
                if (selectableTeamContainer) selectableTeamContainer.style.display = "none";
                if (lockedTeamText) lockedTeamText.value = getTeamFriendlyName(activeTeam);
                if (hiddenTargetTeam) hiddenTargetTeam.value = activeTeam;
            } else {
                if (lockedTeamContainer) lockedTeamContainer.style.display = "none";
                if (selectableTeamContainer) selectableTeamContainer.style.display = "block";
                activeTeam = (selectTargetTeam && selectTargetTeam.value || "IT").toUpperCase();
                if (hiddenTargetTeam) hiddenTargetTeam.value = activeTeam;
            }

            populateCategories(activeTeam);
            filterTechniciansByTeam(activeTeam);
        }

        function updateAssetMode() {
            const selectedVal = parseInt(onBehalfSelect.value, 10);
            const isOnBehalf = (selectedVal && selectedVal !== currentUserId);

            if (isOnBehalf) {
                myAssetsContainer.style.display = "none";
                onBehalfAssetContainer.style.display = "block";
                if (assetSelect) assetSelect.value = "";
            } else {
                myAssetsContainer.style.display = "block";
                onBehalfAssetContainer.style.display = "none";
                if (manualAssetInput) manualAssetInput.value = "";
            }

            syncTeamAndCategories();
        }

        if (onBehalfSelect) {
            onBehalfSelect.addEventListener("change", updateAssetMode);
        }

        if (assetSelect) {
            assetSelect.addEventListener("change", syncTeamAndCategories);
        }

        if (selectTargetTeam) {
            selectTargetTeam.addEventListener("change", function () {
                if (hiddenTargetTeam) hiddenTargetTeam.value = selectTargetTeam.value.toUpperCase();
                populateCategories(selectTargetTeam.value);
                filterTechniciansByTeam(selectTargetTeam.value);
            });
        }

        // Initialize state
        updateAssetMode();
    });
</script>
}
