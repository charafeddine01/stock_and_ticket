@model StockPortal.ViewModels.AutoTicketViewModel
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = Loc["Automated PC Ticket Generator"];
    var asset = Model.MatchedAsset;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Tickets")">@Loc["Tickets & Helpdesk"]</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Loc["Automated PC Ticket Generator"]</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-bolt text-warning me-2"></i> @Loc["Automated PC Ticket Generator"]
            </h3>
            <p class="text-muted mb-0">
                @(Loc.IsArabic ? "يتعرف النظام تلقائياً على مواصفات حاسوبك، والغرفة، وسجل العهدة من قاعدة البيانات." : "Automatically identifies your workstation hardware, location, and custodian details from the database.")
            </p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> @Loc["Back to Queue"]
            </a>
        </div>
    </div>
</div>

<form asp-action="AutoTicket" method="post" id="autoTicketForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DetectedPcName" id="detectedPcNameInput" />
    <input type="hidden" asp-for="ClientIp" />

    <div class="row g-4">
        <!-- Left Column: Workstation & Asset Identification -->
        <div class="col-lg-6">
            <!-- Detection Banner -->
            <div class="card shadow-sm border-0 mb-4 @(Model.IsAssetFound ? "border-start border-4 border-success" : "border-start border-4 border-warning")">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="stat-icon @(Model.IsAssetFound ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning")" style="width: 52px; height: 52px; font-size: 1.5rem;">
                            <i class="fa-solid @(Model.IsAssetFound ? "fa-laptop-code" : "fa-circle-question")"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge @(Model.IsAssetFound ? "bg-success" : "bg-warning text-dark") mb-1">
                                    @(Model.IsAssetFound ? (Loc.IsArabic ? "جهاز العمل مسجل في النظام" : "Workstation Recognized in DB") : (Loc.IsArabic ? "جهاز غير مسجل بعد" : "Unmapped Workstation"))
                                </span>
                                <span class="text-muted small font-monospace">IP: @Model.ClientIp</span>
                            </div>
                            <h5 class="fw-bold mb-1 text-dark">
                                @(Loc.IsArabic ? "اسم الحاسوب:" : "PC Name:") <span class="text-primary font-monospace">@Model.DetectedPcName</span>
                            </h5>
                            <p class="small text-muted mb-0">
                                @if (Model.IsAssetFound)
                                {
                                    <span>@(Loc.IsArabic ? "تمت المطابقة مع كود الأصل:" : "Matched with Asset Tag:") <strong class="text-dark">@(asset?.HospitalNo)</strong> @(Loc.IsArabic ? "في سجل المستشفى." : "in the Hospital database.")</span>
                                }
                                else
                                {
                                    <span>@(Loc.IsArabic ? $"لا يوجد أصل مطابق مباشرة للمضيف {Model.DetectedPcName}. يمكنك ربط أصل مسجل أدناه." : $"No direct asset record found for host {Model.DetectedPcName}. You can link an existing asset below.")</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Asset & Location Specs Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa-solid fa-server text-primary me-2"></i> @Loc["Workstation & Location Telemetry"]
                    </h6>
                    @if (asset != null)
                    {
                        <span class="badge bg-light text-dark border">#@asset.Id</span>
                    }
                </div>
                <div class="card-body p-4">
                    <!-- Linked Asset Selector -->
                    <div class="mb-3">
                        <label asp-for="SelectedAssetId" class="form-label fw-semibold small text-uppercase text-muted">
                            @Loc["Linked Hardware Asset"]
                        </label>
                        <select asp-for="SelectedAssetId" id="assetSelect" class="form-select">
                            <option value="">@(Loc.IsArabic ? "-- بدون جهاز عتادي محدد --" : "-- No specific hardware tag --")</option>
                            @foreach (var a in Model.AvailableAssets)
                            {
                                <option value="@a.Id" 
                                        data-pc="@a.HospitalNo"
                                        data-brand="@a.Brand" 
                                        data-serial="@a.SerialNo" 
                                        data-room="@a.RoomId"
                                        data-user="@a.UserId"
                                        selected="@(a.Id == Model.SelectedAssetId)">
                                    @(a.HospitalNo) - @(a.Brand) @(a.DisplayType) [S/N: @(a.SerialNo ?? "N/A")]
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Hardware Details Readout -->
                    <div class="bg-light p-3 rounded mb-3 border">
                        <div class="row g-2 small">
                            <div class="col-6">
                                <span class="text-muted d-block">@Loc["Brand / Manufacturer"]:</span>
                                <strong id="valBrand" class="text-dark">@(asset?.Brand ?? "N/A")</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">@Loc["Model / Version"]:</span>
                                <strong id="valModel" class="text-dark">@(asset?.ModelNo?.ToString() ?? "N/A")</strong>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="text-muted d-block">@Loc["Serial Number"]:</span>
                                <strong id="valSerial" class="text-dark font-monospace">@(asset?.SerialNo ?? "N/A")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Room / Location Information -->
                    <div class="mb-3">
                        <label asp-for="SelectedRoomId" class="form-label fw-semibold small text-uppercase text-muted">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i> @Loc["Location / Room"]
                        </label>
                        <select asp-for="SelectedRoomId" id="roomSelect" class="form-select">
                            <option value="">@(Loc.IsArabic ? "-- موقع / غرفة غير محددة --" : "-- Unspecified Room / Location --")</option>
                            @foreach (var r in Model.AvailableRooms)
                            {
                                <option value="@r.Id" selected="@(r.Id == Model.SelectedRoomId)">
                                    @r.DisplayName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Assigned Custodian / User -->
                    <div class="mb-2">
                        <label asp-for="SelectedUserId" class="form-label fw-semibold small text-uppercase text-muted">
                            <i class="fa-solid fa-user-tag text-info me-1"></i> @Loc["Assigned Custodian"]
                        </label>
                        <select asp-for="SelectedUserId" id="userSelect" class="form-select">
                            <option value="">@(Loc.IsArabic ? "-- بدون مسؤول عهدة محدد --" : "-- Unassigned Custodian --")</option>
                            @foreach (var u in Model.AvailableUsers)
                            {
                                <option value="@u.Id" selected="@(u.Id == Model.SelectedUserId)">
                                    @(u.DisplayFullName) (@(u.DisplayRole))
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Reporting Identity Card -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <i class="fa-solid fa-shield-check text-success fs-5"></i>
                        <div>
                            @(Loc.IsArabic ? "تم تسجيل الدخول باسم" : "Logged in as") <strong class="text-dark">@CurrentUser.GetFullName()</strong> (@(Loc.IsArabic ? "النطاق:" : "Domain:") <code>@CurrentUser.GetDomainUser()</code>، @(Loc.IsArabic ? "الصلاحية:" : "Role:") <strong>@CurrentUser.GetRole()</strong>).
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Ticket Category, Priority & Manual Notes Box -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa-solid fa-pen-to-square text-primary me-2"></i> @Loc["Ticket Details & Management"]
                    </h6>
                </div>
                <div class="card-body p-4">
                    <!-- Issue Category & Priority -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold small text-uppercase text-muted">
                                @Loc["Issue Category"]
                            </label>
                            <select asp-for="Category" class="form-select">
                                <option value="Hardware" selected>@Loc["Hardware"]</option>
                                <option value="Software">@Loc["Software"]</option>
                                <option value="Network">@Loc["Network"]</option>
                                <option value="Peripheral">@(Loc.IsArabic ? "ملحقات (طابعة/شاشة)" : "Printer / Monitor / Scanner")</option>
                                <option value="Maintenance">@Loc["Maintenance"]</option>
                                <option value="Access">@(Loc.IsArabic ? "صلاحيات الدخول" : "Login / Domain Access")</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold small text-uppercase text-muted">
                                @Loc["Priority Level"]
                            </label>
                            <select asp-for="Priority" class="form-select">
                                <option value="1">@(Loc.IsArabic ? "منخفضة - اعتيادي" : "Low - Routine")</option>
                                <option value="2" selected>@(Loc.IsArabic ? "متوسطة - تأثير عمل" : "Medium - Normal Work Impact")</option>
                                <option value="3">@(Loc.IsArabic ? "مرتفعة - أولوية للقسم" : "High - Urgent Department Need")</option>
                                <option value="4">@(Loc.IsArabic ? "طارئة - طارئ طبي / سريري" : "Urgent - Clinical Emergency")</option>
                            </select>
                        </div>
                    </div>

                    <!-- Quick Issue Templates / Chips -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase text-muted d-block">
                            <i class="fa-solid fa-wand-magic-sparkles text-warning me-1"></i> @(Loc.IsArabic ? "قوالب سريعة للأعطال (انقر للإضافة):" : "Quick Issue Templates (Click to insert):")
                        </label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="@(Loc.IsArabic ? "يعاني الجهاز من بطء شديد وتجمد البرامج بشكل متكرر." : "Workstation is experiencing severe slowdown and applications freeze intermittently.")">
                                ⏱️ @(Loc.IsArabic ? "بطء / تجمد النظام" : "Slow / Freezing")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="@(Loc.IsArabic ? "وميض في الشاشة وانقطاع إشارة العرض بشكل غير متوقع." : "Monitor screen flickers and loses display signal unexpectedly.")">
                                🖥️ @(Loc.IsArabic ? "وميض الشاشة" : "Display Flicker")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="@(Loc.IsArabic ? "تعذر الاتصال بالشبكة الداخلية للمستشفى أو الوصول للمجلدات المشتركة." : "Cannot connect to internal hospital network or access local shared drives.")">
                                🌐 @(Loc.IsArabic ? "انقطاع الشبكة" : "Network Lost")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="@(Loc.IsArabic ? "طابعة الشبكة متوقفة والمهام معلقة في قائمة الطباعة." : "Network printer is offline and print jobs are stuck in queue.")">
                                🖨️ @(Loc.IsArabic ? "عطل الطابعة" : "Printer Error")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="@(Loc.IsArabic ? "ظهرت شاشة زرقاء وأعاد الجهاز التشغيل تلقائياً." : "Operating system displayed a blue screen error and restarted automatically.")">
                                ⚠️ @(Loc.IsArabic ? "شاشة زرقاء BSOD" : "Crash / BSOD")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="@(Loc.IsArabic ? "الجهاز لا يعمل / مزود الطاقة لا يستجيب." : "Workstation won't turn on / power supply intermittent.")">
                                🔌 @(Loc.IsArabic ? "مشكلة الطاقة" : "Power Issue")
                            </button>
                        </div>
                    </div>

                    <!-- Notes Box: To be edited by user manually -->
                    <div class="mb-4">
                        <label asp-for="UserNotes" class="form-label fw-bold text-dark d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-message text-primary me-1"></i> @(Loc.IsArabic ? "ملاحظات المستخدم / وصف المشكلة" : "User Notes / Problem Description")</span>
                            <span class="badge bg-light text-muted border fw-normal">@(Loc.IsArabic ? "قابل للتعديل يدوياً" : "Editable Manually")</span>
                        </label>
                        <textarea asp-for="UserNotes" id="userNotesBox" class="form-control" rows="6" 
                                  placeholder="@(Loc.IsArabic ? "اكتب تفاصيل المشكلة التي تواجهها على هذا الحاسوب..." : "Type details regarding the issue you are experiencing on this workstation (e.g. error message text, steps to reproduce, urgency)...")"></textarea>
                    </div>

                    <!-- Submit & Actions -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm py-3 d-flex align-items-center justify-content-center gap-2">
                            <i class="fa-solid fa-bolt fs-5 text-warning"></i>
                            <span>@(Loc.IsArabic ? "توليد وإرسال تذكرة الدعم الآلية" : "Generate & Open Automated Ticket")</span>
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-light border py-2">
                            @Loc["Cancel"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const assetSelect = document.getElementById("assetSelect");
        const roomSelect = document.getElementById("roomSelect");
        const userSelect = document.getElementById("userSelect");
        const valBrand = document.getElementById("valBrand");
        const valModel = document.getElementById("valModel");
        const valSerial = document.getElementById("valSerial");
        const notesBox = document.getElementById("userNotesBox");

        if (assetSelect) {
            assetSelect.addEventListener("change", function () {
                const opt = assetSelect.options[assetSelect.selectedIndex];
                if (opt && opt.value) {
                    valBrand.textContent = opt.dataset.brand || "N/A";
                    valSerial.textContent = opt.dataset.serial || "N/A";
                    
                    if (opt.dataset.room && roomSelect) {
                        roomSelect.value = opt.dataset.room;
                    }
                    if (opt.dataset.user && userSelect) {
                        userSelect.value = opt.dataset.user;
                    }
                } else {
                    valBrand.textContent = "N/A";
                    valModel.textContent = "N/A";
                    valSerial.textContent = "N/A";
                }
            });
        }

        const templateBtns = document.querySelectorAll(".template-btn");
        templateBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                const text = this.getAttribute("data-text");
                if (notesBox) {
                    if (notesBox.value.trim().length > 0) {
                        notesBox.value += "\n" + text;
                    } else {
                        notesBox.value = text;
                    }
                    notesBox.focus();
                }
            });
        });
    });
</script>
}
