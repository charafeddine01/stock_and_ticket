@model StockPortal.Models.Ticket
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@Loc.CurrentCulture" dir="@Loc.Direction">
<head>
    <meta charset="utf-8" />
    <title>@(Loc.IsArabic ? $"أمر عمل #{Model.Id} - {Loc.TicketType(Model.Type)}" : $"Work Order #{Model.Id} - {Model.Type} Service")</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    @if (Loc.IsArabic)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    }
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; font-size: 13px !important; }
            .sheet { border: 1px solid #ccc !important; box-shadow: none !important; margin: 0 !important; }
        }
        body {
            background-color: #f1f5f9;
            font-family: @(Loc.IsArabic ? "'Cairo', " : "") -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 2rem 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .sheet {
            width: 800px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 40px;
            border-radius: 6px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div class="no-print mb-4 d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow-sm">
            <i class="fa-solid fa-print me-2"></i> @Loc["Print Field Work Order"]
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg">
            @Loc["Close"]
        </button>
    </div>

    <div class="sheet">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-primary">@(Loc.IsArabic ? "خدمات تقنية المعلومات والأجهزة الطبية بالمستشفى" : "IT SERVICES & BIOMEDICAL HELPDESK")</h4>
                <div class="text-muted small">@(Loc.IsArabic ? "قسم الدعم الفني وصيانة الأجهزة والمعدات الطبية" : "Hospital Technical Support & Equipment Maintenance Department")</div>
            </div>
            <div class="text-end">
                <h3 class="fw-bold mb-0">@(Loc.IsArabic ? "أمر عمل ميداني" : "WORK ORDER")</h3>
                <div class="fs-5 fw-bold text-dark font-monospace">#@Model.Id</div>
                <div class="badge bg-secondary">@(Model.Status?.DisplayStatus?.ToUpper() ?? Loc.Status(Model.Status?.Status))</div>
            </div>
        </div>

        <!-- Ticket Info Matrix -->
        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="p-3 bg-light rounded">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">@Loc["Ticket Details & Management"]</h6>
                    <div><strong>@Loc["Issue Category"]:</strong> @Loc.TicketType(Model.Type)</div>
                    <div><strong>@Loc["Priority Level"]:</strong> @Loc.Priority(Model.Priority)</div>
                    <div><strong>@Loc["Date Opened"]:</strong> @Model.OpenedDT?.ToString("MMM dd, yyyy HH:mm")</div>
                    <div><strong>@Loc["Date Closed"]:</strong> @(Model.ClosedDT?.ToString("MMM dd, yyyy HH:mm") ?? (Loc.IsArabic ? "قيد الإجراء" : "Pending Completion"))</div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 bg-light rounded">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">@(Loc.IsArabic ? "الكادر المسؤول" : "Personnel")</h6>
                    <div><strong>@Loc["Reported By"]:</strong> @(Model.OpenedByUser?.DisplayFullName ?? (Loc.IsArabic ? "غير معروف" : "Unknown"))</div>
                    <div><strong>@Loc["Department Name"]:</strong> @(Model.OpenedByUser?.Department?.DisplayName ?? Loc["General Staff"])</div>
                    <div><strong>@Loc["Assigned Technician"]:</strong> @(Model.Handler?.TechUser?.DisplayFullName ?? Loc["Unassigned"])</div>
                    <div><strong>@(Loc.IsArabic ? "تاريخ التعيين:" : "Assigned On:"):</strong> @(Model.Handler?.AssignedDT?.ToString("MMM dd, yyyy") ?? "N/A")</div>
                </div>
            </div>
        </div>

        <!-- Linked Asset -->
        @if (Model.Asset != null)
        {
            <div class="mb-4">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">@Loc["Linked Hardware Asset"]</h6>
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Loc["Asset Tag"]</th>
                            <th>@Loc["Serial Number"]</th>
                            <th>@Loc["Brand & Model"]</th>
                            <th>@Loc["Type"]</th>
                            <th>@Loc["Location"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold font-monospace">@Model.Asset.HospitalNo</td>
                            <td class="font-monospace">@(Model.Asset.SerialNo ?? "N/A")</td>
                            <td>@Model.Asset.Brand</td>
                            <td>@Model.Asset.DisplayType</td>
                            <td>@(Model.Asset.Room?.DisplayName ?? Loc["Unassigned"])</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        <!-- Timeline & Messages -->
        <div class="mb-4">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">@Loc["Diagnostic Discussion & Updates"]</h6>
            @if (!Model.Messages.Any())
            {
                <div class="text-muted fst-italic">@(Loc.IsArabic ? "لا توجد رسائل مسجلة." : "No message entries logged.")</div>
            }
            else
            {
                <div class="border rounded p-3">
                    @foreach (var m in Model.Messages.OrderBy(x => x.TimeStamp))
                    {
                        <div class="mb-2 pb-2 @(m != Model.Messages.Last() ? "border-bottom" : "")">
                            <div class="d-flex justify-content-between small text-muted">
                                <strong>@(m.User?.DisplayFullName ?? (Loc.IsArabic ? "موظف" : "Staff")):</strong>
                                <span>@m.TimeStamp?.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <div class="mt-1" style="white-space: pre-wrap;">@m.Msg</div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Field Sign-Off Section -->
        <div class="border-top pt-4 mt-5">
            <div class="row text-center">
                <div class="col-4">
                    <div style="border-bottom: 1px solid #000; height: 50px;"></div>
                    <div class="small fw-semibold mt-1">@(Loc.IsArabic ? "توقيع الفني والتاريخ" : "Technician Signature & Date")</div>
                </div>
                <div class="col-4">
                    <div style="border-bottom: 1px solid #000; height: 50px;"></div>
                    <div class="small fw-semibold mt-1">@(Loc.IsArabic ? "توقيع المستلم والتاريخ" : "Requester Acceptance & Date")</div>
                </div>
                <div class="col-4">
                    <div style="border-bottom: 1px solid #000; height: 50px;"></div>
                    <div class="small fw-semibold mt-1">@(Loc.IsArabic ? "اعتماد مشرف الصيانة" : "IT Supervisor Sign-Off")</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
