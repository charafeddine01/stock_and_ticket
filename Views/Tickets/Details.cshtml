@model StockPortal.ViewModels.TicketDetailsViewModel
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = $"{Loc["Ticket"]} #{Model.Ticket.Id}: {Loc.TicketType(Model.Ticket.Type)}";
    var ticket = Model.Ticket;
    bool isClosed = ticket.StatusId == 5 || ticket.ClosedDT.HasValue;
    bool canManage = CurrentUser.CanManageTicket(ticket);
    bool canSeeNetworkInfo = CurrentUser.IsAdmin() || CurrentUser.IsMaintenance();
    var responsibleTeam = ticket.Asset?.MaintenanceTeam ?? ticket.TargetTeam ?? StockPortal.Models.MaintenanceTeams.IT;
    var responsibleTechs = Model.DepartmentEmployees.Where(t => t.BelongsToResponsibleDepartment(responsibleTeam)).ToList();
    if (!responsibleTechs.Any())
    {
        responsibleTechs = Model.Technicians.Where(t => t.BelongsToResponsibleDepartment(responsibleTeam)).ToList();
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">@Loc["Tickets & Helpdesk"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Loc["Ticket"] #@ticket.Id</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h3 class="fw-bold mb-0">@Loc["Ticket"] #@ticket.Id &bull; @Loc.TicketType(ticket.Type)</h3>
            <span class="badge bg-primary fs-6"><i class="fa-solid fa-users-gear me-1"></i> @Loc.TargetTeam(ticket.TargetTeam)</span>
            @if (!string.IsNullOrWhiteSpace(ticket.AffectedSoftware))
            {
                <span class="badge bg-info text-dark fs-6"><i class="fa-solid fa-cube me-1"></i> @ticket.AffectedSoftware</span>
            }
            @if (!string.IsNullOrWhiteSpace(ticket.PcName))
            {
                <span class="badge bg-secondary fs-6 font-monospace"><i class="fa-solid fa-desktop me-1"></i> @ticket.PcName</span>
            }
            @if (canSeeNetworkInfo && (!string.IsNullOrWhiteSpace(ticket.IpAddress) || !string.IsNullOrWhiteSpace(ticket.MacAddress)))
            {
                <span class="badge bg-dark bg-opacity-75 text-white fs-6 font-monospace" title="@(Loc.IsArabic ? "عنوان IP و MAC لمصدر إنشاء التذكرة (خاص بالصيانة والدعم الفني)" : "Ticket Origin IP & MAC (Visible to Maintenance & IT)")">
                    <i class="fa-solid fa-network-wired me-1 text-info"></i>@(ticket.IpAddress ?? "N/A") &bull; @(ticket.MacAddress ?? "N/A")
                </span>
            }
            @switch (ticket.Priority)
            {
                case 4: <span class="badge bg-danger fs-6"><i class="fa-solid fa-fire me-1"></i> @Loc["Urgent"]</span>; break;
                case 3: <span class="badge bg-warning text-dark fs-6"><i class="fa-solid fa-triangle-exclamation me-1"></i> @Loc["High"]</span>; break;
                case 2: <span class="badge bg-info text-dark fs-6">@Loc["Medium"]</span>; break;
                default: <span class="badge bg-secondary fs-6">@Loc["Low"]</span>; break;
            }
            @if (isClosed)
            {
                <span class="badge bg-success fs-6"><i class="fa-solid fa-lock me-1"></i> @Loc["Closed"]</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("PrintTicket", new { id = ticket.Id })" class="btn btn-outline-dark" target="_blank">
            <i class="fa-solid fa-print me-1"></i> @Loc["Print Work Order"]
        </a>
        @if (!isClosed && canManage)
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#closeTicketModal">
                <i class="fa-solid fa-check-double me-1"></i> @Loc["Resolve & Close"]
            </button>
            <button type="button" class="btn btn-warning text-dark" data-bs-toggle="modal" data-bs-target="#maintenanceModal">
                <i class="fa-solid fa-wrench me-1"></i> @Loc["Log Maintenance Work"]
            </button>
        }
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> @Loc["Back to Queue"]
        </a>
    </div>
</div>

@if (isClosed)
{
    var closedTechs = Model.Technicians.Where(u => ticket.ClosedByUserIds.Contains(u.Id)).ToList();
    <div class="alert alert-success border-0 shadow-sm d-flex align-items-start gap-3 mb-4">
        <i class="fa-solid fa-circle-check fs-3 mt-1 text-success"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1">@(Loc.IsArabic ? $"تم حل المشكلة وإغلاق التذكرة بتاريخ {ticket.ClosedDT?.ToString("yyyy/MM/dd HH:mm")}" : $"Issue Resolved & Ticket Closed on {ticket.ClosedDT?.ToString("MMM dd, yyyy HH:mm")}")</h6>
            @if (!string.IsNullOrWhiteSpace(ticket.ResolutionDetails))
            {
                <p class="mb-2 text-dark" style="white-space: pre-wrap;">@ticket.ResolutionDetails</p>
            }
            @if (closedTechs.Any())
            {
                <div class="d-flex align-items-center flex-wrap gap-2 pt-2 border-top border-success-subtle mt-2">
                    <span class="small fw-semibold text-secondary"><i class="fa-solid fa-users-gear me-1"></i> @(Loc.IsArabic ? "فريق العمل / الفنيون المشاركون في الحل:" : "Technicians who worked on & resolved:")</span>
                    @foreach (var tech in closedTechs)
                    {
                        <span class="badge bg-white text-success border border-success d-inline-flex align-items-center gap-1 px-2 py-1 shadow-xs">
                            <i class="fa-solid fa-user-check"></i>
                            <span>@tech.DisplayFullName</span>
                            @if (!string.IsNullOrEmpty(tech.MaintenanceTeam))
                            {
                                <small class="text-muted fw-normal">(@tech.MaintenanceTeam)</small>
                            }
                        </span>
                    }
                </div>
            }
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Left Column: Discussion & Messages Timeline -->
    <div class="col-lg-8">
        <!-- Attached Evidence & Screenshots Card -->
        @if (ticket.Attachments.Any())
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa-solid fa-images text-primary me-2"></i>
                        @(Loc.IsArabic ? "لقطات الشاشة ومرفقات الدعم الفني" : "Attached Screenshots & Evidence") (@ticket.Attachments.Count)
                    </h6>
                    <span class="small text-muted">@(Loc.IsArabic ? "انقر على الصورة للتكبير" : "Click image to enlarge")</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        @foreach (var att in ticket.Attachments)
                        {
                            <div class="col-6 col-sm-4 col-md-3">
                                <div class="card h-100 border shadow-xs overflow-hidden" style="cursor: pointer;"
                                     onclick="openScreenshotLightbox('@att.FilePath', '@att.FileName', '@(att.UploadedByUser?.DisplayFullName ?? "User")', '@att.UploadedDT.ToString("yyyy-MM-dd HH:mm")')">
                                    <div style="height: 120px; background: #0f172a; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                        <img src="@att.FilePath" alt="@att.FileName" class="w-100 h-100" style="object-fit: cover;" />
                                    </div>
                                    <div class="p-2 small">
                                        <div class="text-truncate fw-semibold text-dark mb-1" title="@att.FileName">@att.FileName</div>
                                        <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.72rem;">
                                            <span><i class="fa-solid fa-paperclip me-1"></i>@(att.FileSize.HasValue ? $"{Math.Round((double)att.FileSize.Value / 1024, 1)} KB" : "")</span>
                                            <span>@att.UploadedDT.ToString("HH:mm")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Messages Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-comments text-primary me-2"></i> @Loc["Activity & Discussion Timeline"] (@ticket.Messages.Count)</h6>
                <span class="small text-muted">@(Loc.IsArabic ? "تاريخ الفتح:" : "Opened") @ticket.OpenedDT?.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
            <div class="card-body p-4">
                @if (!ticket.Messages.Any())
                {
                    <div class="text-center text-muted py-4">@(Loc.IsArabic ? "لا توجد تعليقات أو رسائل مسجلة بعد." : "No comments or activity messages logged yet.")</div>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var msg in ticket.Messages.OrderBy(m => m.TimeStamp))
                        {
                            var msgAttachments = msg.Attachments.Any()
                                ? msg.Attachments.ToList()
                                : ticket.Attachments.Where(a => a.MessageId == msg.Id || 
                                    (msg == ticket.Messages.OrderBy(m => m.TimeStamp).FirstOrDefault() && a.MessageId == null)).ToList();

                            <div class="d-flex gap-3 mb-4">
                                <div style="width: 40px; height: 40px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #475569; flex-shrink: 0;">
                                    @(msg.User?.DisplayFullName != null ? msg.User.DisplayFullName.Substring(0, 1) : "U")
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-bold text-dark">
                                            @(msg.User?.DisplayFullName ?? (Loc.IsArabic ? "موظف" : "Staff Member"))
                                            <span class="text-muted fw-normal small">(@(msg.User?.DisplayRole ?? (Loc.IsArabic ? "موظف" : "Staff")))</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (canSeeNetworkInfo && (!string.IsNullOrEmpty(msg.IpAddress) || !string.IsNullOrEmpty(msg.MacAddress)))
                                            {
                                                <span class="badge bg-light border text-muted font-monospace small py-1 px-2" title="@(Loc.IsArabic ? "عنوان IP و MAC لمصدر الرسالة" : "Origin IP & MAC")">
                                                    <i class="fa-solid fa-network-wired text-info me-1"></i>@(msg.IpAddress ?? "N/A") &bull; @(msg.MacAddress ?? "N/A")
                                                </span>
                                            }
                                            <small class="text-muted">@msg.TimeStamp?.ToString("MMM dd, yyyy HH:mm")</small>
                                        </div>
                                    </div>
                                    <div class="p-3 bg-light rounded text-dark shadow-xs">
                                        @if (!string.IsNullOrWhiteSpace(msg.Msg))
                                        {
                                            <div style="white-space: pre-wrap;">@msg.Msg</div>
                                        }

                                        @if (msgAttachments.Any())
                                        {
                                            <div class="row g-2 mt-2 pt-2 border-top">
                                                @foreach (var att in msgAttachments)
                                                {
                                                    <div class="col-sm-6 col-md-4">
                                                        <div class="card border shadow-xs overflow-hidden h-100 bg-white" style="cursor: pointer; transition: transform 0.15s ease;"
                                                             onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='none'"
                                                             onclick="openScreenshotLightbox('@att.FilePath', '@att.FileName', '@(msg.User?.DisplayFullName ?? "User")', '@att.UploadedDT.ToString("yyyy-MM-dd HH:mm")')">
                                                            <div style="height: 140px; background: #0f172a; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                                                <img src="@att.FilePath" alt="@att.FileName" class="w-100 h-100" style="object-fit: cover;" />
                                                            </div>
                                                            <div class="p-2 d-flex justify-content-between align-items-center small text-muted">
                                                                <span class="text-truncate fw-semibold text-dark" style="max-width: 140px;" title="@att.FileName">
                                                                    <i class="fa-solid fa-image me-1 text-primary"></i>@att.FileName
                                                                </span>
                                                                <span class="badge bg-light text-dark border"><i class="fa-solid fa-expand text-primary"></i></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Post Message Form or Closed Notice -->
                <div class="border-top pt-3 mt-4">
                    @if (isClosed)
                    {
                        <div class="alert alert-secondary d-flex align-items-center gap-3 mb-0 py-3">
                            <i class="fa-solid fa-lock text-muted fs-4"></i>
                            <div>
                                <div class="fw-bold text-dark">@Loc["Discussion Locked"]</div>
                                <div class="small text-muted">@Loc["This ticket has been resolved and closed. New messages cannot be submitted."]</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-action="AddMessage" method="post" enctype="multipart/form-data" id="replyMessageForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ticketId" value="@ticket.Id" />
                            <input type="hidden" name="pastedScreenshotsJson" id="replyScreenshotsJson" value="[]" />
                            <input type="file" id="replyFileInput" name="screenshotFiles" accept="image/*" multiple style="display:none;" />

                            <div class="row g-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-muted">@Loc["Post As"]</label>
                                    <input type="hidden" name="userId" value="@CurrentUser.GetUserId()" />
                                    <input type="text" class="form-control form-control-sm bg-light fw-semibold text-dark" value="@CurrentUser.GetFullName() (@(CurrentUser.IsMaintenance() ? $"MAINTENANCE ({CurrentUser.GetMaintenanceTeam() ?? "GENERAL"})" : CurrentUser.GetRole()))" readonly />
                                </div>
                                <div class="col-md-9">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small fw-semibold text-muted mb-0">@Loc["Add Note / Progress Update"]</label>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" id="replyAttachBtn" style="font-size: 0.75rem;">
                                            <i class="fa-solid fa-camera text-primary me-1"></i>@(Loc.IsArabic ? "إرفاق صورة / لصق لقطة (Ctrl+V)" : "Attach image / Paste (Ctrl+V)")
                                        </button>
                                    </div>
                                    <div class="input-group">
                                        <textarea name="msg" id="replyMsgTextarea" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "اكتب رداً أو الصق لقطة شاشة مباشرة بالضغط على Ctrl+V..." : "Write reply or paste screenshot directly via Ctrl+V...")"></textarea>
                                        <button type="submit" class="btn btn-primary px-3">
                                            <i class="fa-solid fa-paper-plane me-1"></i> @Loc["Send"]
                                        </button>
                                    </div>
                                </div>
                                <!-- Reply screenshots gallery preview -->
                                <div class="col-12" id="replyThumbsRow" style="display: none;">
                                    <div class="d-flex flex-wrap gap-2 pt-2 border-top mt-1" id="replyThumbsContainer"></div>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Maintenance Logs linked to this ticket -->
        @if (ticket.MaintenanceLogs.Any())
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-bold"><i class="fa-solid fa-wrench text-warning me-2"></i> @Loc["Maintenance Work Orders"] (@ticket.MaintenanceLogs.Count)</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["Date Opened"]</th>
                                    <th>@Loc["Type"]</th>
                                    <th>@Loc["Work Summary / Actions Taken"]</th>
                                    <th>@Loc["Replaced Parts & Components"]</th>
                                    <th>@Loc["Assigned Technician"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in ticket.MaintenanceLogs)
                                {
                                    <tr>
                                        <td>@m.TimStamp?.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge @(m.MaintenanceType == 2 ? "bg-info text-dark" : "bg-danger")">@Loc.MaintenanceType(m.MaintenanceType)</span></td>
                                        <td>@m.Description</td>
                                        <td>
                                            @if (m.ParsedParts.Any())
                                            {
                                                @foreach (var part in m.ParsedParts)
                                                {
                                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                                        <i class="fa-solid fa-microchip text-primary me-1"></i> @part.PartName (x@(part.Quantity))
                                                    </span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(m.PartsReplaced))
                                            {
                                                <code class="text-dark bg-light px-2 py-1 rounded small">@m.PartsReplaced</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@Loc["None assigned"]</span>
                                            }
                                        </td>
                                        <td>@(m.Technician?.DisplayFullName ?? (Loc.IsArabic ? "شركة صيانة خارجية" : "Contractor"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Status & Assignment Controls + Asset Info -->
    <div class="col-lg-4">
        <!-- Ticket Controls -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-sliders text-primary me-2"></i> @Loc["Ticket Details & Management"]</h6>
            </div>
            <div class="card-body">
                <!-- Target Team: Relocked to equipment scope -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">@Loc["Responsible Department"]</label>
                    <div>
                        <span class="badge bg-primary fs-6"><i class="fa-solid fa-users-gear me-1"></i> @Loc.TargetTeam(ticket.TargetTeam)</span>
                    </div>
                </div>

                @if (canManage && !isClosed)
                {
                    <!-- Status Updater Form -->
                    <form asp-action="UpdateStatus" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@ticket.Id" />
                        <label class="form-label small fw-semibold text-muted">@Loc["Status"]</label>
                        <div class="input-group">
                            <select name="statusId" class="form-select">
                                @foreach (var st in Model.Statuses)
                                {
                                    <option value="@st.Id" selected="@(st.Id == ticket.StatusId)">@(st.DisplayStatus ?? Loc.Status(st.Status))</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-primary">@Loc["Save"]</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">@Loc["Status"]</label>
                        <div>
                            @if (isClosed)
                            {
                                <span class="badge bg-success fs-6"><i class="fa-solid fa-check me-1"></i> @Loc["Closed"]</span>
                            }
                            else if (ticket.StatusId == 6 || string.Equals(ticket.Status?.Status, "maintenance", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-warning text-dark fs-6 border border-warning"><i class="fa-solid fa-screwdriver-wrench me-1 text-warning"></i> @Loc["Under Maintenance"]</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark fs-6">@(ticket.Status?.DisplayStatus ?? Loc.Status(ticket.Status?.Status))</span>
                            }
                        </div>
                    </div>
                }

                <!-- Specialist / Technician Assignment Form (Available to Requester, Maintenance, and Admin) -->
                @if (!isClosed && (canManage || ticket.OpenedBy == CurrentUser.GetUserId() || ticket.OnBehalfOf == CurrentUser.GetUserId()))
                {
                    <form asp-action="AssignTechnician" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ticketId" value="@ticket.Id" />
                        <label class="form-label small fw-semibold text-muted">
                            <i class="fa-solid fa-user-gear text-primary me-1"></i> @Loc["Assigned Specialist in Responsible Department (Optional)"]
                        </label>
                        <div class="input-group">
                            <select name="techUserId" class="form-select">
                                <option value="">@(Loc.IsArabic ? "-- غير معين (قائمة مهام القسم) --" : "-- Unassigned (Department Queue) --")</option>
                                @foreach (var tech in responsibleTechs)
                                {
                                    <option value="@tech.Id" selected="@(tech.Id == ticket.Handler?.TechUserId)">
                                        @tech.DisplayFullName (@tech.DisplayRole)
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-primary">@Loc["Assign"]</button>
                        </div>
                        <div class="form-text small text-muted">@(Loc.IsArabic ? $"إسناد التذكرة إلى أخصائي في فريق {Loc.TargetTeam(responsibleTeam)}." : $"Assign or reassign to a specialist in the responsible {responsibleTeam} department.")</div>
                    </form>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">@Loc["Assigned Technician"]</label>
                        <div class="fw-semibold text-dark">
                            <i class="fa-solid fa-user-gear text-secondary me-1"></i>
                            @(ticket.Handler?.TechUser?.DisplayFullName ?? Loc["Unassigned"])
                            @if (ticket.Handler?.TechUser != null)
                            {
                                <span class="text-muted small">(@ticket.Handler.TechUser.DisplayRole)</span>
                            }
                        </div>
                    </div>
                }

                <div class="pt-2 border-top small">
                    <div class="d-flex justify-content-between text-muted mb-1">
                        <span>@Loc["Date Opened"]:</span>
                        <span class="fw-semibold text-dark">@ticket.OpenedDT?.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted">
                        <span>@Loc["Date Closed"]:</span>
                        <span class="fw-semibold text-dark">@(ticket.ClosedDT?.ToString("MMM dd, yyyy HH:mm") ?? (Loc.IsArabic ? "قيد المعالجة" : "Pending Resolution"))</span>
                    </div>
                </div>

                @if (canSeeNetworkInfo && (!string.IsNullOrWhiteSpace(ticket.IpAddress) || !string.IsNullOrWhiteSpace(ticket.MacAddress)))
                {
                    <div class="pt-2 border-top small">
                        <div class="text-muted fw-bold mb-1"><i class="fa-solid fa-network-wired text-info me-1"></i> @(Loc.IsArabic ? "بيانات شبكة العميل (خاص بالصيانة):" : "Client Origin Network (Maint):")</div>
                        <div class="d-flex justify-content-between text-muted mb-1 font-monospace">
                            <span>@(Loc.IsArabic ? "IP المصدر:" : "Origin IP:"):</span>
                            <span class="fw-semibold text-primary">@(ticket.IpAddress ?? "N/A")</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted font-monospace">
                            <span>@(Loc.IsArabic ? "MAC المصدر:" : "Origin MAC:"):</span>
                            <span class="fw-semibold text-dark">@(ticket.MacAddress ?? "N/A")</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Linked Asset Card -->
        @if (ticket.Asset != null)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold"><i class="fa-solid fa-box text-success me-2"></i> @Loc["Linked Hardware Asset"]</h6>
                    <a href="@Url.Action("Details", "Assets", new { id = ticket.Asset.Id })" class="btn btn-sm btn-outline-primary py-0">@Loc["View Details"]</a>
                </div>
                <div class="card-body">
                    <div class="fw-bold text-dark fs-5">@ticket.Asset.HospitalNo</div>
                    <div class="text-muted small mb-2">@ticket.Asset.Brand &bull; @ticket.Asset.DisplayType</div>

                    <div class="small mb-1">
                        <span class="text-muted">@Loc["Serial Number"]:</span> <code class="text-dark">@(ticket.Asset.SerialNo ?? "N/A")</code>
                    </div>
                    <div class="small mb-1">
                        <span class="text-muted">@Loc["Location"]:</span> <strong>@(ticket.Asset.Room?.DisplayName ?? Loc["Unassigned"])</strong>
                    </div>
                    <div class="small mb-1">
                        <span class="text-muted">@Loc["Custodian"]:</span> <strong>@(ticket.Asset.User?.DisplayFullName ?? (Loc.IsArabic ? "المخزن المركزي" : "Central Stock"))</strong>
                    </div>
                    <div class="small">
                        <span class="text-muted">@Loc["Status"]:</span> 
                        @if (string.Equals(ticket.Asset.Status, "Under Maintenance", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-warning text-dark border border-warning"><i class="fa-solid fa-truck-ramp-box me-1"></i> @Loc["Under Maintenance"]</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border">@ticket.Asset.DisplayStatus</span>
                        }
                    </div>
                    @if (string.Equals(ticket.Asset.Status, "Under Maintenance", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="alert alert-warning border border-warning p-2 mt-2 mb-0 small">
                            <i class="fa-solid fa-truck-ramp-box me-1 text-warning"></i>
                            <strong>@(Loc.IsArabic ? "لدى المورد:" : "At Supplier:")</strong> @(Loc.IsArabic ? "الجهاز قيد الصيانة الخارجية لدى الشركة الموردة." : "Currently undergoing external vendor maintenance.")
                            <a href="@Url.Action("Index", "Maintenance")" class="alert-link d-block mt-1">@Loc["Maintenance Work Orders"] &rarr;</a>
                        </div>
                    }
                    else if (!isClosed && canManage)
                    {
                        <a href="@Url.Action("SendToSupplier", "Maintenance", new { assetId = ticket.AssetId, ticketId = ticket.Id })" class="btn btn-outline-warning text-dark btn-sm w-100 mt-2 fw-semibold">
                            <i class="fa-solid fa-truck-ramp-box me-1"></i> @Loc["Send to Vendor"]
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Spare Parts Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-layer-group text-warning me-2"></i> @Loc["Spare Parts"]</h6>
                @if (!isClosed && canManage && Model.AvailableSpareParts.Any())
                {
                    <button type="button" class="btn btn-sm btn-outline-success py-0" data-bs-toggle="modal" data-bs-target="#useSparePartModal">
                        <i class="fa-solid fa-plus me-1"></i> @Loc["Use Spare Part"]
                    </button>
                }
            </div>
            <div class="card-body">
                @if (Model.UsedSpareParts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless align-middle mb-0" style="font-size: 0.85rem;">
                            <thead class="text-muted border-bottom">
                                <tr>
                                    <th>@Loc["Part / Item Name"]</th>
                                    <th class="text-center">@Loc["Quantity"]</th>
                                    <th>@Loc["By"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.UsedSpareParts)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@(item.SparePart?.DisplayName ?? "Item")</div>
                                            @if (!string.IsNullOrWhiteSpace(item.SparePart?.PartNumber))
                                            {
                                                <code class="text-muted small">@item.SparePart.PartNumber</code>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                                            {
                                                <div class="text-muted small fst-italic">@item.Notes</div>
                                            }
                                        </td>
                                        <td class="text-center fw-bold text-danger">@Math.Abs(item.QuantityChanged) @(item.SparePart?.Unit ?? "Piece")</td>
                                        <td class="small text-muted">
                                            @(item.User?.DisplayFullName ?? "Tech")
                                            <div style="font-size: 0.7rem;">@item.Timestamp.ToString("MMM dd, HH:mm")</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted small py-2 text-center">
                        <i class="fa-solid fa-boxes-stacked me-1 opacity-50"></i>
                        @Loc["No spare parts used yet for this ticket."]
                    </div>
                }

                @if (!isClosed && canManage)
                {
                    <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-muted">@Loc["Available in Reserve"]: <strong>@Model.AvailableSpareParts.Count @(Loc.IsArabic ? "صنف متاح" : "items")</strong></span>
                        @if (Model.AvailableSpareParts.Any())
                        {
                            <button type="button" class="btn btn-sm btn-success text-white" data-bs-toggle="modal" data-bs-target="#useSparePartModal">
                                <i class="fa-solid fa-wrench me-1"></i> @Loc["Use Spare Part"]
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Requester Info Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-user text-secondary me-2"></i> @Loc["Requester Information"]</h6>
            </div>
            <div class="card-body">
                <div class="fw-bold text-dark fs-6">@(ticket.OpenedByUser?.DisplayFullName ?? (Loc.IsArabic ? "مستخدم غير معروف" : "Unknown User"))</div>
                <div class="small text-muted mb-2">@(ticket.OpenedByUser?.DisplayRole ?? (Loc.IsArabic ? "موظف" : "Staff")) &bull; @(ticket.OpenedByUser?.Department?.DisplayName ?? Loc["General Staff"])</div>

                @if (ticket.OnBehalfOfUser != null && ticket.OnBehalfOf != ticket.OpenedBy)
                {
                    <div class="p-2 bg-light rounded small mt-2">
                        <span class="text-muted">@Loc["On Behalf Of"]:</span>
                        <div class="fw-semibold text-dark">@ticket.OnBehalfOfUser.DisplayFullName</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (!isClosed && canManage)
{
    <!-- Modal: Log Maintenance from Ticket -->
    <div class="modal fade" id="maintenanceModal" tabindex="-1" aria-labelledby="maintenanceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content border-0 shadow">
                <form asp-action="LogMaintenance" method="post" id="logMaintenanceForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@ticket.Id" />
                    <input type="hidden" name="assetId" value="@(ticket.AssetId ?? 1)" />
                    <input type="hidden" name="partsReplaced" id="ticketPartsReplacedJson" value="" />

                    <div class="modal-header bg-warning bg-opacity-10">
                        <h5 class="modal-title fw-bold text-dark" id="maintenanceModalLabel">
                            <i class="fa-solid fa-wrench text-warning me-2"></i> @Loc["Log Maintenance Work Order"]
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">@Loc["Service Scope"]</label>
                                <select name="maintenanceType" class="form-select">
                                    <option value="1">@(Loc.IsArabic ? "إصلاح عطل طارئ / علاجي" : "Breakdown / Corrective Repair")</option>
                                    <option value="2">@(Loc.IsArabic ? "فحص دوري / صيانة وقائية" : "Preventive / Periodic Inspection")</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">@Loc["Assigned Technician"]</label>
                                <select name="technicianId" class="form-select" required>
                                    @foreach (var tech in responsibleTechs)
                                    {
                                        <option value="@tech.Id" selected="@(tech.Id == (ticket.Handler?.TechUserId ?? tech.Id))">@tech.DisplayFullName (@tech.DisplayRole)</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-semibold">@Loc["Third-Party Supplier / Vendor (Optional)"]</label>
                                <select name="supplierId" class="form-select">
                                    <option value="">-- @(Loc.IsArabic ? "فريق الصيانة الداخلي للمستشفى" : "In-House IT Staff") --</option>
                                    @foreach (var sup in Model.Suppliers)
                                    {
                                        <option value="@sup.Id">@sup.DisplayName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">@Loc["Maintenance Action & Work Performed"] <span class="text-danger">*</span></label>
                                <textarea name="description" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "اشرح الفحص والتشخيص، الإصلاحات، المعايرة، أو الإجراءات المنفذة..." : "Describe diagnosis, repairs, calibration, or actions taken...")" required></textarea>
                            </div>

                            <!-- Replaced Parts & Consumables (Application-Managed UI translated to JSON) -->
                            <div class="col-12">
                                <div class="border rounded-3 p-3 bg-light bg-opacity-50">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <span class="fw-bold text-dark">
                                                <i class="fa-solid fa-microchip text-primary me-1"></i>
                                                @(Loc.IsArabic ? "قطع الغيار والمستهلكات المستبدلة" : "Replaced Parts & Consumables")
                                            </span>
                                            <span class="badge bg-primary-subtle text-primary ms-1 small">@(Loc.IsArabic ? "إدارة تلقائية (JSON)" : "App Managed")</span>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddTicketPartRow">
                                            <i class="fa-solid fa-plus me-1"></i> @(Loc.IsArabic ? "إضافة قطعة مستبدلة" : "Add Replaced Part")
                                        </button>
                                    </div>
                                    <p class="text-muted small mb-2">
                                        @(Loc.IsArabic 
                                            ? "أدخل بيانات القطع المستبدلة في الخانات أدناه، وسيتولى النظام ترجمتها وتخزينها تلقائياً بصيغة JSON دون الحاجة لكتابة كود يدوي." 
                                            : "Fill the text boxes for each replaced component. The application automatically translates your entries into structured JSON.")
                                    </p>

                                    <!-- Available Spare Parts Autocomplete Datalist -->
                                    <datalist id="ticketSparePartsDatalist">
                                        @foreach (var p in Model.AvailableSpareParts)
                                        {
                                            <option value="@p.Name" data-sku="@p.PartNumber">@p.Name (@p.PartNumber) - Stock: @p.Quantity</option>
                                        }
                                    </datalist>

                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered bg-white align-middle mb-1" id="ticketPartsTable">
                                            <thead class="table-light small">
                                                <tr>
                                                    <th style="width: 38%;">@(Loc.IsArabic ? "اسم القطعة / الصنف" : "Part / Component Name") <span class="text-danger">*</span></th>
                                                    <th style="width: 26%;">@(Loc.IsArabic ? "رقم القطعة / الكود" : "Part # / SKU")</th>
                                                    <th style="width: 14%;">@(Loc.IsArabic ? "الكمية" : "Quantity")</th>
                                                    <th style="width: 16%;">@(Loc.IsArabic ? "سيريال / ملاحظات" : "Serial / Notes")</th>
                                                    <th style="width: 6%;" class="text-center"></th>
                                                </tr>
                                            </thead>
                                            <tbody id="ticketPartsTableBody">
                                                <!-- Dynamic rows inserted via JavaScript -->
                                            </tbody>
                                        </table>
                                        <div id="noTicketPartsAlert" class="text-center py-2 text-muted small bg-white border border-dashed rounded">
                                            <i class="fa-solid fa-circle-info me-1"></i>
                                            @(Loc.IsArabic ? "لم يتم تحديد أي قطع غيار مستبدلة (انقر على 'إضافة قطعة مستبدلة' إن وُجدت)." : "No parts replaced (click 'Add Replaced Part' if components were swapped).")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                            <i class="fa-solid fa-check me-1"></i> @Loc["Save Maintenance Record"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Use Spare Part from Reserve Stock -->
    <div class="modal fade" id="useSparePartModal" tabindex="-1" aria-labelledby="useSparePartModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="LogSparePartUsage" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@ticket.Id" />

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="useSparePartModalLabel">
                            <i class="fa-solid fa-wrench text-warning me-2"></i> @Loc["Log Spare Part Usage"]
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info py-2 small mb-3">
                            <i class="fa-solid fa-info-circle me-1"></i>
                            @(Loc.IsArabic ? $"يتم استهلاك قطع الغيار والمستهلكات مباشرة من مخزون قسم {Loc.TargetTeam(ticket.TargetTeam)} وخصمها وتسجيلها في التذكرة." : $"Parts are deducted directly from {ticket.TargetTeam} Reserve Stock and logged into this ticket's timeline.")
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Select Spare Part"]</label>
                            <select name="sparePartId" class="form-select" required>
                                @foreach (var part in Model.AvailableSpareParts)
                                {
                                    <option value="@part.Id">
                                        @part.DisplayName - @(Loc.IsArabic ? $"المخزون: {part.Quantity} {part.Unit}" : $"In Stock: {part.Quantity} {part.Unit}") @(!string.IsNullOrWhiteSpace(part.PartNumber) ? $"[{part.PartNumber}]" : "")
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Quantity"]</label>
                            <input type="number" name="quantity" class="form-control" value="1" min="1" max="1000" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Notes / Justification (Optional)"]</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "مثال: استبدال القرص التالف / تركيب فلتر دوري جديد..." : "e.g. Replaced damaged drive / installed new periodic filter...")"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fa-solid fa-check me-1"></i> @Loc["Log Spare Part Usage"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Resolve & Close Ticket -->
    <div class="modal fade" id="closeTicketModal" tabindex="-1" aria-labelledby="closeTicketModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="CloseTicket" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@ticket.Id" />

                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title fw-bold" id="closeTicketModalLabel"><i class="fa-solid fa-check-circle me-2"></i> @Loc["Resolve & Close Ticket"] #@ticket.Id</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">
                            @(Loc.IsArabic ? "إغلاق التذكرة يعين حالتها إلى مكتملة، ويحدد الطابع الزمني للحل، ويحفظ الفنيين المشاركين في سجلات التحليل." : "Closing this ticket marks the issue as resolved, sets the closed timestamp, and credits all selected technicians in the maintenance analytics.")
                        </p>

                        <!-- Multi-Technician Selection (Only Responsible Department Employees) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold d-flex justify-content-between align-items-center mb-1">
                                <span><i class="fa-solid fa-user-group text-success me-1"></i> @(Loc.IsArabic ? "الفنيون المشاركون في حل التذكرة (تحديد متعدد):" : "Who worked on & resolved this ticket? (Multi-check):")</span>
                                <span class="badge bg-primary-subtle text-primary border">
                                    <i class="fa-solid fa-users-gear me-1"></i> @(Loc.IsArabic ? $"قسم {Loc.TargetTeam(ticket.TargetTeam)}" : $"{ticket.TargetTeam} Department")
                                </span>
                            </label>
                            <div class="small text-muted mb-2">
                                @(Loc.IsArabic 
                                    ? $"يتم عرض موظفي قسم {Loc.TargetTeam(ticket.TargetTeam)} المسؤول عن التذكرة فقط." 
                                    : $"Displaying only employees belonging to the responsible {ticket.TargetTeam} department.")
                            </div>
                            
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text" id="techSearchFilter" class="form-control" placeholder="@(Loc.IsArabic ? "بحث عن اسم فني..." : "Filter technicians by name...")" onkeyup="filterCloseTechs()">
                            </div>

                            <div class="border rounded p-2 bg-light" style="max-height: 200px; overflow-y: auto;" id="techChecklistContainer">
                                @{
                                    var currentUserId = CurrentUser.GetUserId();
                                    var assignedTechId = ticket.Handler?.TechUserId;
                                    var candidateTechs = responsibleTechs;
                                    var orderedTechs = candidateTechs
                                        .OrderByDescending(u => u.Id == currentUserId || u.Id == assignedTechId)
                                        .ThenBy(u => u.FullName)
                                        .ToList();
                                }
                                @if (orderedTechs.Any())
                                {
                                    @foreach (var tech in orderedTechs)
                                    {
                                        bool isPreChecked = (tech.Id == currentUserId) || (assignedTechId.HasValue && tech.Id == assignedTechId.Value);
                                        <div class="form-check py-1 px-2 mb-1 rounded bg-white border border-light tech-item-row" data-name="@(tech.FullName?.ToLower()) @(tech.FullNameAr?.ToLower()) @(tech.DomainUser?.ToLower())">
                                            <input class="form-check-input" type="checkbox" name="closedByUserIds" value="@tech.Id" id="closeTech_@tech.Id" @(isPreChecked ? "checked" : "")>
                                            <label class="form-check-label d-flex align-items-center justify-content-between w-100 cursor-pointer" for="closeTech_@tech.Id">
                                                <span class="fw-semibold text-dark">
                                                    <i class="fa-solid fa-user-gear text-secondary me-1"></i> @tech.DisplayFullName
                                                    @if (tech.Id == currentUserId)
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary small ms-1">@(Loc.IsArabic ? "أنت" : "You")</span>
                                                    }
                                                    @if (assignedTechId.HasValue && tech.Id == assignedTechId.Value)
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary small ms-1">@(Loc.IsArabic ? "المُعيَّن" : "Assigned")</span>
                                                    }
                                                </span>
                                                <span class="badge bg-light text-dark border">
                                                    @(string.IsNullOrEmpty(tech.MaintenanceTeam) ? tech.RoleDisplay : tech.MaintenanceTeam)
                                                </span>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small text-center py-2">
                                        @(Loc.IsArabic ? "لا يوجد فنيون مسجلون في هذا القسم" : "No specialists found in this department")
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Resolution Summary & Solution"] <span class="text-danger">*</span></label>
                            <textarea name="resolutionNotes" class="form-control" rows="3" placeholder="@(Loc.IsArabic ? "اشرح ما تم لحل المشكلة أو الإجراءات المنفذة..." : "Explain what resolved the problem or what steps were completed...")" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-success fw-semibold"><i class="fa-solid fa-check me-1"></i> @Loc["Confirm & Close Ticket"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Screenshot Lightbox Modal -->
    <div class="modal fade" id="screenshotLightboxModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-2">
                    <h6 class="modal-title small font-monospace" id="lightboxFileName">Screenshot Preview</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0 bg-black text-center" style="max-height: 80vh; overflow: auto;">
                    <img id="lightboxImage" src="" alt="Screenshot" class="img-fluid" style="max-height: 75vh; object-fit: contain;" />
                </div>
                <div class="modal-footer bg-dark text-white py-2 d-flex justify-content-between align-items-center">
                    <small class="text-white-50" id="lightboxMeta"></small>
                    <a id="lightboxDownloadBtn" href="" download class="btn btn-sm btn-outline-light">
                        <i class="fa-solid fa-download me-1"></i> @(Loc.IsArabic ? "تحميل الصورة" : "Download Image")
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function openScreenshotLightbox(filePath, fileName, uploadedBy, uploadedDT) {
        const modalEl = document.getElementById("screenshotLightboxModal");
        if (!modalEl) return;
        document.getElementById("lightboxImage").src = filePath;
        document.getElementById("lightboxFileName").textContent = fileName;
        document.getElementById("lightboxMeta").textContent = `${uploadedBy} • ${uploadedDT}`;
        document.getElementById("lightboxDownloadBtn").href = filePath;
        document.getElementById("lightboxDownloadBtn").download = fileName;
        const bsModal = new bootstrap.Modal(modalEl);
        bsModal.show();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const isAr = document.documentElement.dir === 'rtl' || document.documentElement.lang.startsWith('ar');
        const replyForm = document.getElementById("replyMessageForm");
        const replyMsg = document.getElementById("replyMsgTextarea");
        const replyAttachBtn = document.getElementById("replyAttachBtn");
        const replyFileInput = document.getElementById("replyFileInput");
        const replyScreenshotsJson = document.getElementById("replyScreenshotsJson");
        const replyThumbsRow = document.getElementById("replyThumbsRow");
        const replyThumbsContainer = document.getElementById("replyThumbsContainer");

        let replyScreenshots = [];

        function updateReplyScreenshots() {
            const inputEl = document.getElementById("replyScreenshotsJson");
            if (inputEl) {
                inputEl.value = JSON.stringify(replyScreenshots);
            }
            if (replyThumbsRow && replyThumbsContainer) {
                if (replyScreenshots.length > 0) {
                    replyThumbsRow.style.display = "block";
                    replyThumbsContainer.innerHTML = "";
                    replyScreenshots.forEach((dataUrl, idx) => {
                        const thumb = document.createElement("div");
                        thumb.className = "position-relative border rounded shadow-xs overflow-hidden";
                        thumb.style.width = "64px";
                        thumb.style.height = "64px";
                        thumb.innerHTML = `
                            <img src="${dataUrl}" style="width: 100%; height: 100%; object-fit: cover;" />
                            <button type="button" class="btn btn-danger btn-sm p-0 position-absolute top-0 end-0 rounded-circle" style="width: 18px; height: 18px; font-size: 0.65rem; line-height: 1;" title="${isAr ? "حذف" : "Remove"}">&times;</button>
                        `;
                        thumb.querySelector("button").addEventListener("click", function () {
                            replyScreenshots.splice(idx, 1);
                            updateReplyScreenshots();
                        });
                        replyThumbsContainer.appendChild(thumb);
                    });
                } else {
                    replyThumbsRow.style.display = "none";
                    replyThumbsContainer.innerHTML = "";
                }
            }
        }

        function handleReplyImage(file) {
            if (!file || !file.type.startsWith("image/")) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                replyScreenshots.push(e.target.result);
                updateReplyScreenshots();
            };
            reader.readAsDataURL(file);
        }

        // Paste Ctrl+V listener on details page
        window.addEventListener("paste", function (e) {
            if (!e.clipboardData || !e.clipboardData.items) return;
            let found = false;
            for (let i = 0; i < e.clipboardData.items.length; i++) {
                const item = e.clipboardData.items[i];
                if (item.type.indexOf("image") !== -1) {
                    const blob = item.getAsFile();
                    if (blob) {
                        handleReplyImage(blob);
                        found = true;
                    }
                }
            }
            if (found && replyMsg) {
                replyMsg.focus();
            }
        });

        if (replyAttachBtn && replyFileInput) {
            replyAttachBtn.addEventListener("click", function () {
                replyFileInput.click();
            });
        }

        if (replyFileInput) {
            replyFileInput.addEventListener("change", function () {
                if (this.files) {
                    Array.from(this.files).forEach(f => handleReplyImage(f));
                    this.value = "";
                }
            });
        }

        if (replyMsg) {
            replyMsg.addEventListener("dragover", function (e) {
                e.preventDefault();
                replyMsg.classList.add("border-primary");
            });
            replyMsg.addEventListener("dragleave", function () {
                replyMsg.classList.remove("border-primary");
            });
            replyMsg.addEventListener("drop", function (e) {
                e.preventDefault();
                replyMsg.classList.remove("border-primary");
                if (e.dataTransfer && e.dataTransfer.files) {
                    Array.from(e.dataTransfer.files).forEach(f => handleReplyImage(f));
                }
            });
        }

        if (replyForm) {
            replyForm.addEventListener("submit", function (e) {
                updateReplyScreenshots();
                const hasText = replyMsg && replyMsg.value.trim().length > 0;
                const hasImages = replyScreenshots.length > 0;
                if (!hasText && !hasImages) {
                    e.preventDefault();
                    return false;
                }
                if (!hasText && hasImages && replyMsg) {
                    replyMsg.value = isAr ? "📸 [لقطة شاشة مرفقة في المحادثة]" : "📸 [Attached screenshot in chat]";
                }
            });
        }
    });

    function filterCloseTechs() {
        var query = (document.getElementById('techSearchFilter')?.value || '').toLowerCase().trim();
        var rows = document.querySelectorAll('#techChecklistContainer .tech-item-row');
        rows.forEach(function(row) {
            var text = (row.getAttribute('data-name') || '').toLowerCase();
            row.style.display = (!query || text.indexOf(query) >= 0) ? '' : 'none';
        });
    }

    // --- Dynamic Replaced Parts Form (Translates text boxes to JSON) ---
    const ticketPartsTableBody = document.getElementById("ticketPartsTableBody");
    const noTicketPartsAlert = document.getElementById("noTicketPartsAlert");
    const btnAddTicketPartRow = document.getElementById("btnAddTicketPartRow");
    const ticketPartsReplacedJson = document.getElementById("ticketPartsReplacedJson");
    const logMaintenanceForm = document.getElementById("logMaintenanceForm");

    function updateTicketPartsAlert() {
        if (!ticketPartsTableBody || !noTicketPartsAlert) return;
        noTicketPartsAlert.style.display = ticketPartsTableBody.children.length === 0 ? "block" : "none";
    }

    function addTicketPartRow(item) {
        if (!ticketPartsTableBody) return;
        item = item || {};
        const tr = document.createElement("tr");
        tr.innerHTML = `
            <td>
                <input type="text" class="form-control form-control-sm t-part-name" list="ticketSparePartsDatalist" placeholder="${isAr ? 'اسم القطعة (مثال: شاشة، بطارية، قرص SSD)' : 'e.g. 1TB NVMe SSD'}" value="${item.partName || ''}" required onchange="onTicketPartSelected(this)" />
            </td>
            <td>
                <input type="text" class="form-control form-control-sm t-part-sku font-monospace" placeholder="${isAr ? 'كود القطعة' : 'e.g. DP/N 0XXV21'}" value="${item.partNumber || ''}" />
            </td>
            <td>
                <input type="number" class="form-control form-control-sm t-part-qty text-center" min="1" value="${item.quantity || 1}" required />
            </td>
            <td>
                <input type="text" class="form-control form-control-sm t-part-notes" placeholder="${isAr ? 'سيريال / ملاحظات' : 'SN / Notes'}" value="${item.notes || ''}" />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger p-1" onclick="removeTicketPartRow(this)" title="${isAr ? 'حذف' : 'Remove'}">
                    <i class="fa-solid fa-trash fa-xs"></i>
                </button>
            </td>
        `;
        ticketPartsTableBody.appendChild(tr);
        updateTicketPartsAlert();
    }

    window.removeTicketPartRow = function(btn) {
        btn.closest("tr").remove();
        updateTicketPartsAlert();
    };

    window.onTicketPartSelected = function(input) {
        const val = input.value.trim();
        const datalist = document.getElementById("ticketSparePartsDatalist");
        if (datalist) {
            const opt = datalist.querySelector(`option[value="${val}"]`);
            if (opt) {
                const sku = opt.getAttribute("data-sku");
                if (sku) {
                    const row = input.closest("tr");
                    const skuInput = row.querySelector(".t-part-sku");
                    if (skuInput && !skuInput.value) {
                        skuInput.value = sku;
                    }
                }
            }
        }
    };

    if (btnAddTicketPartRow) {
        btnAddTicketPartRow.addEventListener("click", function() {
            addTicketPartRow();
        });
    }

    if (logMaintenanceForm) {
        logMaintenanceForm.addEventListener("submit", function() {
            const rows = ticketPartsTableBody.querySelectorAll("tr");
            const parts = [];
            rows.forEach(tr => {
                const name = tr.querySelector(".t-part-name").value.trim();
                if (name) {
                    parts.push({
                        partName: name,
                        partNumber: tr.querySelector(".t-part-sku").value.trim(),
                        quantity: parseInt(tr.querySelector(".t-part-qty").value) || 1,
                        notes: tr.querySelector(".t-part-notes").value.trim()
                    });
                }
            });
            ticketPartsReplacedJson.value = parts.length > 0 ? JSON.stringify(parts) : "";
        });
    }
</script>
}
