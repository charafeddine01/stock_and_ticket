@model IEnumerable<StockPortal.Models.SparePartForm>
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = Loc["Spare Part Specification Forms"];
    bool isMaintenance = CurrentUser.IsMaintenance();
    var isAr = Loc.IsArabic;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-layer-group text-primary me-2"></i> @(isAr ? "نماذج مواصفات قطع الغيار" : "Spare Part Forms & Templates")</h4>
        <small class="text-muted">@(isAr ? "نماذج مواصفات ديناميكية تُستخدم لتوحيد خصائص ومواصفات قطع الغيار عند إضافتها للمخزون" : "Universal dynamic JSON forms to standardize spare part specifications when adding reserve stock")</small>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "SpareParts")" class="btn btn-outline-secondary">
            <i class="fa-solid fa-boxes-stacked me-1"></i> @(isAr ? "مخزون قطع الغيار" : "Spare Parts Stock")
        </a>
        <a href="@Url.Action("Create")" class="btn btn-primary fw-bold shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> @(isAr ? "إضافة نموذج قطعة غيار" : "New Spare Part Form")
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>
                    <h5 class="fw-bold">@(isAr ? "لا توجد نماذج لقطع الغيار حالياً" : "No Spare Part Forms Configured")</h5>
                    <p class="text-muted">@(isAr ? "قم بإنشاء النموذج الأول لتوحيد مواصفات قطع الغيار (مثل: الرامات، وحدات التخزين، البطاريات، المضخات...)." : "Create your first spare part form template to standardize part specifications (RAM, SSD, Batteries, Valves...).")</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> @(isAr ? "إضافة نموذج قطعة غيار" : "New Spare Part Form")
                    </a>
                </div>
            </div>
        </div>
    }
    @foreach (var form in Model)
    {
        var fields = form.Fields;
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-microchip text-primary me-1"></i> @form.Name
                    </h6>
                    <span class="badge @(form.Department == "BIOMEDICAL" ? "bg-info text-dark" : form.Department == "GENERAL" ? "bg-warning text-dark" : "bg-primary")">
                        @Loc.TargetTeam(form.Department)
                    </span>
                </div>
                <div class="card-body">
                    <div class="small text-muted mb-2 fw-semibold">@(isAr ? $"حقول المواصفات ({fields.Count} حقول):" : $"Specifications Schema ({fields.Count} fields):")</div>
                    <ul class="list-group list-group-flush small mb-3">
                        @foreach (var f in fields.Take(5))
                        {
                            <li class="list-group-item px-0 py-1 d-flex justify-content-between text-truncate">
                                <span class="fw-medium text-dark">&bull; @f.Label</span>
                                <span class="badge bg-light text-muted border">@f.Type</span>
                            </li>
                        }
                        @if (fields.Count > 5)
                        {
                            <li class="list-group-item px-0 py-1 text-muted text-center fst-italic">
                                + @(fields.Count - 5) @(isAr ? "حقول إضافية..." : "more fields...")
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pt-0 pb-3">
                    <small class="text-muted"><i class="fa-regular fa-clock me-1"></i> @form.CreatedAt.ToString("yyyy-MM-dd")</small>
                    <div class="btn-group btn-group-sm">
                        <a href="@Url.Action("Edit", new { id = form.Id })" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-pen-to-square me-1"></i> @Loc["Edit"]
                        </a>
                        <form asp-action="Delete" asp-route-id="@form.Id" method="post" class="d-inline" onsubmit="return confirm('@(isAr ? "هل أنت متأكد من حذف هذا النموذج؟" : "Are you sure you want to delete this template?")')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
