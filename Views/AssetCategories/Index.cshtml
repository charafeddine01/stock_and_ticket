@model IEnumerable<StockPortal.Models.AssetCategory>
@{
    ViewData["Title"] = Loc["Asset Categories"];
    var availableDepts = ViewBag.AvailableDepartments as string[] ?? MaintenanceTeams.All;
    var selectedDept = ViewBag.SelectedDepartment as string;
    var isAr = Loc.IsArabic;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="mb-1 fw-bold text-dark">
            <i class="fa-solid fa-tags text-primary me-2"></i> @Loc["Asset Categories"]
        </h3>
        <p class="text-muted mb-0">@(isAr ? "تعريف وتصنيف فئات الأصول والمعدات (حاسوب، طابعة، ملحقات، أجهزة طبية، تكييف، إلخ) قبل إضافتها للمخزون" : "Define and manage equipment categories (e.g. PC, Printer, Peripheral, Medical, General) prior to asset registration.")</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            <i class="fa-solid fa-plus me-1"></i> @(isAr ? "إضافة فئة جديدة" : "New Category")
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Department Filter Pills -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="text-muted small fw-semibold me-2">@Loc["Department"]:</span>
            <a href="@Url.Action("Index")" class="btn btn-sm @(string.IsNullOrEmpty(selectedDept) || selectedDept == "ALL" ? "btn-primary" : "btn-outline-secondary")">
                @Loc["All Departments"]
            </a>
            @foreach (var dept in availableDepts)
            {
                <a href="@Url.Action("Index", new { department = dept })" class="btn btn-sm @(selectedDept == dept ? "btn-primary" : "btn-outline-secondary")">
                    @Loc[dept]
                </a>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th style="width: 25%;">@Loc["Category Name"]</th>
                    <th style="width: 25%;">@(isAr ? "الاسم العربي" : "Arabic Name")</th>
                    <th style="width: 15%;">@Loc["Department"]</th>
                    <th style="width: 15%;">@(isAr ? "عدد الأصول المسجلة" : "Linked Assets")</th>
                    <th style="width: 20%;" class="text-end">@Loc["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-inbox fs-3 d-block mb-2"></i>
                            @(isAr ? "لا توجد فئات معرفة حالياً لهذا القسم." : "No categories defined for this department yet.")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">
                                    <i class="fa-solid fa-folder me-2 text-primary opacity-75"></i> @item.Name
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 320px;">@item.Description</div>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold text-secondary">@(item.NameAr ?? "-")</span>
                            </td>
                            <td>
                                <span class="badge @(item.Department == MaintenanceTeams.IT ? "bg-primary-subtle text-primary border border-primary-subtle" : item.Department == MaintenanceTeams.Biomedical ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">
                                    @item.Department
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(item.Assets?.Count ?? 0) @(isAr ? "أصل" : "asset(s)")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> @Loc["Edit"]
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('@(isAr ? "هل أنت متأكد من حذف هذه الفئة؟" : "Are you sure you want to delete this category?")')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
