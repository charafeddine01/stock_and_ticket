@model StockPortal.Models.AssetMaintenance
@{
    ViewData["Title"] = Loc["Log Maintenance Work Order"];
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-wrench text-warning me-2"></i> @Loc["Record Work Order"]</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Log" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-12">
                            <label asp-for="AssetId" class="form-label fw-semibold">@Loc["Target Hardware Asset"]</label>
                            <select asp-for="AssetId" class="form-select" asp-items="ViewBag.Assets" required>
                                <option value="">@(Loc.IsArabic ? "-- اختر الأصل / الجهاز --" : "-- Select Equipment --")</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaintenanceType" class="form-label fw-semibold">@Loc["Service Scope"]</label>
                            <select asp-for="MaintenanceType" class="form-select">
                                <option value="2">@(Loc.IsArabic ? "صيانة وقائية / فحص دوري" : "Preventive / Periodic Inspection")</option>
                                <option value="1">@(Loc.IsArabic ? "إصلاح عطل طارئ / علاجي" : "Breakdown / Corrective Repair")</option>
                            </select>
                            <div class="form-text small">@(Loc.IsArabic ? "تسجيل الفحص الوقائي يحدث تاريخ الفحص القادم تلقائياً." : "Logging a Preventive checkup automatically resets the asset's next periodic due date.")</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TicketId" class="form-label fw-semibold">@(Loc.IsArabic ? "تذكرة الدعم المرتبطة (اختياري)" : "Linked Helpdesk Ticket (Optional)")</label>
                            <select asp-for="TicketId" class="form-select" asp-items="ViewBag.Tickets">
                                <option value="">@(Loc.IsArabic ? "-- صيانة مستقلة (بدون تذكرة) --" : "-- Standalone Maintenance (No Ticket) --")</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserId" class="form-label fw-semibold">@Loc["Responsible Technician / Staff"]</label>
                            <select asp-for="UserId" class="form-select" asp-items="ViewBag.Technicians" required>
                                <option value="">@(Loc.IsArabic ? "-- اختر الفني المسؤول --" : "-- Select Technician --")</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SupplierId" class="form-label fw-semibold">@Loc["Third-Party Supplier / Vendor (Optional)"]</label>
                            <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers">
                                <option value="">@(Loc.IsArabic ? "-- فريق الصيانة الداخلي فقط --" : "-- Internal Staff Only --")</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">@Loc["Maintenance Action & Work Performed"]</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="@(Loc.IsArabic ? "اشرح الإجراءات المنفذة، نتائج الفحص، المعايرة، أو الاختبارات..." : "Describe actions performed, diagnostic results, recalibrations, or testing...")" required></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="PartsReplaced" class="form-label fw-semibold">@Loc["Parts Replaced / Materials (JSON or Text)"]</label>
                            <input asp-for="PartsReplaced" class="form-control font-monospace" placeholder='e.g. {"Part": "Battery Pack", "Cost": 120, "SN": "BT-9921"}' />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                        <button type="submit" class="btn btn-warning text-dark fw-semibold px-4">@Loc["Record Work Order"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
