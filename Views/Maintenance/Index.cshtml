@model StockPortal.ViewModels.MaintenanceScheduleViewModel
@{
    ViewData["Title"] = "Scheduled & Preventive Maintenance";
    var isArabic = Loc.IsArabic;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0">@Loc["Scheduled & Preventive Maintenance"]</h4>
        <small class="text-muted">@(isArabic ? "متابعة الأجهزة المرسلة للصيانة الخارجية، وتتبع حركة العهد، وجدولة الفحوصات الوقائية الدورية" : "Monitor equipment sent to suppliers, track custody transfers, and record recurring preventive inspections")</small>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportCsv")" class="btn btn-outline-success">
            <i class="fa-solid fa-file-csv me-1"></i> @Loc["Export CSV"]
        </a>
        <a href="@Url.Action("SendToSupplier")" class="btn btn-warning text-dark fw-bold">
            <i class="fa-solid fa-truck-ramp-box me-1"></i> @Loc["Send to Maintenance"]
        </a>
    </div>
</div>

<!-- Maintenance Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3" style="background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-bold">@(isArabic ? "لدى المورد (صيانة)" : "At Supplier (Maint.)")</div>
                    <div class="h3 fw-bold text-warning mb-0">@Model.ActiveWorkOrders.Count</div>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-truck-ramp-box"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3" style="background: linear-gradient(135deg, #fef2f2 0%, #ffffff 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-bold">@Loc["Overdue Inspections"]</div>
                    <div class="h3 fw-bold text-danger mb-0">@Model.OverdueAssets.Count</div>
                </div>
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="fa-solid fa-triangle-exclamation"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3" style="background: linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-bold">@Loc["Expiring in 30 Days"]</div>
                    <div class="h3 fw-bold text-warning-emphasis mb-0">@Model.DueWithin30DaysAssets.Count</div>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-clock"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3" style="background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-bold">@Loc["Scheduled Maintenance Up-to-date"]</div>
                    <div class="h3 fw-bold text-success mb-0">@Model.UpToDateAssets.Count</div>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="fa-solid fa-check-circle"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs for Schedules & Work Orders -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-0">
        <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="maintTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-bold text-warning-emphasis" id="active-wo-tab" data-bs-toggle="tab" data-bs-target="#active-wo" type="button" role="tab">
                    <i class="fa-solid fa-truck-ramp-box me-1 text-warning"></i> @Loc["Maintenance Work Orders"] (@Model.ActiveWorkOrders.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold text-danger" id="overdue-tab" data-bs-toggle="tab" data-bs-target="#overdue" type="button" role="tab">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @Loc["Overdue Inspections"] (@Model.OverdueAssets.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold text-warning" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button" role="tab">
                    <i class="fa-solid fa-clock me-1"></i> @Loc["Expiring in 30 Days"] (@Model.DueWithin30DaysAssets.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold text-success" id="uptodate-tab" data-bs-toggle="tab" data-bs-target="#uptodate" type="button" role="tab">
                    <i class="fa-solid fa-circle-check me-1"></i> @Loc["All Inspections Current"] (@Model.UpToDateAssets.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold text-dark" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs" type="button" role="tab">
                    <i class="fa-solid fa-file-lines me-1"></i> @Loc["Maintenance Logs"] (@Model.RecentLogs.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="maintTabsContent">
            <!-- 1. Active Supplier Work Orders Tab -->
            <div class="tab-pane fade show active" id="active-wo" role="tabpanel">
                @if (!Model.ActiveWorkOrders.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="fa-solid fa-circle-check fa-3x mb-3 text-success"></i>
                        <h5>@(isArabic ? "لا توجد أجهزة حالياً قيد الصيانة الخارجية" : "No Assets Currently at External Maintenance")</h5>
                        <p class="text-muted mb-3">@(isArabic ? "جميع المعدات موجودة حالياً داخل المستشفى وتحت العهدة." : "All equipment is currently on-site in hospital custody.")</p>
                        <a href="@Url.Action("SendToSupplier")" class="btn btn-warning text-dark fw-semibold">
                            <i class="fa-solid fa-truck-ramp-box me-1"></i> @Loc["Send to Maintenance"]
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Loc["Asset Tag / Hospital No"]</th>
                                    <th>@Loc["Supplier"]</th>
                                    <th>@Loc["Sent to Maintenance Date"]</th>
                                    <th>@Loc["Issue Category"]</th>
                                    <th>@Loc["Tickets & Helpdesk"]</th>
                                    <th class="text-end">@Loc["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var wo in Model.ActiveWorkOrders)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("WorkOrderDetails", new { id = wo.Id })" class="fw-bold font-monospace text-decoration-none">
                                                #WO-@wo.Id
                                            </a>
                                        </td>
                                        <td>
                                            @if (wo.Asset != null)
                                            {
                                                <a href="@Url.Action("Details", "Assets", new { id = wo.Asset.Id })" class="fw-bold text-decoration-none">
                                                    @wo.Asset.HospitalNo
                                                </a>
                                                <div class="small text-muted">@wo.Asset.Brand @wo.Asset.DisplayType</div>
                                                <span class="badge bg-primary" style="font-size: 0.68rem;">@Loc.TargetTeam(wo.Asset.MaintenanceTeam)</span>
                                            }
                                            else
                                            {
                                                <span>#@wo.AssetId</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold"><i class="fa-solid fa-building text-secondary me-1"></i> @(wo.Supplier?.DisplayName ?? Loc["Maintenance Provider"])</div>
                                        </td>
                                        <td>
                                            <div>@wo.SentDate?.ToString("MMM dd, yyyy")</div>
                                            <span class="badge bg-warning text-dark">@wo.DaysInMaintenance @(isArabic ? "يوم" : "days")</span>
                                        </td>
                                        <td class="small text-muted" style="max-width: 250px;">
                                            <div class="text-truncate">@wo.Description</div>
                                        </td>
                                        <td>
                                            @if (wo.TicketId.HasValue)
                                            {
                                                <a href="@Url.Action("Details", "Tickets", new { id = wo.TicketId.Value })" class="btn btn-sm btn-light border py-0">
                                                    #@wo.TicketId
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a href="@Url.Action("ReturnFromSupplier", new { workOrderId = wo.Id })" class="btn btn-sm btn-success">
                                                <i class="fa-solid fa-box-open me-1"></i> @Loc["Return from Maintenance"]
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 2. Overdue Inspections Tab -->
            <div class="tab-pane fade" id="overdue" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Asset Tag / Hospital No"]</th>
                                <th>@Loc["Target Maintenance Team"]</th>
                                <th>@Loc["Brand & Model"]</th>
                                <th>@Loc["Location / Room"]</th>
                                <th>@Loc["Interval (Days)"]</th>
                                <th>@Loc["Next Periodic Due"]</th>
                                <th class="text-end">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Model.OverdueAssets)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", "Assets", new { id = asset.Id })" class="fw-bold text-decoration-none">
                                            @asset.HospitalNo
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@Loc.TargetTeam(asset.MaintenanceTeam)</span>
                                    </td>
                                    <td>@asset.Brand (@asset.DisplayType)</td>
                                    <td>@(asset.Room?.DisplayName ?? Loc["Unassigned"])</td>
                                    <td>@asset.PeriodicInterval @(isArabic ? "يوم" : "Days")</td>
                                    <td><span class="badge bg-danger">@asset.NextPeriodic?.ToString("MMM dd, yyyy")</span></td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Log", new { assetId = asset.Id })" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-check me-1"></i> @Loc["Maintenance"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. Upcoming Inspections Tab -->
            <div class="tab-pane fade" id="upcoming" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Asset Tag / Hospital No"]</th>
                                <th>@Loc["Target Maintenance Team"]</th>
                                <th>@Loc["Brand & Model"]</th>
                                <th>@Loc["Location / Room"]</th>
                                <th>@Loc["Next Periodic Due"]</th>
                                <th class="text-end">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Model.DueWithin30DaysAssets)
                            {
                                <tr>
                                    <td>@asset.HospitalNo</td>
                                    <td><span class="badge bg-primary">@Loc.TargetTeam(asset.MaintenanceTeam)</span></td>
                                    <td>@asset.Brand (@asset.DisplayType)</td>
                                    <td>@(asset.Room?.DisplayName ?? Loc["Unassigned"])</td>
                                    <td><span class="badge bg-warning text-dark">@asset.NextPeriodic?.ToString("MMM dd, yyyy")</span></td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Log", new { assetId = asset.Id })" class="btn btn-sm btn-outline-primary">
                                            @Loc["Maintenance"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. Up to Date Tab -->
            <div class="tab-pane fade" id="uptodate" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Asset Tag / Hospital No"]</th>
                                <th>@Loc["Target Maintenance Team"]</th>
                                <th>@Loc["Brand & Model"]</th>
                                <th>@Loc["Last Periodic Check"]</th>
                                <th>@Loc["Next Periodic Due"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Model.UpToDateAssets)
                            {
                                <tr>
                                    <td>@asset.HospitalNo</td>
                                    <td><span class="badge bg-primary">@Loc.TargetTeam(asset.MaintenanceTeam)</span></td>
                                    <td>@asset.Brand (@asset.DisplayType)</td>
                                    <td>@asset.LastPeriodic?.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-success">@asset.NextPeriodic?.ToString("MMM dd, yyyy")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 5. Completed Logs Tab -->
            <div class="tab-pane fade" id="logs" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Loc["Date Opened"]</th>
                                <th>@Loc["Asset Tag / Hospital No"]</th>
                                <th>@Loc["Type"]</th>
                                <th>@Loc["Assigned Technician"]</th>
                                <th>@Loc["Work Summary / Actions Taken"]</th>
                                <th>@Loc["Cost"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.RecentLogs)
                            {
                                <tr>
                                    <td>@log.TimStamp?.ToString("MMM dd, yyyy")</td>
                                    <td>@log.Asset?.HospitalNo</td>
                                    <td><span class="badge bg-info text-dark">@log.DisplayTypeName</span></td>
                                    <td>@(log.Technician?.DisplayFullName ?? Loc["Maintenance Provider"])</td>
                                    <td>@log.Description</td>
                                    <td>@(log.Cost.HasValue ? log.Cost.Value.ToString("C2", System.Globalization.CultureInfo.CurrentUICulture) : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
