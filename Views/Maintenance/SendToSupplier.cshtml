@model StockPortal.Models.AssetMaintenance
@{
    ViewData["Title"] = Loc["Send Asset to Maintenance (Work Order)"];
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning bg-opacity-10 py-3 border-bottom border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="fa-solid fa-truck-ramp-box text-warning me-2"></i> @Loc["Send Asset to Maintenance (Work Order)"]
                        </h5>
                        <small class="text-muted">@(Loc.IsArabic ? "إرسال الأصل إلى مورد أو متعهد خارجي ونقل العهدة إليه مؤقتاً" : "Dispatch hardware to an external vendor / contractor and transfer custody to the supplier")</small>
                    </div>
                    <span class="badge bg-warning text-dark px-3 py-2">
                        <i class="fa-solid fa-shield-halved me-1"></i> @Loc["Phase 1: Dispatch"]
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-info border-0 shadow-sm d-flex gap-2 align-items-center mb-4">
                    <i class="fa-solid fa-circle-info fs-4 text-info"></i>
                    <div>
                        <strong>@(Loc.IsArabic ? "دورة عهدة الصيانة:" : "Maintenance Custody Lifecycle:")</strong>
                        @(Loc.IsArabic ? "إرسال الأصل إلى المورد يغير حالته التشغيلية إلى 'قيد الصيانة' وينقل العهدة إلى المورد. قم بوصف العطل الآن، وعند عودة الجهاز، ستسجل قطع الغيار المستبدلة بصيغة JSON وتعيد إسناد العهدة." : "Sending an asset to a supplier changes its operational status to Under Maintenance and transfers custody to the supplier. You will describe the issue now; after the asset returns from the supplier, you will record replaced parts in dynamic JSON format and reassign custody back to Central Stock or directly to a user.")
                    </div>
                </div>

                <form asp-action="SendToSupplier" method="post">
                    @Html.AntiForgeryToken()
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-0 shadow-sm mb-3">
                            <h6 class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> @(Loc.IsArabic ? "تعذر إرسال الجهاز:" : "Cannot Dispatch Equipment:")</h6>
                            <ul class="mb-0 ps-3">
                                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@modelError.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="row g-3">
                        <!-- 1. Equipment Selection -->
                        <div class="col-md-12">
                            <label class="form-label fw-bold">@Loc["Target Hardware Asset"] <span class="text-danger">*</span></label>
                            <select name="assetId" id="assetSelect" class="form-select form-select-lg" required onchange="filterSuppliersByAssetTeam()">
                                <option value="">@(Loc.IsArabic ? "-- اختر الأصل لإرساله إلى الصيانة --" : "-- Select Asset to Send to Maintenance --")</option>
                                @if (ViewBag.AssetsList != null)
                                {
                                    foreach (var a in (List<StockPortal.ViewModels.AssetDropdownItem>)ViewBag.AssetsList)
                                    {
                                        <option value="@a.Id" data-team="@a.MaintenanceTeam" selected="@(Model.AssetId == a.Id)">
                                            @a.Display
                                        </option>
                                    }
                                }
                                else if (ViewBag.Assets != null)
                                {
                                    foreach (var item in (SelectList)ViewBag.Assets)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                    }
                                }
                            </select>
                            <div class="form-text small">@(Loc.IsArabic ? "يتم عرض الأجهزة التابعة لقسم الصيانة المصرح لك به فقط." : "Only equipment in your authorized maintenance department is listed.")</div>
                        </div>

                        <!-- 2. Supplier & Maintenance Type -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@Loc["Approved Suppliers & Vendors"] <span class="text-danger">*</span></label>
                            <select name="supplierId" id="supplierSelect" class="form-select" required>
                                <option value="">@(Loc.IsArabic ? "-- اختر المورد / شركة الصيانة --" : "-- Select Maintenance Contractor / Vendor --")</option>
                                @if (ViewBag.AllSuppliers != null)
                                {
                                    foreach (var s in (List<StockPortal.Models.Supplier>)ViewBag.AllSuppliers)
                                    {
                                        string depts = string.IsNullOrWhiteSpace(s.Departments) ? "[]" : s.Departments;
                                        <option value="@s.Id" data-departments='@depts' selected="@(Model.SupplierId == s.Id)">
                                            @s.DisplayName (@s.DisplayTypeName)
                                        </option>
                                    }
                                }
                                else if (ViewBag.Suppliers != null)
                                {
                                    foreach (var item in (SelectList)ViewBag.Suppliers)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                    }
                                }
                            </select>
                            <div class="form-text small" id="supplierFilterNote">
                                <i class="fa-solid fa-filter me-1 text-primary"></i> @(Loc.IsArabic ? "سيتم عرض الموردين المعتمدين لخدمة هذا القسم فقط." : "Only authorized vendors that service this asset's department will be listed.")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">@Loc["Service Scope"]</label>
                            <select name="maintenanceType" class="form-select">
                                <option value="1" selected>@(Loc.IsArabic ? "إصلاح عطل طارئ / علاجي" : "Breakdown / Corrective Repair")</option>
                                <option value="3">@(Loc.IsArabic ? "صيانة تحت ضمان المورد" : "Supplier Warranty Service")</option>
                                <option value="2">@(Loc.IsArabic ? "عمرة دورية / معايرة شاملة" : "Scheduled Periodic Overhaul / Calibration")</option>
                                <option value="4">@(Loc.IsArabic ? "فحص سلامة وشهادة اعتماد خارجية" : "External Certification & Safety Check")</option>
                            </select>
                        </div>

                        <!-- 3. Sent Date & Responsible Technician -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">@Loc["Sent to Maintenance Date"] <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="sentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">@Loc["Assigned Technician"]</label>
                            <select name="technicianId" class="form-select" asp-items="ViewBag.Technicians">
                            </select>
                        </div>

                        <!-- 4. Linked Helpdesk Ticket -->
                        <div class="col-md-12">
                            <label class="form-label fw-bold">@(Loc.IsArabic ? "ربط بتذكرة دعم فني (اختياري)" : "Link to Helpdesk Ticket (Optional)")</label>
                            <select name="ticketId" class="form-select" asp-items="ViewBag.Tickets">
                                <option value="">@(Loc.IsArabic ? "-- بدون تذكرة مرتبطة (صيانة مستقلة) --" : "-- No Linked Ticket (Standalone Maintenance) --")</option>
                            </select>
                            <div class="form-text small">
                                <i class="fa-solid fa-link text-primary me-1"></i> @(Loc.IsArabic ? "ربط التذكرة سيحدث حالتها تلقائياً إلى 'قيد الصيانة' ويسجل حركة في محادثة التذكرة." : "Linking a ticket will automatically update its status to Under Maintenance and log a telemetry event in the ticket thread.")
                            </div>
                        </div>

                        <!-- 5. Issue Description -->
                        <div class="col-md-12">
                            <label class="form-label fw-bold">@Loc["Issue Description & Symptoms"] <span class="text-danger">*</span></label>
                            <textarea name="description" class="form-control" rows="4" placeholder="@(Loc.IsArabic ? "اشرح أعراض العطل، رموز الخطأ، الفحوصات الفاشلة، أو نطاق عمل المورد المطلوب..." : "Detail hardware fault symptoms, error codes, failed diagnostic tests, or vendor scope of work required...")" required></textarea>
                            <div class="form-text small">
                                @(Loc.IsArabic ? "وضح سبب إرسال الأصل. سيتم توثيق قطع الغيار المستبدلة والحل عند عودة الجهاز." : "State clearly why the item is being sent out. Replaced parts and work resolutions will be documented upon return.")
                            </div>
                        </div>
                    </div>

                    <div class="card bg-light border p-3 mt-4">
                        <div class="d-flex align-items-center gap-2 text-warning-emphasis fw-semibold">
                            <i class="fa-solid fa-arrow-right-arrow-left"></i>
                            <span>@(Loc.IsArabic ? "تأثير حركة العهدة:" : "Custody Impact:")</span>
                        </div>
                        <div class="small text-muted mt-1">
                            @(Loc.IsArabic ? "سيتم إغلاق عهدة المستخدم / المخزن الحالية، وفتح سجل عهدة نشط باسم المورد المختار." : "Current user/stock custody will be marked as returned, and an active custody record will be opened for the chosen Supplier.")
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-4 mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">@Loc["Cancel"]</a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                            <i class="fa-solid fa-paper-plane me-1"></i> @(Loc.IsArabic ? "إرسال الأصل ونقل العهدة للمورد" : "Dispatch & Transfer Custody to Supplier")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterSuppliersByAssetTeam() {
        var isAr = document.documentElement.dir === 'rtl' || document.documentElement.lang.startsWith('ar');
        var assetSelect = document.getElementById('assetSelect');
        var supplierSelect = document.getElementById('supplierSelect');
        var noteElement = document.getElementById('supplierFilterNote');
        if (!assetSelect || !supplierSelect) return;

        var selectedOption = assetSelect.options[assetSelect.selectedIndex];
        var team = selectedOption && selectedOption.value ? (selectedOption.getAttribute('data-team') || '').toUpperCase() : '';

        var options = supplierSelect.querySelectorAll('option');
        var visibleCount = 0;
        var currentValStillValid = false;

        options.forEach(function (opt) {
            if (!opt.value) {
                opt.style.display = '';
                return;
            }

            var deptsAttr = opt.getAttribute('data-departments') || '[]';
            var depts = [];
            try { depts = JSON.parse(deptsAttr); } catch (e) { depts = []; }
            var upperDepts = depts.map(function (d) { return (d || '').toUpperCase(); });

            var canHelp = false;
            if (!team) {
                canHelp = true;
            } else {
                canHelp = (upperDepts.length === 0 || 
                           upperDepts.indexOf(team) >= 0 || 
                           upperDepts.indexOf('ALL') >= 0 || 
                           upperDepts.indexOf('COMMON') >= 0);
            }

            if (canHelp) {
                opt.style.display = '';
                opt.disabled = false;
                visibleCount++;
                if (opt.value === supplierSelect.value) {
                    currentValStillValid = true;
                }
            } else {
                opt.style.display = 'none';
                opt.disabled = true;
            }
        });

        if (!currentValStillValid && supplierSelect.value) {
            supplierSelect.value = '';
        }

        if (noteElement) {
            if (team) {
                noteElement.innerHTML = `<i class="fa-solid fa-circle-check text-success me-1"></i> ${isAr ? `عرض <strong>${visibleCount}</strong> موردين مؤهلين لخدمة أجهزة <strong>${team}</strong>.` : `Showing <strong>${visibleCount}</strong> vendors qualified to service <strong>${team}</strong> equipment.`}`;
            } else {
                noteElement.innerHTML = `<i class="fa-solid fa-filter me-1 text-primary"></i> ${isAr ? 'اختر أصلاً أعلاه لتصفية الموردين المؤهلين لخدمة قسمه تلقائياً.' : 'Choose an asset above to automatically filter vendors that can help with its department.'}`;
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        filterSuppliersByAssetTeam();
    });
</script>
}
