@model StockPortal.ViewModels.AssetDetailsViewModel
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = $"{Loc["View Details"]}: {Model.Asset.HospitalNo ?? ("#" + Model.Asset.Id)}";
    var asset = Model.Asset;
    bool canManage = CurrentUser.CanManageAssets();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">@Loc["Stock & Assets"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(asset.HospitalNo ?? $"Asset #{asset.Id}")</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h3 class="fw-bold mb-0">@(asset.Brand) @(asset.DisplayType) &bull; <span class="text-primary font-monospace">@(asset.HospitalNo)</span></h3>
            <span class="badge @(asset.MaintenanceTeam == "BIOMEDICAL" ? "bg-info text-dark" : asset.MaintenanceTeam == "GENERAL" ? "bg-warning text-dark" : "bg-primary") fs-6">
                <i class="fa-solid fa-users-gear me-1"></i> @Loc.TargetTeam(asset.MaintenanceTeam)
            </span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("PrintTag", new { id = asset.Id })" class="btn btn-outline-dark" target="_blank">
            <i class="fa-solid fa-print me-1"></i> @Loc["Print Tag"]
        </a>
        <a href="@Url.Action("Create", "Tickets", new { assetId = asset.Id })" class="btn btn-warning text-dark">
            <i class="fa-solid fa-ticket me-1"></i> @Loc["Open Ticket"]
        </a>
        @if (canManage)
        {
            @if (string.Equals(asset.Status, "Under Maintenance", StringComparison.OrdinalIgnoreCase))
            {
                var activeWo = asset.MaintenanceRecords.FirstOrDefault(m => m.WorkOrderStatus == "Under Maintenance");
                if (activeWo != null)
                {
                    <a href="@Url.Action("ReturnFromSupplier", "Maintenance", new { id = activeWo.Id })" class="btn btn-success fw-bold">
                        <i class="fa-solid fa-box-open me-1"></i> @Loc["Return from Maintenance"]
                    </a>
                }
            }
            else
            {
                <a href="@Url.Action("SendToSupplier", "Maintenance", new { assetId = asset.Id })" class="btn btn-outline-warning text-dark fw-semibold">
                    <i class="fa-solid fa-truck-ramp-box me-1"></i> @Loc["Send to Vendor"]
                </a>
            }
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#transferModal">
                <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> @Loc["Transfer Custody"]
            </button>
            <a href="@Url.Action("Edit", new { id = asset.Id })" class="btn btn-secondary">
                <i class="fa-solid fa-pen me-1"></i> @Loc["Edit"]
            </a>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#retireModal">
                <i class="fa-solid fa-ban me-1"></i> @Loc["Retire"]
            </button>
            <a href="@Url.Action("Delete", new { id = asset.Id })" class="btn btn-outline-danger">
                <i class="fa-solid fa-trash-can me-1"></i> @Loc["Delete"]
            </a>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Main Asset Profile Card -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-circle-info text-primary me-2"></i> @Loc["Technical Specifications Form"]</h6>
                <span class="badge @(asset.Status == "In Service" ? "bg-success" : asset.Status == "Under Maintenance" ? "bg-warning text-dark" : "bg-info")">
                    @asset.DisplayStatus
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Asset Tag / Hospital No"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.HospitalNo ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Serial Number"]:</div>
                        <div class="fw-bold text-dark font-monospace fs-6">@(asset.SerialNo ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Brand / Manufacturer"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.Brand ?? "N/A")</div>
                    </div>

                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Equipment Type"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.DisplayType ?? Loc["Equipment Type"])</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Model / Version"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.ModelNo.HasValue ? asset.ModelNo.ToString() : (Loc.IsArabic ? "قياسي" : "Standard"))</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Approved Suppliers & Vendors"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.Supplier?.DisplayName ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Target Maintenance Team"]:</div>
                        <div class="fw-bold text-dark fs-6">
                            <span class="badge @(asset.MaintenanceTeam == "BIOMEDICAL" ? "bg-info text-dark" : asset.MaintenanceTeam == "GENERAL" ? "bg-warning text-dark" : "bg-primary")">
                                <i class="fa-solid fa-screwdriver-wrench me-1"></i> @Loc.TargetTeam(asset.MaintenanceTeam)
                            </span>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Purchase Price"]:</div>
                        <div class="fw-bold text-success fs-6">@(asset.Price.HasValue ? asset.Price.Value.ToString("C2") : "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Purchase Date"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.BuyingDate?.ToString("MMM dd, yyyy") ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Warranty Expiration"]:</div>
                        <div class="fw-bold text-dark fs-6">
                            @if (asset.WarrantyTill.HasValue)
                            {
                                if (asset.WarrantyTill.Value < DateTime.Now.Date)
                                {
                                    <span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> @(Loc.IsArabic ? "منتهي الصلاحية" : "Expired") (@asset.WarrantyTill.Value.ToString("MMM yyyy"))</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="fa-solid fa-shield-halved me-1"></i> @(Loc.IsArabic ? "ساري حتى" : "Active until") @asset.WarrantyTill.Value.ToString("MMM dd, yyyy")</span>
                                }
                            }
                            else
                            {
                                <span>@(Loc.IsArabic ? "لا يوجد ضمان مسجل" : "No warranty recorded")</span>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(asset.Specs))
                {
                    Dictionary<string, string>? specsMap = null;
                    try
                    {
                        specsMap = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(asset.Specs, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    }
                    catch { }

                    <div class="mt-4 pt-3 border-top">
                        <h6 class="fw-bold small text-muted text-uppercase mb-3"><i class="fa-solid fa-microchip text-primary me-2"></i> @Loc["Technical Specifications"]</h6>
                        @if (specsMap != null && specsMap.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle mb-0">
                                    <tbody>
                                        @foreach (var kvp in specsMap)
                                        {
                                            <tr>
                                                <th class="bg-light text-muted w-25 small fw-semibold">@kvp.Key</th>
                                                <td class="small fw-semibold text-dark">@kvp.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="bg-light p-3 rounded font-monospace small" style="white-space: pre-wrap;">@asset.Specs</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Current Location & Custodian Side Card -->
    <div class="col-lg-4">
        <!-- Custody Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-user-shield text-info me-2"></i> @(Loc.IsArabic ? "العهدة والموقع الحالي" : "Current Custody & Room")</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">@Loc["Assigned Custodian"]:</div>
                    @if (asset.User != null)
                    {
                        <div class="fw-bold text-dark fs-5">@asset.User.DisplayFullName</div>
                        <div class="text-muted small">@asset.User.DisplayRole &bull; @(asset.User.Department?.DisplayName ?? Loc["General Staff"])</div>
                        <div class="badge bg-primary bg-opacity-10 text-primary mt-1">@(asset.CustodyType?.DisplayType ?? Loc["Custody"])</div>
                    }
                    else
                    {
                        <div class="fw-bold text-secondary">@(Loc.IsArabic ? "في المخزن المركزي (غير مسند)" : "In Central IT Stock / Unassigned")</div>
                    }
                </div>

                <div class="mb-3">
                    <div class="text-muted small">@Loc["Location"]:</div>
                    @if (asset.Room != null)
                    {
                        <div class="fw-bold text-dark fs-5"><i class="fa-solid fa-location-dot text-danger me-1"></i> @asset.Room.DisplayName</div>
                    }
                    else
                    {
                        <div class="text-muted fst-italic">@Loc["Unassigned"]</div>
                    }
                </div>

                <button type="button" class="btn btn-outline-primary w-100 btn-sm" data-bs-toggle="modal" data-bs-target="#transferModal">
                    <i class="fa-solid fa-right-left me-1"></i> @Loc["Transfer Custody"]
                </button>
            </div>
        </div>

        <!-- Periodic Maintenance Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-calendar-check text-warning me-2"></i> @Loc["Scheduled & Preventive Maintenance"]</h6>
            </div>
            <div class="card-body">
                @if (asset.NeedsPeriodic == true)
                {
                    <div class="mb-2">
                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-check me-1"></i> @(Loc.IsArabic ? "فحوصات دورية مطلوبة" : "Scheduled Checkups Required")</span>
                    </div>
                    <div class="small text-muted mb-1">@Loc["Interval (Days)"]: <strong>@asset.PeriodicInterval @(Loc.IsArabic ? "يوم" : "Days")</strong></div>
                    <div class="small text-muted mb-1">@Loc["Last Periodic Check"]: <strong>@(asset.LastPeriodic?.ToString("MMM dd, yyyy") ?? (Loc.IsArabic ? "لم يفحص بعد" : "Never"))</strong></div>
                    <div class="small mb-3">
                        @Loc["Next Periodic Due"]: 
                        @if (asset.NextPeriodic.HasValue && asset.NextPeriodic.Value < DateTime.Now.Date)
                        {
                            <span class="badge bg-danger">@(Loc.IsArabic ? "متأخر" : "Overdue") (@asset.NextPeriodic.Value.ToString("MMM dd, yyyy"))</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@(asset.NextPeriodic?.ToString("MMM dd, yyyy") ?? (Loc.IsArabic ? "غير محدد" : "Not set"))</span>
                        }
                    </div>
                    <a href="@Url.Action("Log", "Maintenance", new { assetId = asset.Id })" class="btn btn-sm btn-outline-warning w-100">
                        <i class="fa-solid fa-wrench me-1"></i> @Loc["Record Work Order"]
                    </a>
                }
                else
                {
                    <div class="text-muted small">@(Loc.IsArabic ? "هذا الجهاز لا يتطلب صيانة دورية متكررة." : "This equipment does not require recurring preventive maintenance.")</div>
                }
            </div>
        </div>

        <!-- Periodic Calibration Card (Task 2) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-award text-success me-2"></i> @(Loc.IsArabic ? "المعايرة الدورية والقياس" : "Periodic Calibration & Metrology")</h6>
                @if (asset.NeedsCalibration == true)
                {
                    if (asset.IsCalibrationOverdue)
                    {
                        <span class="badge bg-danger">@(Loc.IsArabic ? "متأخرة" : "Overdue")</span>
                    }
                    else if (asset.IsCalibrationDueSoon)
                    {
                        <span class="badge bg-warning text-dark">@(Loc.IsArabic ? "تستحق قريباً" : "Due Soon")</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@(Loc.IsArabic ? "معتمدة وصالحة" : "Calibrated")</span>
                    }
                }
                else
                {
                    <span class="badge bg-secondary">@(Loc.IsArabic ? "غير مطلوبة" : "Not Required")</span>
                }
            </div>
            <div class="card-body">
                @if (asset.NeedsCalibration == true)
                {
                    <div class="small text-muted mb-1">@(Loc.IsArabic ? "فترة المعايرة (أيام)" : "Calibration Interval"): <strong>@(asset.CalibrationInterval ?? 180) @(Loc.IsArabic ? "يوم" : "Days")</strong></div>
                    <div class="small text-muted mb-1">@(Loc.IsArabic ? "آخر معايرة" : "Last Calibration"): <strong>@(asset.LastCalibration?.ToString("MMM dd, yyyy") ?? "Never")</strong></div>
                    <div class="small text-muted mb-1">
                        @(Loc.IsArabic ? "الاستحقاق القادم" : "Next Due Date"): 
                        @if (asset.NextCalibration.HasValue)
                        {
                            <strong class="@(asset.IsCalibrationOverdue ? "text-danger" : "text-dark")">@asset.NextCalibration.Value.ToString("MMM dd, yyyy")</strong>
                        }
                        else
                        {
                            <span class="text-muted">@(Loc.IsArabic ? "غير محدد" : "Not scheduled")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(asset.CalibrationCertNo))
                    {
                        <div class="small text-muted mb-1">@(Loc.IsArabic ? "رقم الشهادة" : "Cert #"): <strong class="font-monospace">@asset.CalibrationCertNo</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(asset.CalibratedBy))
                    {
                        <div class="small text-muted mb-2">@(Loc.IsArabic ? "الجهة المعتمدة" : "Calibrated By"): <strong>@asset.CalibratedBy</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(asset.CalibrationNotes))
                    {
                        <div class="p-2 bg-light rounded small text-muted mb-3 font-monospace" style="font-size: 0.75rem;">@asset.CalibrationNotes</div>
                    }
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success w-100" data-bs-toggle="modal" data-bs-target="#logCalibrationModal">
                            <i class="fa-solid fa-file-signature me-1"></i> @(Loc.IsArabic ? "تسجيل / تجديد شهادة المعايرة" : "Log / Renew Calibration")
                        </button>
                    }
                }
                else
                {
                    <div class="text-muted small mb-3">@(Loc.IsArabic ? "هذا الأصل/المنتج لا يتطلب معايرة دورية دورياً (أجهزة عامة)." : "This equipment does not require periodic calibration (Standard IT hardware).")</div>
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#logCalibrationModal">
                            <i class="fa-solid fa-plus me-1"></i> @(Loc.IsArabic ? "تفعيل المعايرة وتسجيل فحص" : "Enable Calibration Tracking")
                        </button>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Tabs Section: History, Maintenance, Tickets -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white p-0">
        <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="assetTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-semibold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">
                    <i class="fa-solid fa-timeline me-1"></i> @Loc["Custody Audit Trail"] (@asset.History.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="maintenance-tab" data-bs-toggle="tab" data-bs-target="#maintenance" type="button" role="tab">
                    <i class="fa-solid fa-wrench me-1"></i> @Loc["Maintenance Records"] (@asset.MaintenanceRecords.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets" type="button" role="tab">
                    <i class="fa-solid fa-ticket me-1"></i> @Loc["Service Tickets"] (@asset.Tickets.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="assetTabsContent">
            <!-- 1. Custody History Tab -->
            <div class="tab-pane fade show active" id="history" role="tabpanel">
                @if (!asset.History.Any())
                {
                    <div class="text-center text-muted py-4">@(Loc.IsArabic ? "لا توجد حركات عهدة سابقة مسجلة." : "No custody transitions recorded yet.")</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["Assigned Custodian"]</th>
                                    <th>@Loc["Location"]</th>
                                    <th>@Loc["Custody Type"]</th>
                                    <th>@(Loc.IsArabic ? "تاريخ الإسناد" : "Assigned Date")</th>
                                    <th>@(Loc.IsArabic ? "تاريخ الإرجاع" : "Returned Date")</th>
                                    <th>@(Loc.IsArabic ? "ملاحظات" : "Notes")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in asset.History.OrderByDescending(h => h.AssignedOn))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@(h.User?.DisplayFullName ?? Loc["None assigned"])</div>
                                        </td>
                                        <td>@(h.Room?.DisplayName ?? Loc["Unassigned"])</td>
                                        <td><span class="badge bg-light text-dark border">@(h.CustodyType?.DisplayType ?? Loc["Custody"])</span></td>
                                        <td>@h.AssignedOn.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            @if (h.ReturnedOn.HasValue)
                                            {
                                                <span>@h.ReturnedOn.Value.ToString("MMM dd, yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@(Loc.IsArabic ? "المسؤول الحالي" : "Current Custodian")</span>
                                            }
                                        </td>
                                        <td><small class="text-muted">@(h.Notes ?? "-")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 2. Maintenance Records Tab -->
            <div class="tab-pane fade" id="maintenance" role="tabpanel">
                @if (!asset.MaintenanceRecords.Any())
                {
                    <div class="text-center text-muted py-4">
                        <p>@(Loc.IsArabic ? "لا توجد سجلات صيانة لهذا الأصل حتى الآن." : "No maintenance logs for this asset yet.")</p>
                        <a href="@Url.Action("Log", "Maintenance", new { assetId = asset.Id })" class="btn btn-sm btn-outline-warning">
                            @Loc["Record Work Order"]
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["Date Opened"]</th>
                                    <th>@Loc["Type"]</th>
                                    <th>@Loc["Work Summary / Actions Taken"]</th>
                                    <th>@Loc["Replaced Parts & Components"]</th>
                                    <th>@Loc["Assigned Technician"]</th>
                                    <th>@Loc["Tickets & Helpdesk"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in asset.MaintenanceRecords.OrderByDescending(m => m.TimStamp))
                                {
                                    <tr>
                                        <td>@m.TimStamp?.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @(m.MaintenanceType == 2 ? "bg-info text-dark" : "bg-danger")">
                                                @Loc.MaintenanceType(m.MaintenanceType)
                                            </span>
                                        </td>
                                        <td>@m.Description</td>
                                        <td>
                                            @if (m.ParsedParts.Any())
                                            {
                                                @foreach (var part in m.ParsedParts)
                                                {
                                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                                        <i class="fa-solid fa-microchip text-primary me-1"></i> @part.PartName (x@part.Quantity)
                                                    </span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(m.PartsReplaced))
                                            {
                                                <code class="text-dark bg-light px-2 py-1 rounded small">@m.PartsReplaced</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@Loc["None assigned"]</span>
                                            }
                                        </td>
                                        <td>@(m.Technician?.DisplayFullName ?? m.Supplier?.DisplayName ?? (Loc.IsArabic ? "فريق المستشفى" : "Staff"))</td>
                                        <td>
                                            @if (m.TicketId.HasValue)
                                            {
                                                <a href="@Url.Action("Details", "Tickets", new { id = m.TicketId.Value })" class="btn btn-sm btn-light border py-0">
                                                    @Loc["Ticket"] #@m.TicketId
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 3. Linked Tickets Tab -->
            <div class="tab-pane fade" id="tickets" role="tabpanel">
                @if (!asset.Tickets.Any())
                {
                    <div class="text-center text-muted py-4">
                        <p>@(Loc.IsArabic ? "لا توجد تذاكر دعم فني مفتوحة لهذا الجهاز." : "No support tickets opened for this hardware.")</p>
                        <a href="@Url.Action("Create", "Tickets", new { assetId = asset.Id })" class="btn btn-sm btn-warning text-dark">
                            @Loc["Open Ticket"]
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Loc["Type"]</th>
                                    <th>@Loc["Priority Level"]</th>
                                    <th>@Loc["Status"]</th>
                                    <th>@Loc["Date Opened"]</th>
                                    <th>@Loc["Assigned Technician"]</th>
                                    <th>@Loc["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in asset.Tickets.OrderByDescending(t => t.OpenedDT))
                                {
                                    <tr>
                                        <td class="fw-bold">#@t.Id</td>
                                        <td><span class="badge bg-light text-dark border">@Loc.TicketType(t.Type)</span></td>
                                        <td>
                                            <span class="badge @(t.Priority >= 3 ? "bg-danger" : "bg-info text-dark")">@Loc.Priority(t.Priority)</span>
                                        </td>
                                        <td>
                                            <span class="badge @(t.StatusId == 5 ? "bg-success" : t.StatusId == 1 ? "bg-danger" : "bg-warning text-dark")">
                                                @(t.Status?.DisplayStatus ?? Loc.Status(t.Status?.Status))
                                            </span>
                                        </td>
                                        <td>@t.OpenedDT?.ToString("MMM dd, yyyy")</td>
                                        <td>@(t.Handler?.TechUser?.DisplayFullName ?? Loc["Unassigned"])</td>
                                        <td>
                                            <a href="@Url.Action("Details", "Tickets", new { id = t.Id })" class="btn btn-sm btn-outline-primary py-0">
                                                @Loc["View Details"]
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (canManage)
{
    <!-- Transfer Custody Modal -->
    <div class="modal fade" id="transferModal" tabindex="-1" aria-labelledby="transferModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="TransferCustody" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="transferModalLabel">@Loc["Transfer Custody"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-3">
                            @(Loc.IsArabic ? "إعادة تعيين العهدة تؤرشف العهدة السابقة تلقائياً وتنشئ حركة جديدة في سجل التدقيق." : "Reassigning this asset will automatically archive the previous custody record and log a new entry into asset_history.")
                        </p>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Assigned Staff / Custodian"]</label>
                            <select name="newUserId" class="form-select" required>
                                @foreach (var u in Model.AvailableUsers)
                                {
                                    <option value="@u.Id" selected="@(u.Id == asset.UserId)">@u.DisplayFullName (@(u.Department?.DisplayName ?? Loc["General Staff"]))</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Location / Room"]</label>
                            <select name="newRoomId" class="form-select" required>
                                @foreach (var r in Model.AvailableRooms)
                                {
                                    <option value="@r.Id" selected="@(r.Id == asset.RoomId)">@r.DisplayName</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Custody Type"]</label>
                            <select name="newCustodyTypeId" class="form-select" required>
                                @foreach (var c in Model.AvailableCustodyTypes)
                                {
                                    <option value="@c.Id" selected="@(c.Id == asset.CustodyTypeId)">@c.DisplayType</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "ملاحظات / سبب النقل" : "Transfer Notes / Reason")</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "مثال: تم النقل إلى قسم العناية المركزة في الطابق الثاني" : "e.g. Relocated to Floor 2 ICU for physician rotation")"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@Loc["Save Changes"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Retire Asset Modal -->
    <div class="modal fade" id="retireModal" tabindex="-1" aria-labelledby="retireModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Retire" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="retireModalLabel">@Loc["Decommission Asset"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">
                            @(Loc.IsArabic ? $"هل أنت متأكد من إسقاط / إتلاف الأصل {asset.HospitalNo ?? ("#" + asset.Id)} وخروجه من الخدمة نهائياً؟" : $"Are you sure you want to mark asset {asset.HospitalNo ?? ("#" + asset.Id)} as Retired / Scrapped?")
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "سبب الإسقاط / الإتلاف" : "Retirement Reason")</label>
                            <input type="text" name="reason" class="form-control" placeholder="@(Loc.IsArabic ? "مثال: جهاز قديم غير مجدٍ اقتصادياً، عطل غير قابل للإصلاح..." : "e.g. Obsolete hardware, irreparable board failure...")" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-warning">@Loc["Retire"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Log / Renew Calibration Modal (Task 2) -->
    <div class="modal fade" id="logCalibrationModal" tabindex="-1" aria-labelledby="logCalibrationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="LogCalibration" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="logCalibrationModalLabel">
                            <i class="fa-solid fa-award text-success me-2"></i>
                            @(Loc.IsArabic ? "تسجيل فحص ومعايرة الأصل" : "Log Periodic Calibration Verification")
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info py-2 px-3 small border-0 mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            @(Loc.IsArabic ? $"تسجيل شهادة المعايرة للأصل: {asset.Brand} {asset.DisplayType} ({asset.HospitalNo})" : $"Recording official calibration protocol for {asset.Brand} {asset.DisplayType} ({asset.HospitalNo})")
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ إجراء المعايرة" : "Calibration Date")</label>
                                <input type="date" name="calibrationDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">@(Loc.IsArabic ? "دورة المعايرة (بالأيام)" : "Interval (Days)")</label>
                                <input type="number" name="intervalDays" class="form-control" value="@(asset.CalibrationInterval ?? 180)" min="1" max="3650" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">@(Loc.IsArabic ? "رقم شهادة المعايرة / المحضر" : "Calibration Certificate / Protocol No")</label>
                            <input type="text" name="certNo" class="form-control font-monospace" placeholder="e.g. CAL-2026-MED-881" value="@asset.CalibrationCertNo" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">@(Loc.IsArabic ? "الجهة القائمة بالمعايرة / المختبر المعتمد" : "Calibrated By / Certified Body / Specialist")</label>
                            <input type="text" name="calibratedBy" class="form-control" placeholder="e.g. National Biomedical Metrology Lab or Philips Healthcare" value="@asset.CalibratedBy" required />
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-semibold">@(Loc.IsArabic ? "ملاحظات المعايرة والمعايير المستخدمة" : "Calibration Standards / Verification Notes")</label>
                            <textarea name="notes" class="form-control" rows="3" placeholder="@(Loc.IsArabic ? "مثال: تم ضبط مقاييس الطاقة وخرج الموجات، ونسب التفاوت مقبولة وفق معيار IEC 60601" : "e.g. Energy discharge verified within ±1% tolerance, IEC 60601 electrical safety compliant")">@asset.CalibrationNotes</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fa-solid fa-check me-1"></i>
                            @(Loc.IsArabic ? "حفظ وتجديد الصلاحية" : "Save & Verify Calibration")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
