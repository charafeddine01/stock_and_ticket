@model StockPortal.ViewModels.AssetDetailsViewModel
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = $"{Loc["View Details"]}: {Model.Asset.HospitalNo ?? ("#" + Model.Asset.Id)}";
    var asset = Model.Asset;
    bool canManage = CurrentUser.CanManageAssets();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="@Url.Action("Index")">@Loc["Stock & Assets"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(asset.HospitalNo ?? $"Asset #{asset.Id}")</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h3 class="fw-bold mb-0">@(asset.Brand) @(asset.DisplayType) &bull; <span class="text-primary font-monospace">@(asset.HospitalNo)</span></h3>
            <span class="badge @(asset.MaintenanceTeam == "BIOMEDICAL" ? "bg-info text-dark" : asset.MaintenanceTeam == "GENERAL" ? "bg-warning text-dark" : "bg-primary") fs-6">
                <i class="fa-solid fa-users-gear me-1"></i> @Loc.TargetTeam(asset.MaintenanceTeam)
            </span>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("PrintTag", new { id = asset.Id })" class="btn btn-outline-dark" target="_blank">
            <i class="fa-solid fa-print me-1"></i> @Loc["Print Tag"]
        </a>
        @if (asset.HasVendorMaintenance)
        {
            <a href="@Url.Action("VendorMaintenanceSticker", new { id = asset.Id })" class="btn btn-outline-info text-dark" target="_blank" title="@(Loc.IsArabic ? "طباعة ملصق الصيانة المجانية بعد البيع" : "Print Vendor Maintenance Sticker")">
                <i class="fa-solid fa-note-sticky text-info me-1"></i> @(Loc.IsArabic ? "ملصق صيانة المورد" : "Vendor Sticker")
            </a>
        }
        <a href="@Url.Action("Create", "Tickets", new { assetId = asset.Id })" class="btn btn-warning text-dark">
            <i class="fa-solid fa-ticket me-1"></i> @Loc["Open Ticket"]
        </a>
        @if (canManage)
        {
            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#logInternalMaintenanceModal">
                <i class="fa-solid fa-screwdriver-wrench me-1"></i> @(Loc.IsArabic ? "تسجيل صيانة داخلية" : "Log Internal Maintenance")
            </button>
            @if (string.Equals(asset.Status, "Under Maintenance", StringComparison.OrdinalIgnoreCase))
            {
                var activeWo = asset.MaintenanceRecords.FirstOrDefault(m => m.WorkOrderStatus == "Under Maintenance");
                if (activeWo != null)
                {
                    <a href="@Url.Action("ReturnFromSupplier", "Maintenance", new { id = activeWo.Id })" class="btn btn-success fw-bold">
                        <i class="fa-solid fa-box-open me-1"></i> @Loc["Return from Maintenance"]
                    </a>
                }
            }
            else
            {
                <a href="@Url.Action("SendToSupplier", "Maintenance", new { assetId = asset.Id })" class="btn btn-outline-warning text-dark fw-semibold">
                    <i class="fa-solid fa-truck-ramp-box me-1"></i> @Loc["Send to Vendor"]
                </a>
            }
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#transferModal">
                <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> @Loc["Transfer Custody"]
            </button>
            <a href="@Url.Action("Edit", new { id = asset.Id })" class="btn btn-secondary">
                <i class="fa-solid fa-pen me-1"></i> @Loc["Edit"]
            </a>
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#retireModal">
                <i class="fa-solid fa-ban me-1"></i> @Loc["Retire"]
            </button>
            <a href="@Url.Action("Delete", new { id = asset.Id })" class="btn btn-outline-danger">
                <i class="fa-solid fa-trash-can me-1"></i> @Loc["Delete"]
            </a>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Main Asset Profile Card -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-circle-info text-primary me-2"></i> @Loc["Technical Specifications Form"]</h6>
                <span class="badge @(asset.Status == "In Service" ? "bg-success" : asset.Status == "Under Maintenance" ? "bg-warning text-dark" : "bg-info")">
                    @asset.DisplayStatus
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Asset Tag / Hospital No"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.HospitalNo ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Serial Number"]:</div>
                        <div class="fw-bold text-dark font-monospace fs-6">@(asset.SerialNo ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Brand / Manufacturer"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.Brand ?? "N/A")</div>
                    </div>

                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Equipment Type"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.DisplayType ?? Loc["Equipment Type"])</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Model / Version"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.ModelNo.HasValue ? asset.ModelNo.ToString() : (Loc.IsArabic ? "قياسي" : "Standard"))</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Approved Suppliers & Vendors"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.Supplier?.DisplayName ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Target Maintenance Team"]:</div>
                        <div class="fw-bold text-dark fs-6">
                            <span class="badge @(asset.MaintenanceTeam == "BIOMEDICAL" ? "bg-info text-dark" : asset.MaintenanceTeam == "GENERAL" ? "bg-warning text-dark" : "bg-primary")">
                                <i class="fa-solid fa-screwdriver-wrench me-1"></i> @Loc.TargetTeam(asset.MaintenanceTeam)
                            </span>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="text-muted small">@(Loc.IsArabic ? "فئة الأصل" : "Asset Category"):</div>
                        <div class="fw-bold text-dark fs-6">
                            @if (asset.Category != null)
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border">@asset.Category.DisplayName</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Purchase Date"]:</div>
                        <div class="fw-bold text-dark fs-6">@(asset.BuyingDate?.ToString("MMM dd, yyyy") ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small">@Loc["Warranty Expiration"]:</div>
                        <div class="fw-bold text-dark fs-6">
                            @if (asset.WarrantyTill.HasValue)
                            {
                                if (asset.WarrantyTill.Value < DateTime.Now.Date)
                                {
                                    <span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> @(Loc.IsArabic ? "منتهي الصلاحية" : "Expired") (@asset.WarrantyTill.Value.ToString("MMM yyyy"))</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="fa-solid fa-shield-halved me-1"></i> @(Loc.IsArabic ? "ساري حتى" : "Active until") @asset.WarrantyTill.Value.ToString("MMM dd, yyyy")</span>
                                }
                            }
                            else
                            {
                                <span>@(Loc.IsArabic ? "لا يوجد ضمان مسجل" : "No warranty recorded")</span>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(asset.Specs))
                {
                    Dictionary<string, string>? specsMap = null;
                    try
                    {
                        specsMap = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(asset.Specs, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    }
                    catch { }

                    <div class="mt-4 pt-3 border-top">
                        <h6 class="fw-bold small text-muted text-uppercase mb-3"><i class="fa-solid fa-microchip text-primary me-2"></i> @Loc["Technical Specifications"]</h6>
                        @if (specsMap != null && specsMap.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle mb-0">
                                    <tbody>
                                        @foreach (var kvp in specsMap)
                                        {
                                            <tr>
                                                <th class="bg-light text-muted w-25 small fw-semibold">@kvp.Key</th>
                                                <td class="small fw-semibold text-dark">@kvp.Value</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="bg-light p-3 rounded font-monospace small" style="white-space: pre-wrap;">@asset.Specs</div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Installed Software Packages Card (Configured by Maintenance) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-cube text-primary me-2"></i> @(Loc.IsArabic ? "حزم البرامج المثبتة على محطة العمل" : "Installed Workstation Software Packages")</h6>
                @if (canManage)
                {
                    <a href="@Url.Action("Edit", new { id = asset.Id })" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-pen-to-square me-1"></i> @(Loc.IsArabic ? "تهيئة البرامج" : "Configure Softwares")
                    </a>
                }
            </div>
            <div class="card-body">
                @if (asset.InstalledSoftwaresList.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var sw in asset.InstalledSoftwaresList)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle p-2 fs-6 fw-normal d-flex align-items-center gap-1">
                                <i class="fa-solid fa-circle-check text-primary"></i>
                                <span>@sw</span>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted fst-italic py-2 small">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        @(Loc.IsArabic ? "لم يتم تسجيل أي برامج مثبتة على هذا الجهاز بعد. يمكن لفريق الصيانة إضافتها من صفحة التعديل." : "No installed softwares configured for this workstation yet. Maintenance can configure installed software via Edit.")
                    </div>
                }
            </div>
        </div>

        <!-- Compatible Spare Parts & Consumables Card (Task 2) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">
                    <i class="fa-solid fa-gears text-primary me-2"></i>
                    @(Loc.IsArabic ? "قطع الغيار والمستهلكات المتوافقة" : "Compatible Spare Parts & Consumables")
                    <span class="badge bg-secondary ms-1">@asset.CompatibleSpareParts.Count</span>
                </h6>
                <div class="d-flex gap-2">
                    @if (canManage)
                    {
                        <a href="@Url.Action("Edit", new { id = asset.Id })" class="btn btn-outline-secondary btn-sm" title="@(Loc.IsArabic ? "تعديل قطع الغيار المتوافقة" : "Manage Compatibility")">
                            <i class="fa-solid fa-link me-1"></i> @(Loc.IsArabic ? "إدارة التوافق" : "Link Parts")
                        </a>
                    }
                    <a href="@Url.Action("Index", "SpareParts")" class="btn btn-outline-primary btn-sm" target="_blank">
                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> @Loc["Spare Parts"]
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (!asset.CompatibleSpareParts.Any())
                {
                    <div class="text-muted fst-italic py-2 small">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        @(Loc.IsArabic ? "لم يتم ربط أي قطع غيار متوافقة مع هذا الجهاز بعد. يمكنك تحديدها من صفحة التعديل أو من صفحة قطع الغيار." : "No compatible spare parts linked to this asset yet. You can link compatible parts via Edit or from the Reserve Stock module.")
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@(Loc.IsArabic ? "اسم قطعة الغيار / المستهلك" : "Spare Part Name")</th>
                                    <th>@(Loc.IsArabic ? "رقم القطعة" : "Part #")</th>
                                    <th>@(Loc.IsArabic ? "الرصيد المتوفر" : "In Stock")</th>
                                    <th>@(Loc.IsArabic ? "موقع الرف" : "Shelf Location")</th>
                                    <th class="text-end">@Loc["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rel in asset.CompatibleSpareParts)
                                {
                                    var part = rel.SparePart;
                                    if (part != null)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">
                                                    @part.DisplayName
                                                    @if (part.CanFunctionAsAsset)
                                                    {
                                                        <span class="badge bg-warning text-dark border border-warning ms-1" style="font-size: 0.65rem;">
                                                            <i class="fa-solid fa-microchip me-1"></i>@(Loc.IsArabic ? "مزدوج" : "Dual")
                                                        </span>
                                                    }
                                                </div>
                                                <small class="text-muted">@part.DisplayCategory</small>
                                            </td>
                                            <td class="font-monospace small">@(part.PartNumber ?? "-")</td>
                                            <td>
                                                @if (part.Quantity > 0)
                                                {
                                                    <span class="badge @(part.IsLowStock ? "bg-warning text-dark" : "bg-success")">
                                                        @part.Quantity @part.Unit
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@(Loc.IsArabic ? "نفد المخزون" : "Out of Stock")</span>
                                                }
                                            </td>
                                            <td class="small text-muted">@(part.StorageLocation ?? "-")</td>
                                            <td class="text-end">
                                                <a href="@Url.Action("Index", "SpareParts", new { search = part.PartNumber ?? part.Name })" class="btn btn-sm btn-outline-secondary py-0" target="_blank" title="@Loc["View Details"]">
                                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Vendor Free After-Sale Maintenance Card (Task 5) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">
                    <i class="fa-solid fa-handshake-angle text-info me-2"></i>
                    @(Loc.IsArabic ? "صيانة المورد المجانية بعد البيع (عقد الضمان)" : "Free Vendor Maintenance (After-Sale Visits)")
                </h6>
                <div class="d-flex gap-2">
                    @if (asset.HasVendorMaintenance)
                    {
                        <a href="@Url.Action("VendorMaintenanceSticker", new { id = asset.Id })" class="btn btn-outline-primary btn-sm" target="_blank">
                            <i class="fa-solid fa-print me-1"></i> @(Loc.IsArabic ? "طباعة ملصق الصيانة" : "Print Sticker")
                        </a>
                        @if (canManage)
                        {
                            <button type="button" class="btn btn-info text-dark btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#recordVendorVisitModal">
                                <i class="fa-solid fa-calendar-check me-1"></i> @(Loc.IsArabic ? "تدوين زيارة مورد" : "Record Vendor Visit")
                            </button>
                        }
                    }
                </div>
            </div>
            <div class="card-body">
                @if (!asset.HasVendorMaintenance)
                {
                    <div class="text-muted small py-2 d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa-solid fa-circle-info me-1"></i>
                            @(Loc.IsArabic ? "لم يتم تفعيل صيانة المورد المجانية بعد البيع لهذا الأصل." : "Free vendor maintenance coverage is not enabled for this asset.")
                        </div>
                        @if (canManage)
                        {
                            <a href="@Url.Action("Edit", new { id = asset.Id })" class="btn btn-sm btn-outline-secondary">
                                <i class="fa-solid fa-toggle-on me-1"></i> @(Loc.IsArabic ? "تفعيل من التعديل" : "Enable via Edit")
                            </a>
                        }
                    </div>
                }
                else
                {
                    int totalTargetVisits = asset.VendorMaintenanceCount ?? 4;
                    int completedVisits = asset.VendorMaintenanceCompletedCount;
                    int progressPercent = totalTargetVisits > 0 ? (int)Math.Min(100, Math.Round((double)completedVisits / totalTargetVisits * 100)) : 0;

                    <div class="row g-3 mb-3">
                        <div class="col-sm-4">
                            <div class="text-muted small">@(Loc.IsArabic ? "فترة التغطية المجانية:" : "Coverage Period:")</div>
                            <div class="fw-bold text-dark small">
                                @(asset.VendorMaintenanceStartDate?.ToString("yyyy/MM/dd") ?? "Start") &rarr; @(asset.VendorMaintenanceEndDate?.ToString("yyyy/MM/dd") ?? "End")
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">@(Loc.IsArabic ? "المورد الملتزم بالصيانة:" : "Responsible Vendor:")</div>
                            <div class="fw-bold text-dark small">@(asset.Supplier?.DisplayName ?? (Loc.IsArabic ? "مورد خارجي" : "Vendor"))</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">@(Loc.IsArabic ? "الزيارات المنجزة:" : "Completed Visits:")</div>
                            <div class="fw-bold text-dark small">
                                <span class="badge @(completedVisits >= totalTargetVisits ? "bg-success" : "bg-primary")">
                                    @completedVisits / @totalTargetVisits @(Loc.IsArabic ? "زيارة" : "Visits")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>@(Loc.IsArabic ? "نسبة إنجاز زيارات الصيانة المجانية:" : "Maintenance Visits Progress:")</span>
                            <span><strong>@progressPercent%</strong></span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar @(completedVisits >= totalTargetVisits ? "bg-success" : "bg-info")" role="progressbar" style="width: @progressPercent%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    @if (asset.VendorVisitsList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">@(Loc.IsArabic ? "الزيارة" : "Visit #")</th>
                                        <th style="width: 25%;">@(Loc.IsArabic ? "تاريخ الزيارة" : "Date")</th>
                                        <th style="width: 30%;">@(Loc.IsArabic ? "مهندس الصيانة" : "Engineer Name")</th>
                                        <th style="width: 30%;">@(Loc.IsArabic ? "الملاحظات" : "Notes")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in asset.VendorVisitsList.OrderBy(v => v.VisitNumber))
                                    {
                                        <tr>
                                            <td class="text-center fw-bold">#@v.VisitNumber</td>
                                            <td class="font-monospace small">@v.VisitDate.ToString("yyyy-MM-dd")</td>
                                            <td><i class="fa-solid fa-user-gear text-primary me-1"></i> @v.EngineerName</td>
                                            <td><small class="text-muted">@(v.Notes ?? "-")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded text-center text-muted small">
                            <i class="fa-solid fa-clipboard-list me-1"></i>
                            @(Loc.IsArabic ? "لم يتم تدوين أي زيارة صيانة حتى الآن على التطبيق. انقر على 'تدوين زيارة مورد' لإثبات الزيارة، أو اطبع الملصق لتوقيعه ورقياً." : "No visits recorded in app yet. Click 'Record Vendor Visit' to log a completed visit or print the physical sticker.")
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Current Location & Custodian Side Card -->
    <div class="col-lg-4">
        <!-- Custody Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-user-shield text-info me-2"></i> @(Loc.IsArabic ? "العهدة والموقع الحالي" : "Current Custody & Room")</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">@Loc["Assigned Custodian"]:</div>
                    @if (asset.User != null)
                    {
                        <div class="fw-bold text-dark fs-5">@asset.User.DisplayFullName</div>
                        <div class="text-muted small">@asset.User.DisplayRole &bull; @(asset.User.Department?.DisplayName ?? Loc["General Staff"])</div>
                        <div class="badge bg-primary bg-opacity-10 text-primary mt-1">@(asset.CustodyType?.DisplayType ?? Loc["Custody"])</div>
                    }
                    else
                    {
                        <div class="fw-bold text-secondary">@(Loc.IsArabic ? "في المخزن المركزي (غير مسند)" : "In Central IT Stock / Unassigned")</div>
                    }
                </div>

                <div class="mb-3">
                    <div class="text-muted small">@Loc["Location"]:</div>
                    @if (asset.Room != null)
                    {
                        <div class="fw-bold text-dark fs-5"><i class="fa-solid fa-location-dot text-danger me-1"></i> @asset.Room.DisplayName</div>
                    }
                    else
                    {
                        <div class="text-muted fst-italic">@Loc["Unassigned"]</div>
                    }
                </div>

                <button type="button" class="btn btn-outline-primary w-100 btn-sm" data-bs-toggle="modal" data-bs-target="#transferModal">
                    <i class="fa-solid fa-right-left me-1"></i> @Loc["Transfer Custody"]
                </button>
            </div>
        </div>

        <!-- Periodic Maintenance Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-calendar-check text-warning me-2"></i> @Loc["Scheduled & Preventive Maintenance"]</h6>
            </div>
            <div class="card-body">
                @if (asset.NeedsPeriodic == true)
                {
                    <div class="mb-2">
                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-check me-1"></i> @(Loc.IsArabic ? "فحوصات دورية مطلوبة" : "Scheduled Checkups Required")</span>
                    </div>
                    <div class="small text-muted mb-1">@Loc["Interval (Days)"]: <strong>@asset.PeriodicInterval @(Loc.IsArabic ? "يوم" : "Days")</strong></div>
                    <div class="small text-muted mb-1">@Loc["Last Periodic Check"]: <strong>@(asset.LastPeriodic?.ToString("MMM dd, yyyy") ?? (Loc.IsArabic ? "لم يفحص بعد" : "Never"))</strong></div>
                    <div class="small mb-3">
                        @Loc["Next Periodic Due"]: 
                        @if (asset.NextPeriodic.HasValue && asset.NextPeriodic.Value < DateTime.Now.Date)
                        {
                            <span class="badge bg-danger">@(Loc.IsArabic ? "متأخر" : "Overdue") (@asset.NextPeriodic.Value.ToString("MMM dd, yyyy"))</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@(asset.NextPeriodic?.ToString("MMM dd, yyyy") ?? (Loc.IsArabic ? "غير محدد" : "Not set"))</span>
                        }
                    </div>
                    <a href="@Url.Action("Log", "Maintenance", new { assetId = asset.Id })" class="btn btn-sm btn-outline-warning w-100">
                        <i class="fa-solid fa-wrench me-1"></i> @Loc["Record Work Order"]
                    </a>
                }
                else
                {
                    <div class="text-muted small">@(Loc.IsArabic ? "هذا الجهاز لا يتطلب صيانة دورية متكررة." : "This equipment does not require recurring preventive maintenance.")</div>
                }
            </div>
        </div>

        <!-- Periodic Calibration Card (Task 2) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fa-solid fa-award text-success me-2"></i> @(Loc.IsArabic ? "المعايرة الدورية والقياس" : "Periodic Calibration & Metrology")</h6>
                @if (asset.NeedsCalibration == true)
                {
                    if (asset.IsCalibrationOverdue)
                    {
                        <span class="badge bg-danger">@(Loc.IsArabic ? "متأخرة" : "Overdue")</span>
                    }
                    else if (asset.IsCalibrationDueSoon)
                    {
                        <span class="badge bg-warning text-dark">@(Loc.IsArabic ? "تستحق قريباً" : "Due Soon")</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@(Loc.IsArabic ? "معتمدة وصالحة" : "Calibrated")</span>
                    }
                }
                else
                {
                    <span class="badge bg-secondary">@(Loc.IsArabic ? "غير مطلوبة" : "Not Required")</span>
                }
            </div>
            <div class="card-body">
                @if (asset.NeedsCalibration == true)
                {
                    <div class="small text-muted mb-1">@(Loc.IsArabic ? "فترة المعايرة (أيام)" : "Calibration Interval"): <strong>@(asset.CalibrationInterval ?? 180) @(Loc.IsArabic ? "يوم" : "Days")</strong></div>
                    <div class="small text-muted mb-1">@(Loc.IsArabic ? "آخر معايرة" : "Last Calibration"): <strong>@(asset.LastCalibration?.ToString("MMM dd, yyyy") ?? "Never")</strong></div>
                    <div class="small text-muted mb-1">
                        @(Loc.IsArabic ? "الاستحقاق القادم" : "Next Due Date"): 
                        @if (asset.NextCalibration.HasValue)
                        {
                            <strong class="@(asset.IsCalibrationOverdue ? "text-danger" : "text-dark")">@asset.NextCalibration.Value.ToString("MMM dd, yyyy")</strong>
                        }
                        else
                        {
                            <span class="text-muted">@(Loc.IsArabic ? "غير محدد" : "Not scheduled")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(asset.CalibrationCertNo))
                    {
                        <div class="small text-muted mb-1">@(Loc.IsArabic ? "رقم الشهادة" : "Cert #"): <strong class="font-monospace">@asset.CalibrationCertNo</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(asset.CalibratedBy))
                    {
                        <div class="small text-muted mb-2">@(Loc.IsArabic ? "الجهة المعتمدة" : "Calibrated By"): <strong>@asset.CalibratedBy</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(asset.CalibrationNotes))
                    {
                        <div class="p-2 bg-light rounded small text-muted mb-3 font-monospace" style="font-size: 0.75rem;">@asset.CalibrationNotes</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(asset.LastCalibrationData))
                    {
                        try
                        {
                            var calDoc = System.Text.Json.JsonDocument.Parse(asset.LastCalibrationData);
                            if (calDoc.RootElement.TryGetProperty("ProtocolName", out var pName))
                            {
                                <div class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 mb-2 d-block text-start p-2">
                                    <i class="fa-solid fa-certificate me-1"></i> @(Loc.IsArabic ? "البروتوكول المعتمد:" : "Protocol:") @pName.GetString()
                                </div>
                            }
                        }
                        catch { }
                    }
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-sm btn-outline-success w-100" data-bs-toggle="modal" data-bs-target="#logCalibrationModal">
                            <i class="fa-solid fa-file-signature me-1"></i> @(Loc.IsArabic ? "تسجيل / تجديد شهادة المعايرة" : "Log / Renew Calibration")
                        </button>
                    }
                }
                else
                {
                    <div class="text-muted small mb-3">@(Loc.IsArabic ? "هذا الأصل/المنتج لا يتطلب معايرة دورية دورياً (أجهزة عامة)." : "This equipment does not require periodic calibration (Standard IT hardware).")</div>
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#logCalibrationModal">
                            <i class="fa-solid fa-plus me-1"></i> @(Loc.IsArabic ? "تفعيل المعايرة وتسجيل فحص" : "Enable Calibration Tracking")
                        </button>
                    }
                }
            </div>
        </div>

        <!-- Checklists & Action Protocols Card (Task 8) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">
                    <i class="fa-solid fa-list-check text-success me-2"></i>
                    @(Loc.IsArabic ? "قوائم الفحص الدورية (Checklists)" : "Preventive Checklists")
                </h6>
                <a href="@Url.Action("Index", "Checklists")" class="btn btn-sm btn-link p-0 text-decoration-none" target="_blank" title="@(Loc.IsArabic ? "إدارة نماذج الفحص" : "Manage Checklists")">
                    <i class="fa-solid fa-gear"></i>
                </a>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small">@(Loc.IsArabic ? "آخر فحص دوري معتمد:" : "Last Checklist Completed:")</div>
                    @if (asset.LastChecklistDate.HasValue)
                    {
                        <div class="fw-bold text-dark small">
                            <i class="fa-solid fa-calendar-check text-success me-1"></i> @asset.LastChecklistDate.Value.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        <div class="small text-muted">
                            @(Loc.IsArabic ? "بواسطة:" : "By:") <strong>@(asset.LastChecklistBy ?? "Technician")</strong>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted fst-italic small">@(Loc.IsArabic ? "لم يجرَ توثيق فحص بعد" : "No checklist completed yet")</div>
                    }
                </div>

                @if (canManage)
                {
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#markChecklistModal">
                            <i class="fa-solid fa-check-double me-1"></i>
                            @(Loc.IsArabic ? "تأكيد إتمام قائمة الفحص" : "Mark Checklist Done")
                        </button>
                        <a href="@Url.Action("PrintChecklist", "Checklists", new { categoryId = asset.CategoryId, department = asset.MaintenanceTeam })" class="btn btn-sm btn-outline-secondary" target="_blank">
                            <i class="fa-solid fa-print me-1"></i>
                            @(Loc.IsArabic ? "طباعة نموذج الفحص الميداني" : "Print Action Checklist")
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tabs Section: History, Maintenance, Tickets -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white p-0">
        <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="assetTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-semibold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">
                    <i class="fa-solid fa-timeline me-1"></i> @Loc["Custody Audit Trail"] (@asset.History.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="maintenance-tab" data-bs-toggle="tab" data-bs-target="#maintenance" type="button" role="tab">
                    <i class="fa-solid fa-wrench me-1"></i> @Loc["Maintenance Records"] (@asset.MaintenanceRecords.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets" type="button" role="tab">
                    <i class="fa-solid fa-ticket me-1"></i> @Loc["Service Tickets"] (@asset.Tickets.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="assetTabsContent">
            <!-- 1. Custody History Tab -->
            <div class="tab-pane fade show active" id="history" role="tabpanel">
                @if (!asset.History.Any())
                {
                    <div class="text-center text-muted py-4">@(Loc.IsArabic ? "لا توجد حركات عهدة سابقة مسجلة." : "No custody transitions recorded yet.")</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["Assigned Custodian"]</th>
                                    <th>@Loc["Location"]</th>
                                    <th>@Loc["Custody Type"]</th>
                                    <th>@(Loc.IsArabic ? "تاريخ الإسناد" : "Assigned Date")</th>
                                    <th>@(Loc.IsArabic ? "تاريخ الإرجاع" : "Returned Date")</th>
                                    <th>@(Loc.IsArabic ? "ملاحظات" : "Notes")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in asset.History.OrderByDescending(h => h.AssignedOn))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@(h.User?.DisplayFullName ?? Loc["None assigned"])</div>
                                        </td>
                                        <td>@(h.Room?.DisplayName ?? Loc["Unassigned"])</td>
                                        <td><span class="badge bg-light text-dark border">@(h.CustodyType?.DisplayType ?? Loc["Custody"])</span></td>
                                        <td>@h.AssignedOn.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td>
                                            @if (h.ReturnedOn.HasValue)
                                            {
                                                <span>@h.ReturnedOn.Value.ToString("MMM dd, yyyy")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">@(Loc.IsArabic ? "المسؤول الحالي" : "Current Custodian")</span>
                                            }
                                        </td>
                                        <td><small class="text-muted">@(h.Notes ?? "-")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 2. Maintenance Records Tab -->
            <div class="tab-pane fade" id="maintenance" role="tabpanel">
                @if (!asset.MaintenanceRecords.Any())
                {
                    <div class="text-center text-muted py-4">
                        <p>@(Loc.IsArabic ? "لا توجد سجلات صيانة لهذا الأصل حتى الآن." : "No maintenance logs for this asset yet.")</p>
                        <a href="@Url.Action("Log", "Maintenance", new { assetId = asset.Id })" class="btn btn-sm btn-outline-warning">
                            @Loc["Record Work Order"]
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Loc["Date Opened"]</th>
                                    <th>@Loc["Type"]</th>
                                    <th>@Loc["Work Summary / Actions Taken"]</th>
                                    <th>@Loc["Replaced Parts & Components"]</th>
                                    <th>@Loc["Assigned Technician"]</th>
                                    <th>@Loc["Tickets & Helpdesk"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in asset.MaintenanceRecords.OrderByDescending(m => m.TimStamp))
                                {
                                    <tr>
                                        <td>@m.TimStamp?.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @(m.MaintenanceType == 2 ? "bg-info text-dark" : "bg-danger")">
                                                @Loc.MaintenanceType(m.MaintenanceType)
                                            </span>
                                        </td>
                                        <td>@m.Description</td>
                                        <td>
                                            @if (m.ParsedParts.Any())
                                            {
                                                @foreach (var part in m.ParsedParts)
                                                {
                                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                                        <i class="fa-solid fa-microchip text-primary me-1"></i> @part.PartName (x@part.Quantity)
                                                    </span>
                                                }
                                            }
                                            else if (!string.IsNullOrWhiteSpace(m.PartsReplaced))
                                            {
                                                <code class="text-dark bg-light px-2 py-1 rounded small">@m.PartsReplaced</code>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@Loc["None assigned"]</span>
                                            }
                                        </td>
                                        <td>@(m.Technician?.DisplayFullName ?? m.Supplier?.DisplayName ?? (Loc.IsArabic ? "فريق المستشفى" : "Staff"))</td>
                                        <td>
                                            @if (m.TicketId.HasValue)
                                            {
                                                <a href="@Url.Action("Details", "Tickets", new { id = m.TicketId.Value })" class="btn btn-sm btn-light border py-0">
                                                    @Loc["Ticket"] #@m.TicketId
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 3. Linked Tickets Tab -->
            <div class="tab-pane fade" id="tickets" role="tabpanel">
                @if (!asset.Tickets.Any())
                {
                    <div class="text-center text-muted py-4">
                        <p>@(Loc.IsArabic ? "لا توجد تذاكر دعم فني مفتوحة لهذا الجهاز." : "No support tickets opened for this hardware.")</p>
                        <a href="@Url.Action("Create", "Tickets", new { assetId = asset.Id })" class="btn btn-sm btn-warning text-dark">
                            @Loc["Open Ticket"]
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Loc["Type"]</th>
                                    <th>@Loc["Priority Level"]</th>
                                    <th>@Loc["Status"]</th>
                                    <th>@Loc["Date Opened"]</th>
                                    <th>@Loc["Assigned Technician"]</th>
                                    <th>@Loc["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in asset.Tickets.OrderByDescending(t => t.OpenedDT))
                                {
                                    <tr>
                                        <td class="fw-bold">#@t.Id</td>
                                        <td><span class="badge bg-light text-dark border">@Loc.TicketType(t.Type)</span></td>
                                        <td>
                                            <span class="badge @(t.Priority >= 3 ? "bg-danger" : "bg-info text-dark")">@Loc.Priority(t.Priority)</span>
                                        </td>
                                        <td>
                                            <span class="badge @(t.StatusId == 5 ? "bg-success" : t.StatusId == 1 ? "bg-danger" : "bg-warning text-dark")">
                                                @(t.Status?.DisplayStatus ?? Loc.Status(t.Status?.Status))
                                            </span>
                                        </td>
                                        <td>@t.OpenedDT?.ToString("MMM dd, yyyy")</td>
                                        <td>@(t.Handler?.TechUser?.DisplayFullName ?? Loc["Unassigned"])</td>
                                        <td>
                                            <a href="@Url.Action("Details", "Tickets", new { id = t.Id })" class="btn btn-sm btn-outline-primary py-0">
                                                @Loc["View Details"]
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (canManage)
{
    <!-- Transfer Custody Modal -->
    <div class="modal fade" id="transferModal" tabindex="-1" aria-labelledby="transferModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="TransferCustody" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="transferModalLabel">@Loc["Transfer Custody"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-3">
                            @(Loc.IsArabic ? "إعادة تعيين العهدة تؤرشف العهدة السابقة تلقائياً وتنشئ حركة جديدة في سجل التدقيق." : "Reassigning this asset will automatically archive the previous custody record and log a new entry into asset_history.")
                        </p>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Assigned Staff / Custodian"]</label>
                            <select name="newUserId" class="form-select" required>
                                @foreach (var u in Model.AvailableUsers)
                                {
                                    <option value="@u.Id" selected="@(u.Id == asset.UserId)">@u.DisplayFullName (@(u.Department?.DisplayName ?? Loc["General Staff"]))</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Location / Room"]</label>
                            <select name="newRoomId" class="form-select" required>
                                @foreach (var r in Model.AvailableRooms)
                                {
                                    <option value="@r.Id" selected="@(r.Id == asset.RoomId)">@r.DisplayName</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["Custody Type"]</label>
                            <select name="newCustodyTypeId" class="form-select" required>
                                @foreach (var c in Model.AvailableCustodyTypes)
                                {
                                    <option value="@c.Id" selected="@(c.Id == asset.CustodyTypeId)">@c.DisplayType</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "ملاحظات / سبب النقل" : "Transfer Notes / Reason")</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "مثال: تم النقل إلى قسم العناية المركزة في الطابق الثاني" : "e.g. Relocated to Floor 2 ICU for physician rotation")"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@Loc["Save Changes"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Retire Asset Modal -->
    <div class="modal fade" id="retireModal" tabindex="-1" aria-labelledby="retireModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Retire" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="retireModalLabel">@Loc["Decommission Asset"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">
                            @(Loc.IsArabic ? $"هل أنت متأكد من إسقاط / إتلاف الأصل {asset.HospitalNo ?? ("#" + asset.Id)} وخروجه من الخدمة نهائياً؟" : $"Are you sure you want to mark asset {asset.HospitalNo ?? ("#" + asset.Id)} as Retired / Scrapped?")
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "سبب الإسقاط / الإتلاف" : "Retirement Reason")</label>
                            <input type="text" name="reason" class="form-control" placeholder="@(Loc.IsArabic ? "مثال: جهاز قديم غير مجدٍ اقتصادياً، عطل غير قابل للإصلاح..." : "e.g. Obsolete hardware, irreparable board failure...")" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-warning">@Loc["Retire"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Log / Renew Calibration Modal (Task 7) -->
    <div class="modal fade" id="logCalibrationModal" tabindex="-1" aria-labelledby="logCalibrationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="LogCalibrationProtocol" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="logCalibrationModalLabel">
                            <i class="fa-solid fa-award text-success me-2"></i>
                            @(Loc.IsArabic ? "تسجيل محضر ومعايرة الأصل بالبروتوكول الفني" : "Log Periodic Calibration Protocol")
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info py-2 px-3 small border-0 mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            @(Loc.IsArabic ? $"محضر معايرة فني للأصل: {asset.Brand} {asset.DisplayType} ({asset.HospitalNo})" : $"Official technical calibration protocol for {asset.Brand} {asset.DisplayType} ({asset.HospitalNo})")
                        </div>

                        <!-- Predefined Protocol Template Selection (Task 7) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-file-invoice text-success me-1"></i>
                                @(Loc.IsArabic ? "اختيار بروتوكول المعايرة المعتمد للجهاز" : "Select Calibration Protocol Template") <span class="text-danger">*</span>
                            </label>
                            <select name="calibrationFormId" id="calProtocolSelector" class="form-select">
                                <option value="">@(Loc.IsArabic ? "-- معايرة قياسية عامة --" : "-- Standard General Calibration --")</option>
                                @foreach (var proto in Model.AvailableCalibrationProtocols)
                                {
                                    <option value="@proto.Id" data-schema="@proto.Form">@proto.Name (@proto.Department)</option>
                                }
                            </select>
                            <div class="form-text small">
                                @(Loc.IsArabic ? "يتم ملء وتوليد معايير المعايرة ونسب التفاوت كنموذج إلكتروني ويُحفظ كـ JSON." : "Select predefined protocol to fill dynamic metrology/tolerance parameters.")
                            </div>
                        </div>

                        <!-- Dynamic Calibration Protocol Fields Container -->
                        <div id="dynamicCalFieldsBox" class="p-3 bg-light rounded border mb-3" style="display: none;">
                            <h6 class="fw-bold small text-muted text-uppercase mb-2">
                                <i class="fa-solid fa-sliders text-primary me-1"></i>
                                @(Loc.IsArabic ? "القيم المقاسة ومعايير الدقة (معايير البروتوكول):" : "Measured Parameters & Calibration Criteria:")
                            </h6>
                            <div class="row g-2" id="dynamicCalFieldsRow"></div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ إجراء المعايرة" : "Calibration Date")</label>
                                <input type="date" name="calibrationDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small fw-semibold">@(Loc.IsArabic ? "دورة المعايرة (بالأيام)" : "Interval (Days)")</label>
                                <input type="number" name="intervalDays" class="form-control" value="@(asset.CalibrationInterval ?? 180)" min="1" max="3650" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">@(Loc.IsArabic ? "رقم شهادة المعايرة / المحضر" : "Calibration Certificate / Protocol No")</label>
                            <input type="text" name="certNo" class="form-control font-monospace" placeholder="e.g. CAL-2026-MED-881" value="@asset.CalibrationCertNo" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">@(Loc.IsArabic ? "الجهة القائمة بالمعايرة / المختبر المعتمد" : "Calibrated By / Certified Body / Specialist")</label>
                            <input type="text" name="calibratedBy" class="form-control" placeholder="e.g. National Biomedical Metrology Lab or Philips Healthcare" value="@asset.CalibratedBy" required />
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-semibold">@(Loc.IsArabic ? "ملاحظات وتوصيات المعايرة" : "Calibration Standards / Verification Notes")</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "مثال: تم ضبط مقاييس الطاقة وخرج الموجات، ونسب التفاوت مقبولة وفق معيار IEC 60601" : "e.g. Energy discharge verified within ±1% tolerance, IEC 60601 electrical safety compliant")">@asset.CalibrationNotes</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fa-solid fa-check me-1"></i>
                            @(Loc.IsArabic ? "حفظ وتوثيق المعايرة" : "Save & Verify Calibration")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Record Vendor Maintenance Visit Modal (Task 5) -->
    <div class="modal fade" id="recordVendorVisitModal" tabindex="-1" aria-labelledby="recordVendorVisitModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="RecordVendorMaintenanceVisit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="recordVendorVisitModalLabel">
                            <i class="fa-solid fa-calendar-check text-info me-2"></i>
                            @(Loc.IsArabic ? "تدوين زيارة صيانة مجانية للمورد" : "Record Vendor Maintenance Visit")
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            <i class="fa-solid fa-circle-info text-info me-1"></i>
                            @(Loc.IsArabic 
                                ? $"تدوين الزيارة رقم ({(asset.VendorMaintenanceCompletedCount + 1)}) من إجمالي ({asset.VendorMaintenanceCount ?? 4}) زيارة متفق عليها." 
                                : $"Recording Visit #{(asset.VendorMaintenanceCompletedCount + 1)} of {asset.VendorMaintenanceCount ?? 4} agreed free visits.")
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "تاريخ الزيارة الفعلية" : "Visit Date") <span class="text-danger">*</span></label>
                            <input type="date" name="visitDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "اسم مهندس صيانة المورد" : "Vendor Service Engineer Name") <span class="text-danger">*</span></label>
                            <input type="text" name="engineerName" class="form-control" placeholder="@(Loc.IsArabic ? "مثال: م. أحمد رضوان - شركة فيليبس" : "e.g. Eng. John Miller - GE Healthcare")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "الملاحظات والإجراءات المتخذة" : "Actions Taken / Field Notes")</label>
                            <textarea name="notes" class="form-control" rows="3" placeholder="@(Loc.IsArabic ? "مثال: تم إجراء الفحص الشامل وتنظيف الفلاتر والتأكد من استقرار عمل الجهاز." : "e.g. General preventive inspection, filter cleaning, and diagnostics performed.")"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-info text-dark fw-bold">
                            <i class="fa-solid fa-check me-1"></i> @(Loc.IsArabic ? "حفظ الزيارة في السجل" : "Record Visit")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Log Internal Maintenance Modal (Task 10) -->
    <div class="modal fade" id="logInternalMaintenanceModal" tabindex="-1" aria-labelledby="logInternalMaintenanceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="LogInternalMaintenance" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="logInternalMaintenanceModalLabel">
                            <i class="fa-solid fa-screwdriver-wrench text-primary me-2"></i>
                            @(Loc.IsArabic ? "تسجيل صيانة داخلية للأصل" : "Log Internal Maintenance Work Order")
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            <i class="fa-solid fa-circle-info text-primary me-1"></i>
                            @(Loc.IsArabic 
                                ? $"تسجيل عمل صيانة تم إنجازه داخلياً في المستشفى بواسطة فنيي القسم للأصل: {asset.Brand} {asset.DisplayType} ({asset.HospitalNo})." 
                                : $"Record internal maintenance work carried out in-house by hospital technical staff for {asset.Brand} {asset.DisplayType} ({asset.HospitalNo}).")
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">@(Loc.IsArabic ? "الفني القائم بالصيانة" : "Assigned Technician") <span class="text-danger">*</span></label>
                                <select name="technicianId" class="form-select" required>
                                    @foreach (var tech in Model.AvailableTechnicians)
                                    {
                                        <option value="@tech.Id" selected="@(tech.Id == CurrentUser.GetUserId())">@tech.DisplayFullName (@tech.MaintenanceTeam)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">@(Loc.IsArabic ? "ملخص العطل / المشكلة" : "Issue / Maintenance Summary") <span class="text-danger">*</span></label>
                                <input type="text" name="description" class="form-control" placeholder="@(Loc.IsArabic ? "مثال: عطل في مروحة التبريد، بطء في النظام، استبدال كابل..." : "e.g. Overheating fan noise, board inspection, cable replacement...")" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "الإجراءات المنفذة وحل المشكلة" : "Action Taken / Resolution Details")</label>
                            <textarea name="actionTaken" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "تفاصيل ما قام به الفني لإصلاح الجهاز..." : "Describe the internal maintenance steps taken...")"></textarea>
                        </div>

                        <!-- Spare Parts Used -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold d-flex justify-content-between">
                                <span><i class="fa-solid fa-microchip text-primary me-1"></i> @(Loc.IsArabic ? "قطع الغيار والمستهلكات المستخدمة من المخزون" : "Parts Used from Reserve Stock")</span>
                                <span class="text-muted small">@(Loc.IsArabic ? "سيتم خصمها من رصيد المستودع تلقائياً" : "Will deduct from stock automatically")</span>
                            </label>
                            @if (!Model.AvailableSpareParts.Any())
                            {
                                <div class="text-muted small fst-italic">@(Loc.IsArabic ? "لا توجد قطع غيار مسجلة لهذا القسم." : "No spare parts available for this department.")</div>
                            }
                            else
                            {
                                <div class="row g-2 p-2 bg-light rounded border" style="max-height: 160px; overflow-y: auto;">
                                    @foreach (var sp in Model.AvailableSpareParts)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check p-2 bg-white rounded border border-light">
                                                <input class="form-check-input ms-1" type="checkbox" name="usedSparePartIds" value="@sp.Id" id="int_sp_@sp.Id" />
                                                <label class="form-check-label small fw-semibold text-truncate d-block" for="int_sp_@sp.Id" title="@sp.DisplayName">
                                                    @sp.DisplayName
                                                    <span class="badge @(sp.Quantity > 0 ? "bg-success" : "bg-danger") ms-1">(@sp.Quantity @Loc["in stock"])</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-primary fw-bold">
                            <i class="fa-solid fa-floppy-disk me-1"></i> @(Loc.IsArabic ? "حفظ سجل الصيانة الداخلية" : "Save Maintenance Log")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Mark Checklist Done Modal (Task 8) -->
    <div class="modal fade" id="markChecklistModal" tabindex="-1" aria-labelledby="markChecklistModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="MarkChecklistDone" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="assetId" value="@asset.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="markChecklistModalLabel">
                            <i class="fa-solid fa-clipboard-check text-success me-2"></i>
                            @(Loc.IsArabic ? "تأكيد إنجاز قائمة الفحص الدوري" : "Sign Off Preventive Checklist")
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-light border small mb-3">
                            <i class="fa-solid fa-circle-info text-success me-1"></i>
                            @(Loc.IsArabic 
                                ? "يتم توثيق إنجاز الفحص الدوري للأصل مع تاريخ ووقت الإتمام واسم الفاحص وتحديث السجل." 
                                : "Documents completion of the preventive maintenance checklist with timestamp and inspector name.")
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "عنوان نموذج الفحص" : "Checklist Protocol") <span class="text-danger">*</span></label>
                            @if (Model.AvailableChecklists.Any())
                            {
                                <select name="checklistTitle" class="form-select" required>
                                    @foreach (var cl in Model.AvailableChecklists)
                                    {
                                        <option value="@cl.Title">@cl.Title (@cl.ChecklistType)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" name="checklistTitle" class="form-control" value="Periodic Preventive Maintenance Checklist" required />
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "اسم المهندس / الفاحص" : "Inspector / Technician Name")</label>
                            <input type="text" name="inspectorName" class="form-control" value="@CurrentUser.GetFullName()" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@(Loc.IsArabic ? "ملاحظات الفحص والنتائج" : "Inspection Notes / Results")</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="@(Loc.IsArabic ? "تم التحقق من كافة بنود الفحص الميداني، والجهاز بحالة تشغيلية ممتازة." : "All checklist items inspected and passed. Hardware in optimal working order.")"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                        <button type="submit" class="btn btn-success fw-bold">
                            <i class="fa-solid fa-check me-1"></i> @(Loc.IsArabic ? "اعتماد الفحص الآن" : "Mark as Completed")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const calSelector = document.getElementById("calProtocolSelector");
        const dynamicBox = document.getElementById("dynamicCalFieldsBox");
        const dynamicRow = document.getElementById("dynamicCalFieldsRow");

        if (calSelector && dynamicBox && dynamicRow) {
            function renderCalFields() {
                const opt = calSelector.options[calSelector.selectedIndex];
                const schemaJson = opt ? opt.getAttribute("data-schema") : null;
                if (!schemaJson || schemaJson === "[]") {
                    dynamicBox.style.display = "none";
                    dynamicRow.innerHTML = "";
                    return;
                }

                try {
                    const fields = JSON.parse(schemaJson);
                    if (!fields || !fields.length) {
                        dynamicBox.style.display = "none";
                        dynamicRow.innerHTML = "";
                        return;
                    }

                    dynamicRow.innerHTML = "";
                    fields.forEach(f => {
                        const col = document.createElement("div");
                        col.className = "col-md-6";
                        const lbl = document.createElement("label");
                        lbl.className = "form-label small fw-semibold text-dark";
                        lbl.textContent = f.label || f.name;
                        const inp = document.createElement("input");
                        inp.type = f.type === "number" ? "number" : "text";
                        inp.className = "form-control form-control-sm";
                        inp.name = `cal_${f.name}`;
                        inp.placeholder = f.placeholder || "";
                        if (f.required) inp.required = true;
                        col.appendChild(lbl);
                        col.appendChild(inp);
                        dynamicRow.appendChild(col);
                    });
                    dynamicBox.style.display = "block";
                } catch (e) {
                    dynamicBox.style.display = "none";
                }
            }

            calSelector.addEventListener("change", renderCalFields);
            renderCalFields();
        }
    });
</script>
}
