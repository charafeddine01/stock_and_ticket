@model StockPortal.Models.Asset
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = Loc["Register New Asset"];
    var availableForms = ViewBag.AvailableDeviceForms as List<StockPortal.Models.DeviceForm> ?? new();
    var selectedForm = ViewBag.SelectedDeviceForm as StockPortal.Models.DeviceForm;
}

<div class="row justify-content-center">
    <div class="col-xl-10 col-lg-11">
        <!-- Page Title & Quick Intro -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="form-section-icon icon-blue shadow-sm" style="width: 48px; height: 48px; font-size: 1.4rem;">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--container-title-color);">@Loc["Register Hospital Equipment Asset"]</h4>
                    <p class="text-muted small mb-0">@(Loc.IsArabic ? "إدخال أصل جديد وتوليد المواصفات الفنية وتحديد العهدة والضمان" : "Register new asset, generate technical specifications, assign custody and warranty")</p>
                </div>
            </div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left-long me-1"></i> @Loc["Back to Assets"]
            </a>
        </div>

        <form asp-action="Create" method="post" id="assetCreateForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Type" id="hiddenAssetType" value="@(selectedForm?.Name ?? Model?.Type)" />
            <input type="hidden" asp-for="MaintenanceTeam" id="hiddenMaintenanceTeam" value="@(selectedForm?.Department ?? Model?.MaintenanceTeam)" />

            <!-- 1. Universal Device Form Selector (Template selection) -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-header-content">
                        <div class="form-section-icon icon-purple">
                            <i class="fa-solid fa-shapes"></i>
                        </div>
                        <div>
                            <div class="form-section-title">@Loc["Select Universal Device Template"] <span class="text-danger">*</span></div>
                            <div class="form-section-subtitle">@(Loc.IsArabic ? "اختيار نموذج الجهاز يبني تلقائياً حقول المواصفات الفنية ويحدد قسم الصيانة المسؤول." : "Selecting a device template dynamically builds the technical specifications form and locks maintenance routing.")</div>
                        </div>
                    </div>
                    @if (CurrentUser.CanManageDeviceForms())
                    {
                        <a href="@Url.Action("Index", "DeviceForms")" class="btn btn-sm btn-outline-primary" target="_blank">
                            <i class="fa-solid fa-gear me-1"></i> @Loc["Manage Device Forms"]
                        </a>
                    }
                </div>
                <div class="form-section-body">
                    <select name="deviceFormId" id="deviceFormSelector" class="form-select form-select-lg fw-semibold" required>
                        <option value="">@Loc["Choose Equipment Type to Generate Specifications Form"]</option>
                        @foreach (var form in availableForms)
                        {
                            <option value="@form.Id" 
                                    data-name="@form.Name" 
                                    data-department="@form.Department" 
                                    data-schema="@form.Form"
                                    data-has-software="@(form.HasSoftware ? "true" : "false")"
                                    data-softwares="@form.InstallableSoftwares"
                                    selected="@(selectedForm?.Id == form.Id)">
                                @form.Name &bull; (@Loc.TargetTeam(form.Department))
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- 2. Dynamic Specification Form (Generated from Device Template) -->
            <div id="dynamicSpecsContainer" class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-header-content">
                        <div class="form-section-icon icon-blue">
                            <i class="fa-solid fa-microchip"></i>
                        </div>
                        <div>
                            <div class="form-section-title" id="specsHeaderTitle">@Loc["Technical Specifications Form"]</div>
                            <div class="form-section-subtitle">@(Loc.IsArabic ? "المواصفات الفنية المعتمدة لهذا النموذج" : "Certified engineering specifications for this equipment")</div>
                        </div>
                    </div>
                    <span class="badge bg-primary text-white" id="specsTeamBadge">
                        @(selectedForm != null ? $"{Loc.TargetTeam(selectedForm.Department)}" : Loc["Technical Specifications"])
                    </span>
                </div>
                <div class="form-section-body">
                    <div class="row g-3" id="dynamicFieldsRow">
                        <div class="col-12 text-center text-muted py-3" id="noTemplateAlert">
                            <i class="fa-solid fa-arrow-up text-primary me-1"></i> @(Loc.IsArabic ? "يرجى اختيار نموذج الجهاز أعلاه لتحميل حقول المواصفات." : "Please choose a device template above to load its specification fields.")
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2b. Installed Software Packages (Multi-check from Device Form) -->
            <div id="assetSoftwaresCard" class="form-section-card" style="display: none;">
                <div class="form-section-header">
                    <div class="form-section-header-content">
                        <div class="form-section-icon icon-green">
                            <i class="fa-solid fa-cube"></i>
                        </div>
                        <div>
                            <div class="form-section-title" id="assetSoftwaresHeader">@Loc["Installed Software Packages"]</div>
                            <div class="form-section-subtitle">@(Loc.IsArabic ? "حدد البرامج والأنظمة المثبتة فعلياً على هذا الأصل:" : "Check the softwares and packages installed on this asset:")</div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnSelectAllSw">
                            <i class="fa-solid fa-check-double me-1"></i> @(Loc.IsArabic ? "تحديد الكل" : "Select All")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearSw">
                            <i class="fa-solid fa-xmark me-1"></i> @(Loc.IsArabic ? "إلغاء التحديد" : "Clear All")
                        </button>
                    </div>
                </div>
                <div class="form-section-body">
                    <div class="row g-3" id="assetSoftwaresContainer">
                        <!-- Dynamically populated checkboxes -->
                    </div>
                </div>
            </div>

            <!-- 3. Hardware Asset Identification -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-header-content">
                        <div class="form-section-icon icon-amber">
                            <i class="fa-solid fa-barcode"></i>
                        </div>
                        <div>
                            <div class="form-section-title">@Loc["Identification & Serial Numbers"]</div>
                            <div class="form-section-subtitle">@(Loc.IsArabic ? "رقم الأصل، الرقم التسلسلي، الماركة والمورد" : "Asset Tag, Serial Number, Manufacturer Brand and Vendor")</div>
                        </div>
                    </div>
                </div>
                <div class="form-section-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="HospitalNo" class="form-label fw-semibold">@Loc["Hospital Asset Tag / Tag No"] <span class="text-danger">*</span></label>
                            <input asp-for="HospitalNo" class="form-control" placeholder="e.g. HOSP-LAP-025, HOSP-BIO-010" required />
                            <span asp-validation-for="HospitalNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SerialNo" class="form-label fw-semibold">@Loc["Serial Number"] <span class="text-danger">*</span></label>
                            <input asp-for="SerialNo" class="form-control font-monospace" placeholder="e.g. SN-882910-HP" required />
                            <span asp-validation-for="SerialNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                <i class="fa-solid fa-folder text-primary me-1"></i> @(Loc.IsArabic ? "فئة الأصل" : "Asset Category") <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                <option value="">@(Loc.IsArabic ? "-- اختر الفئة (طابعة، حاسوب، مستلزمات، إلخ) --" : "-- Select Asset Category --")</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Brand" class="form-label fw-semibold">@Loc["Brand / Manufacturer"] <span class="text-danger">*</span></label>
                            <input asp-for="Brand" class="form-control" placeholder="e.g. Dell, HP, Philips, GE, Carrier" required />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ModelNo" class="form-label fw-semibold">@Loc["Model / Version"]</label>
                            <input asp-for="ModelNo" class="form-control" placeholder="e.g. 850 or 750" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SupplierId" class="form-label fw-semibold">@Loc["Approved Suppliers & Vendors"]</label>
                            <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers">
                                <option value="">@(Loc.IsArabic ? "-- اختر المورد / الشركة --" : "-- Select Vendor / Supplier --")</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Location & Custody Placement -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-header-content">
                        <div class="form-section-icon icon-blue">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <div>
                            <div class="form-section-title">@Loc["Initial Custody & Placement"]</div>
                            <div class="form-section-subtitle">@(Loc.IsArabic ? "الغرفة السريرية، الموظف المسؤول، والحالة التشغيلية" : "Room location, custodian assignment, and operating status")</div>
                        </div>
                    </div>
                </div>
                <div class="form-section-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="UserId" class="form-label fw-semibold">@Loc["Assigned Staff / Custodian"]</label>
                            <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users">
                                <option value="">@(Loc.IsArabic ? "-- المخزن المركزي للقسم (بدون موظف) --" : "-- Central Department Stock (Unassigned) --")</option>
                            </select>
                            <div class="form-text small">@(Loc.IsArabic ? "الموظف المسؤول عن العهدة." : "Staff member responsible for custody.")</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RoomId" class="form-label fw-semibold">@Loc["Location / Room"] <span class="text-danger">*</span></label>
                            <select asp-for="RoomId" class="form-select" asp-items="ViewBag.Rooms" required>
                                <option value="">@(Loc.IsArabic ? "-- اختر موقع الغرفة --" : "-- Select Room Location --")</option>
                            </select>
                            <div class="form-text small">@(Loc.IsArabic ? "الغرفة أو القسم السريري." : "Room or clinical station.")</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CustodyTypeId" class="form-label fw-semibold">@Loc["Custody Type"]</label>
                            <select asp-for="CustodyTypeId" class="form-select" asp-items="ViewBag.CustodyTypes"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold">@Loc["Operational Status"]</label>
                            <select asp-for="Status" class="form-select">
                                <option value="In Service" selected>@Loc.Status("In Service")</option>
                                <option value="In Stock">@Loc.Status("In Stock")</option>
                                <option value="Under Maintenance">@Loc.Status("Under Maintenance")</option>
                                <option value="Retired">@Loc.Status("Retired")</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 5. Commercial, Warranty, Periodic Maintenance & Calibration -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-header-content">
                        <div class="form-section-icon icon-rose">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <div class="form-section-title">@Loc["Purchase, Warranty & Periodic Inspection"]</div>
                            <div class="form-section-subtitle">@(Loc.IsArabic ? "بيانات الشراء، الضمان، المعايرة الدورية وزيارات المورد" : "Commercial terms, warranty, periodic calibration, and vendor visits")</div>
                        </div>
                    </div>
                </div>
                <div class="form-section-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold">@Loc["Purchase Price"] ($)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BuyingDate" class="form-label fw-semibold">@Loc["Purchase Date"]</label>
                            <input asp-for="BuyingDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WarrantyTill" class="form-label fw-semibold">@Loc["Warranty Expiration"]</label>
                            <input asp-for="WarrantyTill" class="form-control" type="date" />
                        </div>

                        <div class="col-md-6">
                            <div class="form-check mt-3">
                                <input type="checkbox" name="NeedsPeriodic" value="true" class="form-check-input" id="chkNeedsPeriodic" @(Model?.NeedsPeriodic == true ? "checked" : "") />
                                <label class="form-check-label fw-semibold text-dark" for="chkNeedsPeriodic">
                                    @Loc["Requires Periodic Maintenance"]
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6" id="periodicIntervalContainer" style="display: none;">
                            <label asp-for="PeriodicInterval" class="form-label fw-semibold">@Loc["Interval (Days)"]</label>
                            <input asp-for="PeriodicInterval" class="form-control" type="number" placeholder="e.g. 90 or 180" />
                        </div>

                        <!-- Calibration Data -->
                        <div class="col-12 mt-3 pt-3 border-top">
                            <h6 class="fw-bold text-muted text-uppercase mb-2">
                                <i class="fa-solid fa-award text-success me-1"></i>
                                @(Loc.IsArabic ? "المعايرة الدورية والقياس الطبي (Periodic Calibration)" : "Periodic Calibration & Metrology")
                            </h6>
                            <div class="form-check form-switch mb-2">
                                <input type="checkbox" name="NeedsCalibration" value="true" class="form-check-input" id="chkNeedsCalibration" @(Model?.NeedsCalibration == true ? "checked" : "") />
                                <label class="form-check-label fw-semibold text-dark" for="chkNeedsCalibration">
                                    @(Loc.IsArabic ? "يتطلب هذا المنتج / الجهاز معايرة دورية دورياً (بعض الأجهزة تتطلب ذلك وأخرى لا تتطلب)" : "Product Requires Periodic Calibration (e.g. Medical / Precision Devices)")
                                </label>
                            </div>
                        </div>

                        <div id="calibrationContainer" class="col-12" style="display: none;">
                            <div class="row g-3 p-3 bg-light rounded border">
                                <div class="col-md-4">
                                    <label asp-for="CalibrationInterval" class="form-label small fw-semibold">@(Loc.IsArabic ? "فترة المعايرة (أيام)" : "Calibration Interval (Days)")</label>
                                    <input asp-for="CalibrationInterval" class="form-control form-control-sm" type="number" placeholder="e.g. 180 or 365" value="@(Model?.CalibrationInterval ?? 180)" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="LastCalibration" class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ آخر معايرة" : "Last Calibration Date")</label>
                                    <input asp-for="LastCalibration" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NextCalibration" class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ المعايرة القادمة" : "Next Calibration Due")</label>
                                    <input asp-for="NextCalibration" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CalibrationCertNo" class="form-label small fw-semibold">@(Loc.IsArabic ? "رقم الشهادة / المحضر" : "Calibration Certificate / Protocol No")</label>
                                    <input asp-for="CalibrationCertNo" class="form-control form-control-sm font-monospace" placeholder="e.g. CAL-2026-MED-881" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CalibratedBy" class="form-label small fw-semibold">@(Loc.IsArabic ? "الجهة المعتمدة للمعايرة" : "Calibrated By / Certified Lab")</label>
                                    <input asp-for="CalibratedBy" class="form-control form-control-sm" placeholder="e.g. National Metrology Authority" />
                                </div>
                                <div class="col-12">
                                    <label asp-for="CalibrationNotes" class="form-label small fw-semibold">@(Loc.IsArabic ? "ملاحظات ومعايير المعايرة" : "Calibration Standards & Tolerance Notes")</label>
                                    <textarea asp-for="CalibrationNotes" class="form-control form-control-sm" rows="2" placeholder="e.g. IEC 60601-2 compliance checked. Energy within ±1.5% margin."></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Vendor Free After-Sale Maintenance -->
                        <div class="col-12 mt-3 pt-3 border-top">
                            <h6 class="fw-bold text-muted text-uppercase mb-2">
                                <i class="fa-solid fa-handshake-angle text-info me-1"></i>
                                @(Loc.IsArabic ? "صيانة المورد المجانية بعد البيع (Vendor Free Maintenance)" : "Free Vendor Maintenance (After-Sale Visits)")
                            </h6>
                            <div class="form-check form-switch mb-2">
                                <input type="checkbox" name="HasVendorMaintenance" value="true" class="form-check-input" id="chkHasVendorMaintenance" @(Model?.HasVendorMaintenance == true ? "checked" : "") />
                                <label class="form-check-label fw-semibold text-dark" for="chkHasVendorMaintenance">
                                    @(Loc.IsArabic ? "يتضمن عقد التوريد زيارات صيانة دورية مجانية من المورد بعد البيع" : "Contract includes free scheduled after-sale maintenance visits by vendor")
                                </label>
                            </div>
                        </div>

                        <div id="vendorMaintenanceContainer" class="col-12" style="display: @(Model?.HasVendorMaintenance == true ? "block" : "none");">
                            <div class="row g-3 p-3 bg-light rounded border border-info border-opacity-25">
                                <div class="col-md-4">
                                    <label asp-for="VendorMaintenanceCount" class="form-label small fw-semibold">@(Loc.IsArabic ? "عدد الزيارات المجانية المتفق عليها" : "Number of Free Visits")</label>
                                    <input asp-for="VendorMaintenanceCount" class="form-control form-control-sm" type="number" min="1" max="50" placeholder="e.g. 4 or 6" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="VendorMaintenanceStartDate" class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ بداية التغطية" : "Coverage Start Date")</label>
                                    <input asp-for="VendorMaintenanceStartDate" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="VendorMaintenanceEndDate" class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ نهاية التغطية" : "Coverage End Date")</label>
                                    <input asp-for="VendorMaintenanceEndDate" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-12 text-muted small">
                                    <i class="fa-solid fa-circle-info text-info me-1"></i>
                                    @(Loc.IsArabic ? "يمكنك بعد الحفظ طباعة ملصق الصيانة المجانية ولصقه على الجهاز مع أسطر توقيع فارغة لمهندسي المورد." : "After saving, you can print a dedicated vendor maintenance sticker to stick on the asset with blank visit rows.")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. Compatible Spare Parts Selection -->
            <div class="form-section-card">
                <div class="form-section-header">
                    <div class="form-section-header-content">
                        <div class="form-section-icon icon-green">
                            <i class="fa-solid fa-gears"></i>
                        </div>
                        <div>
                            <div class="form-section-title">@(Loc.IsArabic ? "قطع الغيار والمستهلكات المتوافقة" : "Compatible Spare Parts & Consumables")</div>
                            <div class="form-section-subtitle">@(Loc.IsArabic ? "حدد قطع الغيار والمستهلكات المتوافقة مع هذا الأصل ليتم ربطها تبادلياً:" : "Select spare parts and consumables compatible with this asset (bidirectional linking):")</div>
                        </div>
                    </div>
                </div>
                <div class="form-section-body">
                    @{
                        var availableParts = ViewBag.AvailableSpareParts as List<StockPortal.Models.SparePart> ?? new();
                    }
                    @if (!availableParts.Any())
                    {
                        <div class="text-muted small fst-italic py-2">@(Loc.IsArabic ? "لا توجد قطع غيار مسجلة لهذا القسم حالياً." : "No spare parts registered for this department yet.")</div>
                    }
                    else
                    {
                        <div class="row g-2" style="max-height: 220px; overflow-y: auto;">
                            @foreach (var part in availableParts)
                            {
                                <div class="col-md-4 col-sm-6">
                                    <div class="form-check p-2 bg-light-subtle rounded border shadow-xs h-100">
                                        <input class="form-check-input ms-1" type="checkbox" name="compatibleSparePartIds" value="@part.Id" id="sp_part_@part.Id" />
                                        <label class="form-check-label small fw-semibold text-dark text-truncate d-block" for="sp_part_@part.Id" title="@part.DisplayName">
                                            @part.DisplayName
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1">(@part.Quantity @Loc["in stock"])</span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 7. Actions Controls Bar -->
            <div class="form-actions-card">
                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-3">
                        <i class="fa-solid fa-xmark me-1"></i> @Loc["Cancel"]
                    </a>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-paper-plane me-2"></i> @Loc["Register New Asset"]
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isAr = document.documentElement.dir === 'rtl' || document.documentElement.lang.startsWith('ar');
        const selector = document.getElementById("deviceFormSelector");
        const hiddenType = document.getElementById("hiddenAssetType");
        const hiddenTeam = document.getElementById("hiddenMaintenanceTeam");
        const dynamicRow = document.getElementById("dynamicFieldsRow");
        const headerTitle = document.getElementById("specsHeaderTitle");
        const teamBadge = document.getElementById("specsTeamBadge");
        const noAlert = document.getElementById("noTemplateAlert");

        const softwaresCard = document.getElementById("assetSoftwaresCard");
        const softwaresContainer = document.getElementById("assetSoftwaresContainer");
        const btnSelectAllSw = document.getElementById("btnSelectAllSw");
        const btnClearSw = document.getElementById("btnClearSw");

        let preSelectedSoftwares = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.InstalledSoftwaresList ?? new List<string>()));

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        function renderSoftwares() {
            if (!selector.value || !softwaresCard || !softwaresContainer) {
                if (softwaresCard) softwaresCard.style.display = "none";
                if (softwaresContainer) softwaresContainer.innerHTML = "";
                return;
            }

            const selectedOpt = selector.options[selector.selectedIndex];
            const hasSoftware = selectedOpt ? selectedOpt.getAttribute("data-has-software") === "true" : false;
            const softwaresRaw = selectedOpt ? selectedOpt.getAttribute("data-softwares") : "[]";

            let softwaresList = [];
            try {
                softwaresList = JSON.parse(softwaresRaw || "[]");
            } catch (e) {
                softwaresList = [];
            }

            if (!hasSoftware || softwaresList.length === 0) {
                softwaresCard.style.display = "none";
                softwaresContainer.innerHTML = "";
                return;
            }

            softwaresCard.style.display = "block";
            softwaresContainer.innerHTML = "";

            softwaresList.forEach((sw, idx) => {
                const col = document.createElement("div");
                col.className = "col-md-6 col-lg-4";
                const isChecked = Array.isArray(preSelectedSoftwares) && preSelectedSoftwares.includes(sw);
                col.innerHTML = `
                    <div class="card h-100 border p-2 bg-light bg-opacity-50">
                        <div class="form-check m-0 d-flex align-items-center gap-2">
                            <input class="form-check-input sw-checkbox mt-0" type="checkbox" name="selectedSoftwares" value="${escapeHtml(sw)}" id="sw_${idx}" ${isChecked ? 'checked' : ''} />
                            <label class="form-check-label small fw-semibold text-dark flex-grow-1 cursor-pointer" for="sw_${idx}">
                                <i class="fa-solid fa-cube text-primary opacity-75 me-1"></i> ${escapeHtml(sw)}
                            </label>
                        </div>
                    </div>
                `;
                softwaresContainer.appendChild(col);
            });
        }

        if (btnSelectAllSw) {
            btnSelectAllSw.addEventListener("click", function() {
                if (softwaresContainer) {
                    softwaresContainer.querySelectorAll(".sw-checkbox").forEach(cb => cb.checked = true);
                }
            });
        }

        if (btnClearSw) {
            btnClearSw.addEventListener("click", function() {
                if (softwaresContainer) {
                    softwaresContainer.querySelectorAll(".sw-checkbox").forEach(cb => cb.checked = false);
                }
            });
        }

        const chkPeriodic = document.getElementById("chkNeedsPeriodic");
        const intervalBox = document.getElementById("periodicIntervalContainer");

        if (chkPeriodic && intervalBox) {
            function toggleInterval() {
                intervalBox.style.display = chkPeriodic.checked ? "block" : "none";
            }
            chkPeriodic.addEventListener("change", toggleInterval);
            toggleInterval();
        }

        const chkCalib = document.getElementById("chkNeedsCalibration");
        const calibBox = document.getElementById("calibrationContainer");
        if (chkCalib && calibBox) {
            function toggleCalib() {
                calibBox.style.display = chkCalib.checked ? "block" : "none";
            }
            chkCalib.addEventListener("change", toggleCalib);
            toggleCalib();
        }

        const chkVM = document.getElementById("chkHasVendorMaintenance");
        const vmBox = document.getElementById("vendorMaintenanceContainer");
        if (chkVM && vmBox) {
            function toggleVM() {
                vmBox.style.display = chkVM.checked ? "block" : "none";
            }
            chkVM.addEventListener("change", toggleVM);
            toggleVM();
        }

        function renderDynamicFields() {
            if (!selector.value) {
                dynamicRow.innerHTML = `<div class="col-12 text-center text-muted py-3">
                    <i class="fa-solid fa-arrow-up text-primary me-1"></i> ${isAr ? 'يرجى اختيار نموذج الجهاز أعلاه لتحميل حقول المواصفات.' : 'Please choose a device template above to load its specification fields.'}
                </div>`;
                headerTitle.textContent = isAr ? "نموذج المواصفات الفنية" : "Technical Specifications Form";
                teamBadge.textContent = isAr ? "اختر الجهاز" : "Select Device";
                return;
            }

            const selectedOpt = selector.options[selector.selectedIndex];
            const name = selectedOpt.getAttribute("data-name");
            const dept = selectedOpt.getAttribute("data-department");
            const schemaRaw = selectedOpt.getAttribute("data-schema");

            hiddenType.value = name;
            hiddenTeam.value = dept;
            headerTitle.textContent = isAr ? `المواصفات الفنية لـ ${name}` : `${name} Technical Specifications`;
            teamBadge.textContent = `${dept}`;

            let fields = [];
            try {
                fields = JSON.parse(schemaRaw || "[]");
            } catch (e) {
                fields = [];
            }

            dynamicRow.innerHTML = "";

            if (fields.length === 0) {
                dynamicRow.innerHTML = `<div class="col-12 text-muted fst-italic">${isAr ? 'لا توجد حقول مخصصة محددة في هذا القالب.' : 'No custom fields defined in this template.'}</div>`;
                return;
            }

            fields.forEach(f => {
                const col = document.createElement("div");
                col.className = (f.type === "textarea") ? "col-12" : "col-md-6";

                const label = document.createElement("label");
                label.className = "form-label fw-semibold";
                label.innerHTML = `${f.label || f.name} ${f.required ? '<span class="text-danger">*</span>' : ''}`;
                col.appendChild(label);

                let inputEl;
                if (f.type === "select") {
                    inputEl = document.createElement("select");
                    inputEl.className = "form-select";
                    inputEl.name = `spec_${f.name}`;
                    if (f.required) inputEl.required = true;

                    const placeholderOpt = document.createElement("option");
                    placeholderOpt.value = "";
                    placeholderOpt.textContent = isAr ? `-- اختر ${f.label || f.name} --` : `-- Select ${f.label || f.name} --`;
                    inputEl.appendChild(placeholderOpt);

                    (f.options || []).forEach(optVal => {
                        const opt = document.createElement("option");
                        opt.value = optVal;
                        opt.textContent = optVal;
                        inputEl.appendChild(opt);
                    });
                } else if (f.type === "textarea") {
                    inputEl = document.createElement("textarea");
                    inputEl.className = "form-control";
                    inputEl.name = `spec_${f.name}`;
                    inputEl.rows = 2;
                    inputEl.placeholder = f.placeholder || "";
                    if (f.required) inputEl.required = true;
                } else {
                    inputEl = document.createElement("input");
                    inputEl.className = "form-control";
                    inputEl.type = (f.type === "number") ? "number" : "text";
                    inputEl.name = `spec_${f.name}`;
                    inputEl.placeholder = f.placeholder || "";
                    if (f.required) inputEl.required = true;
                }

                col.appendChild(inputEl);
                dynamicRow.appendChild(col);
            });
        }

        selector.addEventListener("change", function() {
            renderDynamicFields();
            renderSoftwares();
        });

        if (selector.value) {
            renderDynamicFields();
            renderSoftwares();
        }
    });
</script>
}
