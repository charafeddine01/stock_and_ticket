@model StockPortal.Models.Asset
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = Loc["Register New Asset"];
    var availableForms = ViewBag.AvailableDeviceForms as List<StockPortal.Models.DeviceForm> ?? new();
    var selectedForm = ViewBag.SelectedDeviceForm as StockPortal.Models.DeviceForm;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-box-open text-primary me-2"></i> @Loc["Register Hospital Equipment Asset"]</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="assetCreateForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- 1. Universal Device Form Selector (Forced selection) -->
                    <div class="card bg-light border-primary border-opacity-25 mb-4">
                        <div class="card-body p-3">
                            <label class="form-label fw-bold fs-6 text-dark d-flex justify-content-between align-items-center">
                                <span><i class="fa-solid fa-shapes text-primary me-2"></i> @Loc["Select Universal Device Template"] <span class="text-danger">*</span></span>
                                @if (CurrentUser.CanManageDeviceForms())
                                {
                                    <a href="@Url.Action("Index", "DeviceForms")" class="btn btn-sm btn-link text-decoration-none p-0" target="_blank">
                                        <i class="fa-solid fa-gear me-1"></i> @Loc["Manage Device Forms"]
                                    </a>
                                }
                            </label>
                            <select name="deviceFormId" id="deviceFormSelector" class="form-select form-select-lg fw-semibold border-primary" required>
                                <option value="">@Loc["Choose Equipment Type to Generate Specifications Form"]</option>
                                @foreach (var form in availableForms)
                                {
                                    <option value="@form.Id" 
                                            data-name="@form.Name" 
                                            data-department="@form.Department" 
                                            data-schema="@form.Form"
                                            selected="@(selectedForm?.Id == form.Id)">
                                        @form.Name &bull; (@Loc.TargetTeam(form.Department))
                                    </option>
                                }
                            </select>
                            <div class="form-text small mt-1">
                                <i class="fa-solid fa-circle-info text-primary me-1"></i>
                                @(Loc.IsArabic ? "اختيار نموذج الجهاز يبني تلقائياً حقول المواصفات الفنية ويحدد قسم الصيانة المسؤول." : "Selecting a device template dynamically builds the technical specifications form and locks maintenance routing.")
                            </div>
                        </div>
                    </div>

                    <input type="hidden" asp-for="Type" id="hiddenAssetType" value="@(selectedForm?.Name ?? Model?.Type)" />
                    <input type="hidden" asp-for="MaintenanceTeam" id="hiddenMaintenanceTeam" value="@(selectedForm?.Department ?? Model?.MaintenanceTeam)" />

                    <!-- 2. Dynamic Specification Form (Generated from Device Template) -->
                    <div id="dynamicSpecsContainer" class="card shadow-sm border mb-4">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0 text-dark">
                                <i class="fa-solid fa-microchip text-primary me-2"></i> 
                                <span id="specsHeaderTitle">@Loc["Technical Specifications Form"]</span>
                            </h6>
                            <span class="badge bg-primary text-white" id="specsTeamBadge">
                                @(selectedForm != null ? $"{Loc.TargetTeam(selectedForm.Department)}" : Loc["Technical Specifications"])
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3" id="dynamicFieldsRow">
                                <div class="col-12 text-center text-muted py-3" id="noTemplateAlert">
                                    <i class="fa-solid fa-arrow-up text-primary me-1"></i> @(Loc.IsArabic ? "يرجى اختيار نموذج الجهاز أعلاه لتحميل حقول المواصفات." : "Please choose a device template above to load its specification fields.")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Hardware Asset Identification -->
                    <h6 class="fw-bold text-muted text-uppercase mb-3 pb-2 border-bottom">@Loc["Identification & Serial Numbers"]</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="HospitalNo" class="form-label fw-semibold">@Loc["Hospital Asset Tag / Tag No"] <span class="text-danger">*</span></label>
                            <input asp-for="HospitalNo" class="form-control" placeholder="e.g. HOSP-LAP-025, HOSP-BIO-010" required />
                            <span asp-validation-for="HospitalNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SerialNo" class="form-label fw-semibold">@Loc["Serial Number"] <span class="text-danger">*</span></label>
                            <input asp-for="SerialNo" class="form-control font-monospace" placeholder="e.g. SN-882910-HP" required />
                            <span asp-validation-for="SerialNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Brand" class="form-label fw-semibold">@Loc["Brand / Manufacturer"] <span class="text-danger">*</span></label>
                            <input asp-for="Brand" class="form-control" placeholder="e.g. Dell, HP, Philips, GE, Carrier" required />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ModelNo" class="form-label fw-semibold">@Loc["Model / Version"]</label>
                            <input asp-for="ModelNo" class="form-control" placeholder="e.g. 850 or 750" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SupplierId" class="form-label fw-semibold">@Loc["Approved Suppliers & Vendors"]</label>
                            <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.Suppliers">
                                <option value="">@(Loc.IsArabic ? "-- اختر المورد / الشركة --" : "-- Select Vendor / Supplier --")</option>
                            </select>
                        </div>
                    </div>

                    <!-- 4. Location & Custody -->
                    <h6 class="fw-bold text-muted text-uppercase mb-3 pb-2 border-bottom">@Loc["Initial Custody & Placement"]</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="UserId" class="form-label fw-semibold">@Loc["Assigned Staff / Custodian"]</label>
                            <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users">
                                <option value="">@(Loc.IsArabic ? "-- المخزن المركزي للقسم (بدون موظف) --" : "-- Central Department Stock (Unassigned) --")</option>
                            </select>
                            <div class="form-text small">@(Loc.IsArabic ? "الموظف المسؤول عن العهدة." : "Staff member responsible for custody.")</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="RoomId" class="form-label fw-semibold">@Loc["Location / Room"] <span class="text-danger">*</span></label>
                            <select asp-for="RoomId" class="form-select" asp-items="ViewBag.Rooms" required>
                                <option value="">@(Loc.IsArabic ? "-- اختر موقع الغرفة --" : "-- Select Room Location --")</option>
                            </select>
                            <div class="form-text small">@(Loc.IsArabic ? "الغرفة أو القسم السريري." : "Room or clinical station.")</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CustodyTypeId" class="form-label fw-semibold">@Loc["Custody Type"]</label>
                            <select asp-for="CustodyTypeId" class="form-select" asp-items="ViewBag.CustodyTypes"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold">@Loc["Operational Status"]</label>
                            <select asp-for="Status" class="form-select">
                                <option value="In Service" selected>@Loc.Status("In Service")</option>
                                <option value="In Stock">@Loc.Status("In Stock")</option>
                                <option value="Under Maintenance">@Loc.Status("Under Maintenance")</option>
                                <option value="Retired">@Loc.Status("Retired")</option>
                            </select>
                        </div>
                    </div>

                    <!-- 5. Commercial, Warranty & Periodic Maintenance -->
                    <h6 class="fw-bold text-muted text-uppercase mb-3 pb-2 border-bottom">@Loc["Purchase, Warranty & Periodic Inspection"]</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold">@Loc["Purchase Price"] ($)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BuyingDate" class="form-label fw-semibold">@Loc["Purchase Date"]</label>
                            <input asp-for="BuyingDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WarrantyTill" class="form-label fw-semibold">@Loc["Warranty Expiration"]</label>
                            <input asp-for="WarrantyTill" class="form-control" type="date" />
                        </div>

                        <div class="col-md-6">
                            <div class="form-check mt-3">
                                <input type="checkbox" name="NeedsPeriodic" value="true" class="form-check-input" id="chkNeedsPeriodic" @(Model?.NeedsPeriodic == true ? "checked" : "") />
                                <label class="form-check-label fw-semibold text-dark" for="chkNeedsPeriodic">
                                    @Loc["Requires Periodic Maintenance"]
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6" id="periodicIntervalContainer" style="display: none;">
                            <label asp-for="PeriodicInterval" class="form-label fw-semibold">@Loc["Interval (Days)"]</label>
                            <input asp-for="PeriodicInterval" class="form-control" type="number" placeholder="e.g. 90 or 180" />
                        </div>

                        <!-- Calibration Data (Task 2) -->
                        <div class="col-12 mt-3 pt-3 border-top">
                            <h6 class="fw-bold text-muted text-uppercase mb-2">
                                <i class="fa-solid fa-award text-success me-1"></i>
                                @(Loc.IsArabic ? "المعايرة الدورية والقياس الطبي (Periodic Calibration)" : "Periodic Calibration & Metrology")
                            </h6>
                            <div class="form-check form-switch mb-2">
                                <input type="checkbox" name="NeedsCalibration" value="true" class="form-check-input" id="chkNeedsCalibration" @(Model?.NeedsCalibration == true ? "checked" : "") />
                                <label class="form-check-label fw-semibold text-dark" for="chkNeedsCalibration">
                                    @(Loc.IsArabic ? "يتطلب هذا المنتج / الجهاز معايرة دورية دورياً (بعض الأجهزة تتطلب ذلك وأخرى لا تتطلب)" : "Product Requires Periodic Calibration (e.g. Medical / Precision Devices)")
                                </label>
                            </div>
                        </div>

                        <div id="calibrationContainer" class="col-12" style="display: none;">
                            <div class="row g-3 p-3 bg-light rounded border">
                                <div class="col-md-4">
                                    <label asp-for="CalibrationInterval" class="form-label small fw-semibold">@(Loc.IsArabic ? "فترة المعايرة (أيام)" : "Calibration Interval (Days)")</label>
                                    <input asp-for="CalibrationInterval" class="form-control form-control-sm" type="number" placeholder="e.g. 180 or 365" value="@(Model?.CalibrationInterval ?? 180)" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="LastCalibration" class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ آخر معايرة" : "Last Calibration Date")</label>
                                    <input asp-for="LastCalibration" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="NextCalibration" class="form-label small fw-semibold">@(Loc.IsArabic ? "تاريخ المعايرة القادمة" : "Next Calibration Due")</label>
                                    <input asp-for="NextCalibration" class="form-control form-control-sm" type="date" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CalibrationCertNo" class="form-label small fw-semibold">@(Loc.IsArabic ? "رقم الشهادة / المحضر" : "Calibration Certificate / Protocol No")</label>
                                    <input asp-for="CalibrationCertNo" class="form-control form-control-sm font-monospace" placeholder="e.g. CAL-2026-MED-881" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CalibratedBy" class="form-label small fw-semibold">@(Loc.IsArabic ? "الجهة المعتمدة للمعايرة" : "Calibrated By / Certified Lab")</label>
                                    <input asp-for="CalibratedBy" class="form-control form-control-sm" placeholder="e.g. National Metrology Authority" />
                                </div>
                                <div class="col-12">
                                    <label asp-for="CalibrationNotes" class="form-label small fw-semibold">@(Loc.IsArabic ? "ملاحظات ومعايير المعايرة" : "Calibration Standards & Tolerance Notes")</label>
                                    <textarea asp-for="CalibrationNotes" class="form-control form-control-sm" rows="2" placeholder="e.g. IEC 60601-2 compliance checked. Energy within ±1.5% margin."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Loc["Cancel"]</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="fa-solid fa-paper-plane me-1"></i> @Loc["Register New Asset"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isAr = document.documentElement.dir === 'rtl' || document.documentElement.lang.startsWith('ar');
        const selector = document.getElementById("deviceFormSelector");
        const hiddenType = document.getElementById("hiddenAssetType");
        const hiddenTeam = document.getElementById("hiddenMaintenanceTeam");
        const dynamicRow = document.getElementById("dynamicFieldsRow");
        const headerTitle = document.getElementById("specsHeaderTitle");
        const teamBadge = document.getElementById("specsTeamBadge");
        const noAlert = document.getElementById("noTemplateAlert");

        const chkPeriodic = document.getElementById("chkNeedsPeriodic");
        const intervalBox = document.getElementById("periodicIntervalContainer");

        if (chkPeriodic && intervalBox) {
            function toggleInterval() {
                intervalBox.style.display = chkPeriodic.checked ? "block" : "none";
            }
            chkPeriodic.addEventListener("change", toggleInterval);
            toggleInterval();
        }

        const chkCalib = document.getElementById("chkNeedsCalibration");
        const calibBox = document.getElementById("calibrationContainer");
        if (chkCalib && calibBox) {
            function toggleCalib() {
                calibBox.style.display = chkCalib.checked ? "block" : "none";
            }
            chkCalib.addEventListener("change", toggleCalib);
            toggleCalib();
        }

        function renderDynamicFields() {
            if (!selector.value) {
                dynamicRow.innerHTML = `<div class="col-12 text-center text-muted py-3">
                    <i class="fa-solid fa-arrow-up text-primary me-1"></i> ${isAr ? 'يرجى اختيار نموذج الجهاز أعلاه لتحميل حقول المواصفات.' : 'Please choose a device template above to load its specification fields.'}
                </div>`;
                headerTitle.textContent = isAr ? "نموذج المواصفات الفنية" : "Technical Specifications Form";
                teamBadge.textContent = isAr ? "اختر الجهاز" : "Select Device";
                return;
            }

            const selectedOpt = selector.options[selector.selectedIndex];
            const name = selectedOpt.getAttribute("data-name");
            const dept = selectedOpt.getAttribute("data-department");
            const schemaRaw = selectedOpt.getAttribute("data-schema");

            hiddenType.value = name;
            hiddenTeam.value = dept;
            headerTitle.textContent = isAr ? `المواصفات الفنية لـ ${name}` : `${name} Technical Specifications`;
            teamBadge.textContent = `${dept}`;

            let fields = [];
            try {
                fields = JSON.parse(schemaRaw || "[]");
            } catch (e) {
                fields = [];
            }

            dynamicRow.innerHTML = "";

            if (fields.length === 0) {
                dynamicRow.innerHTML = `<div class="col-12 text-muted fst-italic">${isAr ? 'لا توجد حقول مخصصة محددة في هذا القالب.' : 'No custom fields defined in this template.'}</div>`;
                return;
            }

            fields.forEach(f => {
                const col = document.createElement("div");
                col.className = (f.type === "textarea") ? "col-12" : "col-md-6";

                const label = document.createElement("label");
                label.className = "form-label fw-semibold";
                label.innerHTML = `${f.label || f.name} ${f.required ? '<span class="text-danger">*</span>' : ''}`;
                col.appendChild(label);

                let inputEl;
                if (f.type === "select") {
                    inputEl = document.createElement("select");
                    inputEl.className = "form-select";
                    inputEl.name = `spec_${f.name}`;
                    if (f.required) inputEl.required = true;

                    const placeholderOpt = document.createElement("option");
                    placeholderOpt.value = "";
                    placeholderOpt.textContent = isAr ? `-- اختر ${f.label || f.name} --` : `-- Select ${f.label || f.name} --`;
                    inputEl.appendChild(placeholderOpt);

                    (f.options || []).forEach(optVal => {
                        const opt = document.createElement("option");
                        opt.value = optVal;
                        opt.textContent = optVal;
                        inputEl.appendChild(opt);
                    });
                } else if (f.type === "textarea") {
                    inputEl = document.createElement("textarea");
                    inputEl.className = "form-control";
                    inputEl.name = `spec_${f.name}`;
                    inputEl.rows = 2;
                    inputEl.placeholder = f.placeholder || "";
                    if (f.required) inputEl.required = true;
                } else {
                    inputEl = document.createElement("input");
                    inputEl.className = "form-control";
                    inputEl.type = (f.type === "number") ? "number" : "text";
                    inputEl.name = `spec_${f.name}`;
                    inputEl.placeholder = f.placeholder || "";
                    if (f.required) inputEl.required = true;
                }

                col.appendChild(inputEl);
                dynamicRow.appendChild(col);
            });
        }

        selector.addEventListener("change", renderDynamicFields);

        if (selector.value) {
            renderDynamicFields();
        }
    });
</script>
}
