@model IEnumerable<StockPortal.Models.Asset>
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    Layout = null;
    bool canEditParams = CurrentUser.IsAdmin() || CurrentUser.CanEditAssetTags();
    var currentDept = (ViewBag.Department as string ?? CurrentUser.GetMaintenanceTeam() ?? Model.FirstOrDefault()?.MaintenanceTeam ?? "IT").Trim().ToUpperInvariant();
    var deptDisplayName = Loc.TargetTeam(currentDept);

    string defaultTopLine1, defaultTopLine2, defaultBottomText, defaultBottomSub;
    if (currentDept == "BIOMEDICAL")
    {
        defaultTopLine1 = Loc.IsArabic ? "مستشفى الزهراء الجامعي - الهندسة الطبية" : "AL-ZAHRAA HOSPITAL - BIOMEDICAL DEPT";
        defaultTopLine2 = Loc.IsArabic ? "بطاقة تعريف العهدة والأصل الطبي" : "BIOMEDICAL ASSET & MEDICAL DEVICE TAG";
        defaultBottomText = Loc.IsArabic ? "جهاز طبي خاضع للمعايير السريرية • يمنع نزع الملصق" : "CLINICAL EQUIPMENT • BIOMEDICAL ENGINEERING PROPERTY";
        defaultBottomSub = Loc.IsArabic ? "الهندسة الطبية والسريرية • تحويلة: 2000 / 2001" : "Biomedical Engineering • Ext: 2000 / 2001";
    }
    else if (currentDept == "GENERAL")
    {
        defaultTopLine1 = Loc.IsArabic ? "مستشفى الزهراء الجامعي - الصيانة العامة والمرافق" : "AL-ZAHRAA HOSPITAL - FACILITIES & GENERAL MAINTENANCE";
        defaultTopLine2 = Loc.IsArabic ? "بطاقة تعريف المعدات ومرافق المنشأة" : "FACILITY & GENERAL MAINTENANCE TAG";
        defaultBottomText = Loc.IsArabic ? "أصل مرفقي عام • يمنع نزع أو تشويه الملصق" : "FACILITY EQUIPMENT • GENERAL MAINTENANCE PROPERTY";
        defaultBottomSub = Loc.IsArabic ? "قسم الصيانة العامة والتشغيل • تحويلة: 3000 / 3001" : "Facilities & Operations • Ext: 3000 / 3001";
    }
    else
    {
        defaultTopLine1 = Loc.IsArabic ? "مستشفى الزهراء الجامعي - تقنية المعلومات" : "AL-ZAHRAA HOSPITAL - INFORMATION TECHNOLOGY";
        defaultTopLine2 = Loc.IsArabic ? "بطاقة تعريف محطة عمل وشبكات (IT Tag)" : "IT ASSET & WORKSTATION TAG";
        defaultBottomText = Loc.IsArabic ? "ملكية رسمية لقسم تقنية المعلومات • يمنع نزع الملصق" : "DO NOT REMOVE OR DEFACE • IT INFRASTRUCTURE ASSET";
        defaultBottomSub = Loc.IsArabic ? "دعم تقنية المعلومات • تحويلة: 1000 / 1001" : "IT Helpdesk & Systems • Ext: 1000 / 1001";
    }
}
<!DOCTYPE html>
<html lang="@Loc.CurrentCulture" dir="@Loc.Direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Loc.IsArabic ? "طباعة مجمعة لملصقات الأصول" : "Bulk Asset Tag Label Printing")</title>
    
    <!-- Google Fonts Local -->
    <link rel="stylesheet" href="~/lib/fonts/cairo-inter.css" asp-append-version="true" />

    @if (Loc.IsArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { 
                background: white !important; 
                padding: 0 !important; 
                margin: 0 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .bulk-grid { 
                display: grid !important;
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 12px !important;
                padding: 10px !important;
                max-width: 100% !important;
            }
            .tag-card { 
                border: 2px solid #000 !important; 
                box-shadow: none !important; 
                page-break-inside: avoid !important;
                break-inside: avoid !important;
                margin: 0 auto;
                width: 100% !important;
                max-width: 100% !important;
            }
        }

        body {
            background-color: #f1f5f9;
            font-family: @(Loc.IsArabic ? "'Cairo', " : "") 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 1.5rem 1rem 3rem 1rem;
            color: #0f172a;
        }

        .customizer-panel {
            max-width: 960px;
            margin: 0 auto 1.5rem auto;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
            overflow: hidden;
        }

        .customizer-header {
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 20px;
        }

        .customizer-body {
            padding: 18px 20px;
        }

        .bulk-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .tag-card {
            background: #ffffff;
            border: 2px solid #0f172a;
            border-radius: 10px;
            padding: 14px 16px;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
            page-break-inside: avoid;
            transition: all 0.2s ease-in-out;
        }

        .tag-top-facility {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.8px;
            color: #475569;
            text-transform: uppercase;
        }

        .tag-top-title {
            font-size: 13px;
            font-weight: 800;
            color: #0f172a;
            line-height: 1.2;
        }

        .tag-badge-pill {
            font-size: 11px;
            font-weight: 700;
            background: #0f172a;
            color: #ffffff;
            padding: 2px 7px;
            border-radius: 4px;
            display: inline-block;
            font-family: monospace;
            letter-spacing: 1.2px;
        }

        .tag-data-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 4px;
            font-size: 11px;
            line-height: 1.25;
        }

        .tag-data-label {
            color: #64748b;
            font-weight: 600;
            flex-shrink: 0;
            margin-inline-end: 6px;
        }

        .tag-data-value {
            font-weight: 700;
            color: #0f172a;
            text-align: end;
            word-break: break-word;
        }

        .tag-qr-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            flex-shrink: 0;
        }

        .tag-footer-text {
            font-size: 8px;
            font-weight: 700;
            color: #475569;
            line-height: 1.25;
        }

        .tag-footer-sub {
            font-size: 7.5px;
            color: #94a3b8;
            font-weight: 600;
        }

        .toast-saved {
            display: none;
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 99999;
            background: #059669;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            font-weight: 600;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div id="saveToast" class="toast-saved">
        <i class="fa-solid fa-circle-check me-2"></i>
        <span>@(Loc.IsArabic ? $"تم حفظ التنسيق كافتراضي لقسم ({deptDisplayName}) بنجاح!" : $"Tag layout saved as default for {currentDept} department!")</span>
    </div>

    <!-- Customizer Toolbar -->
    <div class="customizer-panel no-print">
        <div class="customizer-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary p-2 rounded-circle">
                    <i class="fa-solid fa-tags text-white"></i>
                </span>
                <div>
                    <h6 class="mb-0 fw-bold">
                        @(Loc.IsArabic ? $"طباعة ملصقات أصول قسم ({deptDisplayName}) - ({Model.Count()} بطاقة)" : $"Bulk Asset Tag Printing - {currentDept} Dept ({Model.Count()} Cards)")
                    </h6>
                    <small class="text-muted">@(Loc.IsArabic ? $"التنسيق المحفوظ يطبق تلقائياً كافتراضي على كافة ملصقات قسم ({deptDisplayName})" : $"Customized layout applies exclusively as default for {currentDept} tags")</small>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (canEditParams)
                {
                    <button type="button" onclick="saveTagDefaults()" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm" title="@(Loc.IsArabic ? $"حفظ التنسيق كافتراضي لقسم ({deptDisplayName})" : $"Save layout as default for {currentDept} Department")">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>@(Loc.IsArabic ? $"حفظ كافتراضي لقسم ({deptDisplayName})" : $"Save as Default ({currentDept})")</span>
                    </button>
                    <button type="button" onclick="resetTagDefaults()" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" title="@Loc["Reset to Defaults"]">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>@(Loc.IsArabic ? "استعادة الافتراضي" : "Reset")</span>
                    </button>
                }
                <button type="button" onclick="window.print()" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
                    <i class="fa-solid fa-print"></i>
                    <span class="fw-bold">@Loc["Print All Labels"]</span>
                </button>
                <button type="button" onclick="window.close()" class="btn btn-outline-dark btn-sm">
                    @Loc["Close"]
                </button>
            </div>
        </div>

        <div class="customizer-body">
            @if (!canEditParams)
            {
                <div class="alert alert-warning py-2 px-3 small mb-3 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-lock text-warning fa-lg"></i>
                    <div>
                        <strong>@(Loc.IsArabic ? "وضع الطباعة فقط (تعديل المعلمات مقفل):" : "Print-Only Mode (Parameters Locked):")</strong>
                        @(Loc.IsArabic 
                            ? "يمكنك طباعة الملصقات بالتنسيق المعتمد للقسم دون تعديل. تعديل الترويسات والتذييلات والمعلمات المطبوعة يتطلب صلاحية (تعديل ملصقات الأجهزة)." 
                            : "You can print the tags using the department's authorized layout without modification. Modifying headers, footers, and printable parameters requires 'Edit Asset Tags' permission.")
                    </div>
                </div>
            }
            <div class="row g-3">
                <!-- Top & Bottom Header/Footer Texts -->
                <div class="col-lg-6">
                    <div class="card bg-light border-0 p-3 h-100">
                        <h6 class="fw-bold small text-uppercase text-secondary mb-2">
                            <i class="fa-solid fa-heading me-1 text-primary"></i>
                            @(Loc.IsArabic ? "نصوص البطاقة (العلوي والسفلي)" : "Card Header & Footer Texts")
                        </h6>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold mb-1">@(Loc.IsArabic ? "النص العلوي 1 (اسم المنشأة / القسم)" : "Top Header Line 1 (Facility / Org)")</label>
                            <input type="text" id="cfgTopLine1" class="form-control form-control-sm" oninput="updateAllCardsLive()" 
                                   value="@defaultTopLine1" @(canEditParams ? "" : "disabled readonly") />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold mb-1">@(Loc.IsArabic ? "النص العلوي 2 (عنوان بطاقة الأصل)" : "Top Header Line 2 (Card Title)")</label>
                            <input type="text" id="cfgTopLine2" class="form-control form-control-sm" oninput="updateAllCardsLive()" 
                                   value="@defaultTopLine2" @(canEditParams ? "" : "disabled readonly") />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold mb-1">@(Loc.IsArabic ? "النص السفلي (إخلاء المسؤولية / التحذير)" : "Bottom Footer Note (Warning / Ownership)")</label>
                            <input type="text" id="cfgBottomText" class="form-control form-control-sm" oninput="updateAllCardsLive()" 
                                   value="@defaultBottomText" @(canEditParams ? "" : "disabled readonly") />
                        </div>
                        <div>
                            <label class="form-label small fw-semibold mb-1">@(Loc.IsArabic ? "النص السفلي الثانوي (هاتف الدعم الفني)" : "Bottom Secondary Text (Helpline / Dept)")</label>
                            <input type="text" id="cfgBottomSub" class="form-control form-control-sm" oninput="updateAllCardsLive()" 
                                   value="@defaultBottomSub" @(canEditParams ? "" : "disabled readonly") />
                        </div>
                    </div>
                </div>

                <!-- QR Code & Card Layout Options -->
                <div class="col-lg-6">
                    <div class="card bg-light border-0 p-3 h-100">
                        <h6 class="fw-bold small text-uppercase text-secondary mb-2">
                            <i class="fa-solid fa-qrcode me-1 text-primary"></i>
                            @(Loc.IsArabic ? "خيارات رمز الاستجابة السريعة (QR Code)" : "QR Code & Layout Options")
                        </h6>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="cfgShowQR" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                            <label class="form-check-label fw-bold small" for="cfgShowQR">
                                @(Loc.IsArabic ? "تضمين رمز QR حقيقي على كل ملصق" : "Include Real QR Code on Each Card")
                            </label>
                            <div class="text-muted small" style="font-size: 0.72rem;">
                                @(Loc.IsArabic ? "يحتوي الرمز على نفس بيانات الأصل المعروضة على البطاقة ويمكن مسحه بكاميرا الهاتف" : "Encodes the card data (Tag, Serial, Type, Brand, Custodian, Calibration)")
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">@(Loc.IsArabic ? "حجم رمز QR" : "QR Code Size")</label>
                                <select id="cfgQRSize" class="form-select form-select-sm" @(canEditParams ? "" : "disabled") onchange="onQRSizeOrWidthChange()">
                                    <option value="75">@(Loc.IsArabic ? "مدمج (75 بكسل)" : "Compact (75px)")</option>
                                    <option value="90" selected>@(Loc.IsArabic ? "قياسي (90 بكسل)" : "Standard (90px)")</option>
                                    <option value="110">@(Loc.IsArabic ? "كبير (110 بكسل)" : "Large (110px)")</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold mb-1">@(Loc.IsArabic ? "عرض البطاقة" : "Card Width")</label>
                                <select id="cfgCardWidth" class="form-select form-select-sm" @(canEditParams ? "" : "disabled") onchange="onQRSizeOrWidthChange()">
                                    <option value="320px">@(Loc.IsArabic ? "ملصق مدمج (320px)" : "Compact Label (320px)")</option>
                                    <option value="360px" selected>@(Loc.IsArabic ? "قياسي (360px)" : "Standard Badge (360px)")</option>
                                    <option value="420px">@(Loc.IsArabic ? "بطاقة عريضة (420px)" : "Wide Placard (420px)")</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-2 pt-2 border-top">
                            <small class="text-muted d-block">
                                <i class="fa-solid fa-lightbulb text-warning me-1"></i>
                                @(Loc.IsArabic ? $"النقر على 'حفظ كافتراضي' سيجعل أي أصل تابع لقسم ({deptDisplayName}) يستخدم هذا التنسيق تلقائياً." : $"Clicking 'Save as Default' applies these settings exclusively as the default template for all {currentDept} asset tags.")
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Column / Fields Selection Checkboxes -->
                <div class="col-12">
                    <div class="card bg-light border-0 p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold small text-uppercase text-secondary mb-0">
                                <i class="fa-solid fa-table-columns me-1 text-primary"></i>
                                @(Loc.IsArabic ? "البيانات (الأعمدة) المراد تضمينها على البطاقة" : "Data Fields (Columns) to Include on Card")
                            </h6>
                            @if (canEditParams)
                            {
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="toggleAllColumns(true)">@Loc["Select All"]</button>
                                    <span class="text-muted">|</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="toggleAllColumns(false)">@Loc["Clear All"]</button>
                                </div>
                            }
                        </div>

                        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2">
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkHospitalNo" data-col="col-row-hospitalno" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkHospitalNo">@Loc["Hospital Tag / ID"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkSerial" data-col="col-row-serial" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkSerial">@Loc["Serial Number"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkType" data-col="col-row-type" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkType">@Loc["Equipment Type"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkBrand" data-col="col-row-brand" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkBrand">@Loc["Brand & Model"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkLocation" data-col="col-row-location" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkLocation">@Loc["Location"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkCustodian" data-col="col-row-custodian" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkCustodian">@Loc["Custodian"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkStatus" data-col="col-row-status" @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkStatus">@Loc["Status"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkCalibration" data-col="col-row-calibration" checked @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkCalibration">
                                        <i class="fa-solid fa-award text-success me-1"></i>
                                        @(Loc.IsArabic ? "حالة وتاريخ المعايرة الدورية" : "Periodic Calibration Status")
                                    </label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkPeriodic" data-col="col-row-periodic" @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkPeriodic">@Loc["Next Periodic Due"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkCommissioning" data-col="col-row-commissioning" @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkCommissioning">@Loc["Commissioning Date"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkWarranty" data-col="col-row-warranty" @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkWarranty">@Loc["Warranty Expiration"]</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input col-chk" type="checkbox" id="chkSupplier" data-col="col-row-supplier" @(canEditParams ? "" : "disabled") onchange="updateAllCardsLive()">
                                    <label class="form-check-label small" for="chkSupplier">@Loc["Supplier"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="bulk-grid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 no-print" style="grid-column: 1 / -1;">
                <i class="fa-solid fa-tags fa-3x text-muted mb-3 opacity-25"></i>
                <h5 class="fw-bold text-muted">@(Loc.IsArabic ? "لا توجد أصول مطابقة لمعايير التصفية لطباعة الملصقات" : "No matching assets to print for the selected filter criteria.")</h5>
            </div>
        }
        @foreach (var item in Model)
        {
            var itemTag = string.IsNullOrWhiteSpace(item.HospitalNo) ? $"ASSET-{item.Id:D5}" : item.HospitalNo;
            var itemUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Assets/Details/{item.Id}";

            <div class="tag-card" data-asset-id="@item.Id" data-tag="@itemTag" data-serial="@(item.SerialNo ?? "")" data-type="@(item.DisplayType ?? "")" data-brand="@(item.Brand ?? "")" data-room="@(item.Room?.DisplayName ?? "")" data-user="@(item.User?.DisplayFullName ?? "")" data-calib="@(item.NeedsCalibration == true ? (item.IsCalibrationOverdue ? "Overdue" : "Valid until " + item.NextCalibration?.ToString("yyyy-MM-dd")) : "Not Required")" data-cert="@(item.CalibrationCertNo ?? "")" data-url="@itemUrl">
                
                <div class="d-flex align-items-center justify-content-between border-bottom border-dark pb-2 mb-2">
                    <div>
                        <div class="tag-top-facility lbl-bulk-top1">@defaultTopLine1</div>
                        <div class="tag-top-title lbl-bulk-top2">@defaultTopLine2</div>
                    </div>
                    <div class="text-primary text-center">
                        <i class="fa-solid fa-shield-heart fa-lg"></i>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between gap-2 my-1 py-1">
                    <div class="flex-grow-1">
                        <div class="text-muted small" style="font-size: 9px; font-weight: 700; text-transform: uppercase;">@Loc["Asset Tag / ID"]</div>
                        <div class="tag-badge-pill mt-1">@itemTag</div>
                        <div class="tag-data-row mt-1 mb-0 col-row-serial-compact" style="font-size: 10px; display: none;">
                            <span class="text-muted font-monospace">SN: @(item.SerialNo ?? "N/A")</span>
                        </div>
                    </div>
                    <div class="tag-qr-container bulk-qr-box">
                        <div id="qr_@item.Id"></div>
                        <div class="mt-1 text-center font-monospace" style="font-size: 7px; color: #475569;">@itemTag</div>
                    </div>
                </div>

                <div class="border-top border-dark pt-2 mt-2 tag-data-container">
                    <div class="tag-data-row col-row-hospitalno">
                        <span class="tag-data-label">@Loc["Hospital Tag / ID"]:</span>
                        <span class="tag-data-value font-monospace">@itemTag</span>
                    </div>

                    <div class="tag-data-row col-row-serial">
                        <span class="tag-data-label">@Loc["Serial Number"]:</span>
                        <span class="tag-data-value font-monospace">@(item.SerialNo ?? "N/A")</span>
                    </div>

                    <div class="tag-data-row col-row-type">
                        <span class="tag-data-label">@Loc["Equipment Type"]:</span>
                        <span class="tag-data-value">@(item.DisplayType ?? "General Equipment")</span>
                    </div>

                    <div class="tag-data-row col-row-brand">
                        <span class="tag-data-label">@Loc["Brand & Model"]:</span>
                        <span class="tag-data-value">@(item.Brand ?? "Unbranded") @(item.ModelNo.HasValue ? item.ModelNo.ToString() : "")</span>
                    </div>

                    <div class="tag-data-row col-row-location">
                        <span class="tag-data-label">@Loc["Location"]:</span>
                        <span class="tag-data-value">@(item.Room?.DisplayName ?? Loc["Unassigned"])</span>
                    </div>

                    <div class="tag-data-row col-row-custodian">
                        <span class="tag-data-label">@Loc["Custodian"]:</span>
                        <span class="tag-data-value">@(item.User?.DisplayFullName ?? Loc["Central IT Stock"])</span>
                    </div>

                    <div class="tag-data-row col-row-status" style="display: none;">
                        <span class="tag-data-label">@Loc["Status"]:</span>
                        <span class="tag-data-value">@(item.DisplayStatus)</span>
                    </div>

                    <div class="tag-data-row col-row-calibration">
                        <span class="tag-data-label">@(Loc.IsArabic ? "المعايرة الدورية" : "Calibration"):</span>
                        <span class="tag-data-value">
                            @if (item.NeedsCalibration == true)
                            {
                                if (item.IsCalibrationOverdue)
                                {
                                    <span class="text-danger fw-bold">@(Loc.IsArabic ? "متأخرة" : "Overdue") (@item.NextCalibration?.ToString("yyyy-MM-dd"))</span>
                                }
                                else if (item.IsCalibrationDueSoon)
                                {
                                    <span class="text-warning fw-bold">@(Loc.IsArabic ? "تستحق قريباً" : "Due Soon") (@item.NextCalibration?.ToString("yyyy-MM-dd"))</span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold">@(Loc.IsArabic ? "معتمد وصالح" : "Valid") (@item.NextCalibration?.ToString("yyyy-MM-dd"))</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted fw-normal">@(Loc.IsArabic ? "غير مطلوبة" : "Not Required")</span>
                            }
                        </span>
                    </div>

                    <div class="tag-data-row col-row-periodic" style="display: none;">
                        <span class="tag-data-label">@Loc["Next Periodic Due"]:</span>
                        <span class="tag-data-value">@(item.NeedsPeriodic == true ? (item.NextPeriodic?.ToString("yyyy-MM-dd") ?? Loc["Not scheduled"]) : Loc["Not Required"])</span>
                    </div>

                    <div class="tag-data-row col-row-commissioning" style="display: none;">
                        <span class="tag-data-label">@Loc["Commissioning Date"]:</span>
                        <span class="tag-data-value">@(item.BuyingDate?.ToString("yyyy-MM-dd") ?? "N/A")</span>
                    </div>

                    <div class="tag-data-row col-row-warranty" style="display: none;">
                        <span class="tag-data-label">@Loc["Warranty Expiration"]:</span>
                        <span class="tag-data-value">@(item.WarrantyTill?.ToString("yyyy-MM-dd") ?? "N/A")</span>
                    </div>

                    <div class="tag-data-row col-row-supplier" style="display: none;">
                        <span class="tag-data-label">@Loc["Supplier"]:</span>
                        <span class="tag-data-value">@(item.Supplier?.DisplayName ?? "N/A")</span>
                    </div>
                </div>

                <div class="mt-2 pt-1 border-top border-dark text-center">
                    <div class="tag-footer-text lbl-bulk-bot">
                        @defaultBottomText
                    </div>
                    <div class="tag-footer-sub lbl-bulk-botsub">
                        @defaultBottomSub
                    </div>
                </div>

            </div>
        }
    </div>

    <script src="~/lib/qrcode.min.js"></script>
    <script>
        const CURRENT_DEPT = '@currentDept';
        const STORAGE_KEY = 'SOLVIS_AssetTagConfig_' + CURRENT_DEPT;
        const canEditTagParameters = @(canEditParams.ToString().ToLowerInvariant());

        document.addEventListener('DOMContentLoaded', function () {
            loadBulkDefaults();
            updateAllCardsLive();
            renderAllQRCodes();
        });

        function updateAllCardsLive() {
            const top1 = document.getElementById('cfgTopLine1').value;
            const top2 = document.getElementById('cfgTopLine2').value;
            const bot = document.getElementById('cfgBottomText').value;
            const botSub = document.getElementById('cfgBottomSub').value;
            const showQR = document.getElementById('cfgShowQR').checked;

            document.querySelectorAll('.lbl-bulk-top1').forEach(el => el.textContent = top1);
            document.querySelectorAll('.lbl-bulk-top2').forEach(el => el.textContent = top2);
            document.querySelectorAll('.lbl-bulk-bot').forEach(el => el.textContent = bot);
            document.querySelectorAll('.lbl-bulk-botsub').forEach(el => el.textContent = botSub);
            document.querySelectorAll('.bulk-qr-box').forEach(el => el.style.display = showQR ? 'flex' : 'none');

            // Update Card Width / Grid sizing
            const cardWidth = document.getElementById('cfgCardWidth')?.value || '360px';
            const grid = document.querySelector('.bulk-grid');
            if (grid) {
                grid.style.gridTemplateColumns = `repeat(auto-fill, minmax(${cardWidth}, 1fr))`;
            }

            // Update Column Visibility across ALL cards
            const colMapping = {
                'chkHospitalNo': '.col-row-hospitalno',
                'chkSerial': '.col-row-serial',
                'chkType': '.col-row-type',
                'chkBrand': '.col-row-brand',
                'chkLocation': '.col-row-location',
                'chkCustodian': '.col-row-custodian',
                'chkStatus': '.col-row-status',
                'chkCalibration': '.col-row-calibration',
                'chkPeriodic': '.col-row-periodic',
                'chkCommissioning': '.col-row-commissioning',
                'chkWarranty': '.col-row-warranty',
                'chkSupplier': '.col-row-supplier'
            };

            for (const [chkId, selector] of Object.entries(colMapping)) {
                const chk = document.getElementById(chkId);
                const isChecked = chk ? chk.checked : false;
                document.querySelectorAll(selector).forEach(el => {
                    el.style.display = isChecked ? 'flex' : 'none';
                });
            }
        }

        function onQRSizeOrWidthChange() {
            updateAllCardsLive();
            renderAllQRCodes();
        }

        function toggleAllColumns(selectAll) {
            if (!canEditTagParameters) return;
            document.querySelectorAll('.col-chk').forEach(chk => {
                chk.checked = selectAll;
            });
            updateAllCardsLive();
            renderAllQRCodes();
        }

        function renderAllQRCodes() {
            const showQR = document.getElementById('cfgShowQR')?.checked ?? true;
            if (!showQR) return;

            const qrSize = parseInt(document.getElementById('cfgQRSize')?.value) || 90;

            const showSerial = document.getElementById('chkSerial')?.checked ?? true;
            const showType = document.getElementById('chkType')?.checked ?? true;
            const showBrand = document.getElementById('chkBrand')?.checked ?? true;
            const showLoc = document.getElementById('chkLocation')?.checked ?? true;
            const showUser = document.getElementById('chkCustodian')?.checked ?? true;
            const showCalib = document.getElementById('chkCalibration')?.checked ?? true;

            document.querySelectorAll('.tag-card').forEach(card => {
                const id = card.getAttribute('data-asset-id');
                const tag = card.getAttribute('data-tag');
                const serial = card.getAttribute('data-serial');
                const type = card.getAttribute('data-type');
                const brand = card.getAttribute('data-brand');
                const room = card.getAttribute('data-room');
                const user = card.getAttribute('data-user');
                const calib = card.getAttribute('data-calib');
                const cert = card.getAttribute('data-cert');
                const url = card.getAttribute('data-url');

                const container = document.getElementById('qr_' + id);
                if (!container) return;
                container.innerHTML = '';

                let qrText = `[ASSET TAG: ${tag}]\n`;
                if (showSerial && serial) qrText += `SN: ${serial}\n`;
                if (showType && type) qrText += `Type: ${type}\n`;
                if (showBrand && brand) qrText += `Brand: ${brand}\n`;
                if (showLoc && room) qrText += `Room: ${room}\n`;
                if (showUser && user) qrText += `User: ${user}\n`;
                if (showCalib && calib) {
                    qrText += `Calib: ${calib}\n`;
                    if (cert) qrText += `Cert#: ${cert}\n`;
                }
                qrText += `URL: ${url}`;

                try {
                    new QRCode(container, {
                        text: qrText,
                        width: qrSize,
                        height: qrSize,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.M
                    });
                } catch (e) {
                    console.error("QR render error", e);
                }
            });
        }

        function saveTagDefaults() {
            if (!canEditTagParameters) return;
            const config = {
                topLine1: document.getElementById('cfgTopLine1').value,
                topLine2: document.getElementById('cfgTopLine2').value,
                bottomText: document.getElementById('cfgBottomText').value,
                bottomSub: document.getElementById('cfgBottomSub').value,
                showQR: document.getElementById('cfgShowQR').checked,
                qrSize: document.getElementById('cfgQRSize')?.value || '90',
                cardWidth: document.getElementById('cfgCardWidth')?.value || '360px',
                columns: {}
            };

            document.querySelectorAll('.col-chk').forEach(chk => {
                config.columns[chk.id] = chk.checked;
            });

            localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
            const toast = document.getElementById('saveToast');
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 2500);
        }

        function loadBulkDefaults() {
            let saved = localStorage.getItem(STORAGE_KEY);
            if (!saved) {
                saved = localStorage.getItem('SOLVIS_AssetTagConfig');
            }
            if (!saved) return;
            try {
                const config = JSON.parse(saved);
                if (config.topLine1 !== undefined) document.getElementById('cfgTopLine1').value = config.topLine1;
                if (config.topLine2 !== undefined) document.getElementById('cfgTopLine2').value = config.topLine2;
                if (config.bottomText !== undefined) document.getElementById('cfgBottomText').value = config.bottomText;
                if (config.bottomSub !== undefined) document.getElementById('cfgBottomSub').value = config.bottomSub;
                if (config.showQR !== undefined) document.getElementById('cfgShowQR').checked = config.showQR;
                if (config.qrSize !== undefined && document.getElementById('cfgQRSize')) document.getElementById('cfgQRSize').value = config.qrSize;
                if (config.cardWidth !== undefined && document.getElementById('cfgCardWidth')) document.getElementById('cfgCardWidth').value = config.cardWidth;

                if (config.columns) {
                    for (const [id, checked] of Object.entries(config.columns)) {
                        const elem = document.getElementById(id);
                        if (elem) elem.checked = checked;
                    }
                }
            } catch (e) {
                console.error("Failed to parse saved bulk tag config:", e);
            }
        }

        function resetTagDefaults() {
            if (!canEditTagParameters) return;
            localStorage.removeItem(STORAGE_KEY);
            localStorage.removeItem('SOLVIS_AssetTagConfig');
            location.reload();
        }
    </script>
</body>
</html>
