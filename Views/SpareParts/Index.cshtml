</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("sparePartSearchInput");
            if (searchInput) {
                let debounceTimer;
                searchInput.addEventListener("input", function () {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        this.form.submit();
                    }, 400);
                });
                if (searchInput.value) {
                    const len = searchInput.value.length;
                    searchInput.focus();
                    searchInput.setSelectionRange(len, len);
                }
            }
        });

        const sparePartFormsData = @Html.Raw(JsonSerializer.Serialize(Model.AvailableForms.Select(f => new {
            id = f.Id,
            name = f.Name,
            department = f.Department,
            fields = f.Fields
        })));

        function renderDynamicFormSpecs(formId, containerId, fieldsContainerId, existingSpecs = {}) {
            const container = document.getElementById(containerId);
            const fieldsContainer = document.getElementById(fieldsContainerId);
            if (!formId) {
                container.style.display = 'none';
                fieldsContainer.innerHTML = '';
                return;
            }

            const targetForm = sparePartFormsData.find(f => f.id == formId);
            if (!targetForm || !targetForm.fields || targetForm.fields.length === 0) {
                container.style.display = 'none';
                fieldsContainer.innerHTML = '';
                return;
            }

            container.style.display = 'block';
            fieldsContainer.innerHTML = '';

            targetForm.fields.forEach(field => {
                const col = document.createElement('div');
                col.className = 'col-md-6 mb-2';
                const fieldVal = existingSpecs[field.Name] || existingSpecs[field.name] || '';

                if (field.Type === 'select' && field.Options && field.Options.length > 0) {
                    let optsHtml = `<option value="">-- ${field.Label} --</option>`;
                    field.Options.forEach(opt => {
                        optsHtml += `<option value="${opt}" ${fieldVal === opt ? 'selected' : ''}>${opt}</option>`;
                    });
                    col.innerHTML = `
                        <label class="form-label small fw-bold text-dark">${field.Label} ${field.Required ? '<span class="text-danger">*</span>' : ''}</label>
                        <select name="spec_${field.Name}" class="form-select form-select-sm" ${field.Required ? 'required' : ''}>
                            ${optsHtml}
                        </select>
                    `;
                } else if (field.Type === 'number') {
                    col.innerHTML = `
                        <label class="form-label small fw-bold text-dark">${field.Label} ${field.Required ? '<span class="text-danger">*</span>' : ''}</label>
                        <input type="number" name="spec_${field.Name}" class="form-control form-control-sm" value="${fieldVal}" placeholder="${field.Placeholder || ''}" ${field.Required ? 'required' : ''} />
                    `;
                } else {
                    col.innerHTML = `
                        <label class="form-label small fw-bold text-dark">${field.Label} ${field.Required ? '<span class="text-danger">*</span>' : ''}</label>
                        <input type="text" name="spec_${field.Name}" class="form-control form-control-sm" value="${fieldVal}" placeholder="${field.Placeholder || ''}" ${field.Required ? 'required' : ''} />
                    `;
                }
                fieldsContainer.appendChild(col);
            });
        }

        function openGeneralRestockModal() {
            document.getElementById('restockPartId').value = '';
            document.getElementById('restockPartName').textContent = '@(isArabic ? "يرجى اختيار الصنف من القائمة أعلاه" : "Please select an item from dropdown")';
            document.getElementById('restockCurrentStock').textContent = '0';
            document.getElementById('restockUnit').textContent = 'Piece';
            document.getElementById('restockPartSelectWrapper').style.display = 'block';
            document.getElementById('restockItemDropdown').value = '';
            var modal = new bootstrap.Modal(document.getElementById('restockModal'));
            modal.show();
        }

        function onRestockItemChanged(selectEl) {
            const selectedOpt = selectEl.options[selectEl.selectedIndex];
            if (selectedOpt && selectedOpt.value) {
                document.getElementById('restockPartId').value = selectedOpt.value;
                document.getElementById('restockPartName').textContent = selectedOpt.getAttribute('data-name');
                document.getElementById('restockCurrentStock').textContent = selectedOpt.getAttribute('data-stock');
                document.getElementById('restockUnit').textContent = selectedOpt.getAttribute('data-unit') || 'Piece';
            }
        }

        function openRestockModal(id, name, currentStock, unit) {
            document.getElementById('restockPartId').value = id;
            document.getElementById('restockPartName').textContent = name;
            document.getElementById('restockCurrentStock').textContent = currentStock;
            document.getElementById('restockUnit').textContent = unit || 'Piece';
            document.getElementById('restockPartSelectWrapper').style.display = 'block';
            document.getElementById('restockItemDropdown').value = id;
            var modal = new bootstrap.Modal(document.getElementById('restockModal'));
            modal.show();
        }

        function openCommissionModal(id, name, dept, sku) {
            document.getElementById('commissionPartId').value = id;
            document.getElementById('commissionPartName').textContent = name;
            document.getElementById('commissionPartSku').textContent = 'SKU / Part #: ' + (sku || 'N/A') + ' | Department: ' + dept;
            
            var prefix = 'HOSP-' + (dept ? dept.substring(0, 3) : 'AST') + '-';
            var randomSuffix = Math.floor(100 + Math.random() * 900);
            document.getElementById('commissionHospitalNo').value = prefix + randomSuffix;

            var modal = new bootstrap.Modal(document.getElementById('commissionModal'));
            modal.show();
        }

        function openEditModal(id, name, nameAr, sku, dept, category, minReserve, unit, storage, canAsset, compat, notes, formId, specsJson, compAssetIdsJson) {
            document.getElementById('editPartId').value = id;
            document.getElementById('editPartName').value = name;
            document.getElementById('editPartNameAr').value = nameAr;
            document.getElementById('editPartNumber').value = sku;
            var deptSelect = document.getElementById('editDepartment');
            if (deptSelect) deptSelect.value = dept;
            var deptDisplay = document.getElementById('editDepartmentDisplay');
            if (deptDisplay) deptDisplay.value = dept;
            document.getElementById('editCategory').value = category;
            document.getElementById('editMinReserve').value = minReserve;
            document.getElementById('editUnit').value = unit;
            document.getElementById('editStorageLocation').value = storage;
            document.getElementById('editCanAssetCheck').checked = canAsset === true;
            document.getElementById('editCompatibleEquipment').value = compat;
            document.getElementById('editNotes').value = notes;

            // Form Template & Specs
            var formSelect = document.getElementById('editPartFormSelect');
            if (formSelect) {
                formSelect.value = formId || '';
                var specsObj = {};
                try { specsObj = JSON.parse(specsJson || '{}'); } catch(e) {}
                renderDynamicFormSpecs(formId, 'editDynamicSpecsContainer', 'editDynamicSpecsFields', specsObj);
            }

            // Compatible Assets
            var assetsSelect = document.getElementById('editCompatibleAssetsSelect');
            if (assetsSelect) {
                var assetIds = [];
                try { assetIds = JSON.parse(compAssetIdsJson || '[]'); } catch(e) {}
                for (var i = 0; i < assetsSelect.options.length; i++) {
                    var opt = assetsSelect.options[i];
                    opt.selected = assetIds.includes(parseInt(opt.value));
                }
            }

            var modal = new bootstrap.Modal(document.getElementById('editPartModal'));
            modal.show();
        }
    </script>
}
