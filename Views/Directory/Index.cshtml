<!-- Modal: Add Supplier -->
<div class="modal fade" id="addSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateSupplier" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-truck-fast text-primary me-2"></i> @Loc["Add Vendor / Supplier"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["Vendor / Company Name"] <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Siemens Healthineers, Dell Technologies" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["Service Scope"]</label>
                        <select name="Type" class="form-select">
                            <option value="1">@(Loc.IsArabic ? "توريد أجهزة ومعدات فقط" : "Equipment & Items Supply Only")</option>
                            <option value="2">@(Loc.IsArabic ? "صيانة وإصلاحات فقط" : "Maintenance & Repair Provider Only")</option>
                            <option value="3" selected>@(Loc.IsArabic ? "خدمات متكاملة (توريد وصيانة)" : "Full Service (Hardware Supply & Maintenance Provider)")</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">@Loc["Authorized Maintenance Departments"]</label>
                        <div class="form-text small text-muted mb-2">@(Loc.IsArabic ? "حدد الأقسام التي يمكنها إرسال الأجهزة لهذا المورد:" : "Check the teams that can view and dispatch equipment to this vendor:")</div>
                        <div class="d-flex flex-column gap-2 p-3 border rounded bg-light">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedDepartments" value="IT" id="addDeptIT" checked>
                                <label class="form-check-label fw-semibold text-primary" for="addDeptIT">
                                    <i class="fa-solid fa-laptop me-1"></i> @Loc["IT Support"]
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedDepartments" value="BIOMEDICAL" id="addDeptBio">
                                <label class="form-check-label fw-semibold text-info-emphasis" for="addDeptBio">
                                    <i class="fa-solid fa-heart-pulse me-1"></i> @Loc["Biomedical"]
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedDepartments" value="GENERAL" id="addDeptGen">
                                <label class="form-check-label fw-semibold text-warning-emphasis" for="addDeptGen">
                                    <i class="fa-solid fa-wrench me-1"></i> @Loc["General"]
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h6 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-address-card me-2"></i> @Loc["Vendor Focal Point (Contact Person)"]</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Contact Person Name"]</label>
                            <input type="text" name="FocalPointName" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "اسم مسؤول التواصل" : "e.g. John Smith")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Position / Title"]</label>
                            <input type="text" name="FocalPointPosition" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "المسمى الوظيفي" : "e.g. Service Manager")" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Phone 1 (with Ext)"]</label>
                            <input type="text" name="FocalPointPhone1" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "الهاتف الأرضي مع التحويلة" : "e.g. +961 1 234567 Ext 104")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Phone 2 (Mobile)"]</label>
                            <input type="text" name="FocalPointPhone2" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "رقم الهاتف المحمول" : "e.g. +961 70 123456")" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">@Loc["Email Address"]</label>
                        <input type="email" name="FocalPointEmail" class="form-control form-control-sm" placeholder="contact@vendor.com" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Loc["Save Supplier"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

