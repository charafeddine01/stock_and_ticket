                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Contact Person Name"]</label>
                            <input type="text" name="focalPointName" id="editFocalPointName" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "اسم مسؤول التواصل" : "e.g. John Smith")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Position / Title"]</label>
                            <input type="text" name="focalPointPosition" id="editFocalPointPosition" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "المسمى الوظيفي" : "e.g. Service Manager")" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Phone 1 (with Ext)"]</label>
                            <input type="text" name="focalPointPhone1" id="editFocalPointPhone1" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "الهاتف الأرضي مع التحويلة" : "e.g. +961 1 234567 Ext 104")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">@Loc["Phone 2 (Mobile)"]</label>
                            <input type="text" name="focalPointPhone2" id="editFocalPointPhone2" class="form-control form-control-sm" placeholder="@(Loc.IsArabic ? "رقم الهاتف المحمول" : "e.g. +961 70 123456")" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">@Loc["Email Address"]</label>
                        <input type="email" name="focalPointEmail" id="editFocalPointEmail" class="form-control form-control-sm" placeholder="contact@vendor.com" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Loc["Save Vendor Changes"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Department -->
<div class="modal fade" id="addDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateDepartment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@Loc["Add Department"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["Department Name"]</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Neurology & Stroke Unit" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Loc["Save Department"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleTeamSelect(userId) {
        var roleSelect = document.getElementById('role-select-' + userId);
        var container = document.getElementById('team-container-' + userId);
        if (roleSelect && container) {
            container.style.display = (roleSelect.value === 'MAINTENANCE') ? 'block' : 'none';
        }
    }

    function toggleNewUserTeam() {
        var roleSelect = document.getElementById('newRoleSelect');
        var container = document.getElementById('newUserTeamContainer');
        if (roleSelect && container) {
            container.style.display = (roleSelect.value === 'MAINTENANCE') ? 'block' : 'none';
        }
    }

    // Modal Edit Supplier form population
    function populateEditSupplierForm(id, name, type, deptsJson, isActive, fpName, fpPos, fpPhone1, fpPhone2, fpEmail) {
        document.getElementById('editSupplierId').value = id;
        document.getElementById('editSupplierName').value = name || '';
        document.getElementById('editSupplierType').value = type || '3';
        document.getElementById('editSupplierActive').value = (isActive === true || isActive === 'true') ? 'true' : 'false';

        // Focal Point fields
        document.getElementById('editFocalPointName').value = fpName || '';
        document.getElementById('editFocalPointPosition').value = fpPos || '';
        document.getElementById('editFocalPointPhone1').value = fpPhone1 || '';
        document.getElementById('editFocalPointPhone2').value = fpPhone2 || '';
        document.getElementById('editFocalPointEmail').value = fpEmail || '';

        // Reset checkboxes
        document.getElementById('editDeptIT').checked = false;
        document.getElementById('editDeptBio').checked = false;
        document.getElementById('editDeptGen').checked = false;

        try {
            var depts = typeof deptsJson === 'string' ? JSON.parse(deptsJson) : deptsJson;
            if (Array.isArray(depts)) {
                depts.forEach(function (d) {
                    var upper = (d || '').toUpperCase();
                    if (upper === 'IT') document.getElementById('editDeptIT').checked = true;
                    if (upper === 'BIOMEDICAL') document.getElementById('editDeptBio').checked = true;
                    if (upper === 'GENERAL') document.getElementById('editDeptGen').checked = true;
                });
            }
        } catch (e) {
            console.error('Error parsing supplier departments:', e);
        }
    }

    var editModalElement = document.getElementById('editSupplierModal');
    if (editModalElement) {
        editModalElement.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button) return;

            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            var type = button.getAttribute('data-type');
            var depts = button.getAttribute('data-departments');
            var isActive = button.getAttribute('data-isactive') === 'true';
            var fpName = button.getAttribute('data-fp-name') || '';
            var fpPos = button.getAttribute('data-fp-pos') || '';
            var fpPhone1 = button.getAttribute('data-fp-phone1') || '';
            var fpPhone2 = button.getAttribute('data-fp-phone2') || '';
            var fpEmail = button.getAttribute('data-fp-email') || '';

            populateEditSupplierForm(id, name, type, depts, isActive, fpName, fpPos, fpPhone1, fpPhone2, fpEmail);
        });
    }

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-edit-supplier');
        if (btn) {
            var id = btn.getAttribute('data-id');
            var name = btn.getAttribute('data-name');
            var type = btn.getAttribute('data-type');
            var depts = btn.getAttribute('data-departments');
            var isActive = btn.getAttribute('data-isactive') === 'true';
            var fpName = btn.getAttribute('data-fp-name') || '';
            var fpPos = btn.getAttribute('data-fp-pos') || '';
            var fpPhone1 = btn.getAttribute('data-fp-phone1') || '';
            var fpPhone2 = btn.getAttribute('data-fp-phone2') || '';
            var fpEmail = btn.getAttribute('data-fp-email') || '';

            populateEditSupplierForm(id, name, type, depts, isActive, fpName, fpPos, fpPhone1, fpPhone2, fpEmail);
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editSupplierModal'));
            modal.show();
        }
    });

    window.openEditSupplierModal = function(id, name, type, deptsJson, isActive, fpName, fpPos, fpPhone1, fpPhone2, fpEmail) {
        populateEditSupplierForm(id, name, type, deptsJson, isActive, fpName, fpPos, fpPhone1, fpPhone2, fpEmail);
        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editSupplierModal'));
        modal.show();
    };

    var currentSupplierDeptFilter = 'ALL';

    function filterSuppliersByDept(dept, btnElement) {
        currentSupplierDeptFilter = dept;
        if (btnElement) {
            var group = document.getElementById('supplierDeptFilterGroup');
            if (group) {
                var buttons = group.querySelectorAll('button');
                buttons.forEach(function (btn) { btn.classList.remove('active'); });
                btnElement.classList.add('active');
            }
        }
        applySupplierFilters();
    }

    function filterSupplierTableByKeyword() {
        applySupplierFilters();
    }

    function applySupplierFilters() {
        var keyword = (document.getElementById('supplierSearchInput')?.value || '').toLowerCase().trim();
        var rows = document.querySelectorAll('#suppliersTable tbody tr.supplier-row');

        rows.forEach(function (row) {
            var name = (row.getAttribute('data-name') || '').toLowerCase();
            var deptsAttr = row.getAttribute('data-departments') || '[]';
            var depts = [];
            try { depts = JSON.parse(deptsAttr); } catch (e) { depts = []; }
            var upperDepts = depts.map(function(d) { return (d || '').toUpperCase(); });

            var matchesDept = false;
            if (currentSupplierDeptFilter === 'ALL') {
                matchesDept = true;
            } else if (currentSupplierDeptFilter === 'COMMON') {
                matchesDept = (upperDepts.length === 0 || upperDepts.length > 1 || upperDepts.indexOf('COMMON') >= 0 || upperDepts.indexOf('ALL') >= 0);
            } else {
                matchesDept = (upperDepts.length === 0 || upperDepts.indexOf(currentSupplierDeptFilter) >= 0 || upperDepts.indexOf('COMMON') >= 0 || upperDepts.indexOf('ALL') >= 0);
            }

            var matchesKeyword = (!keyword || name.indexOf(keyword) >= 0);

            if (matchesDept && matchesKeyword) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    document.querySelectorAll('#dirTabs button[data-bs-toggle="tab"]').forEach(function (tabBtn) {
        tabBtn.addEventListener('shown.bs.tab', function (e) {
            var target = e.target.getAttribute('data-bs-target');
            if (target) {
                var tabName = target.replace('#', '');
                localStorage.setItem('activeDirectoryTab', tabName);
                var url = new URL(window.location);
                url.searchParams.set('tab', tabName);
                window.history.replaceState({}, '', url);
            }
        });
    });

    document.addEventListener('DOMContentLoaded', function () {
        var urlParams = new URLSearchParams(window.location.search);
        var tabParam = urlParams.get('tab');
        var hash = window.location.hash ? window.location.hash.replace('#', '') : null;
        var savedTab = localStorage.getItem('activeDirectoryTab');

        var targetTab = tabParam || hash || savedTab;
        if (targetTab) {
            var tabBtn = document.getElementById(targetTab + '-tab') || document.querySelector('#dirTabs button[data-bs-target="#' + targetTab + '"]');
            if (tabBtn) {
                var tabInstance = bootstrap.Tab.getOrCreateInstance(tabBtn);
                tabInstance.show();
            }
        }
    });
</script>
}
