@{
    ViewData["Title"] = Loc["Master Directory & Administration"];
    var users = ViewBag.Users as List<StockPortal.Models.User> ?? new();
    var rooms = ViewBag.Rooms as List<StockPortal.Models.Room> ?? new();
    var suppliers = ViewBag.Suppliers as List<StockPortal.Models.Supplier> ?? new();
    var departments = ViewBag.Departments as List<StockPortal.Models.Department> ?? new();
    var activeTab = (ViewBag.ActiveTab as string) ?? "users";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-0">@Loc["Master Directory & Configuration"]</h4>
        <small class="text-muted">@Loc["Manage hospital departments, staff users, physical room locations, and authorized vendors"]</small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 d-flex align-items-center gap-2" title="@(Loc.IsArabic ? "تم التحقق التلقائي من هوية النطاق وصلاحيات قاعدة البيانات المباشرة" : "Automatic Domain & Live Database Admin Handshake Verified")">
            <i class="fa-solid fa-shield-check text-success"></i>
            <span>@(Loc.IsArabic ? $"المصادقة النشطة: {ViewBag.HandshakeUser ?? "Admin"}" : $"Domain & Live DB Verified: {ViewBag.HandshakeUser ?? "Admin"}")</span>
        </span>
    </div>
</div>

<!-- Tabs for Directory Items -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-0">
        <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="dirTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "users" ? "active" : "") fw-semibold" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">
                    <i class="fa-solid fa-users me-1"></i> @Loc["Staff & Users"] (@users.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "rooms" ? "active" : "") fw-semibold" id="rooms-tab" data-bs-toggle="tab" data-bs-target="#rooms" type="button" role="tab">
                    <i class="fa-solid fa-door-open me-1"></i> @Loc["Rooms & Locations"] (@rooms.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "suppliers" ? "active" : "") fw-semibold" id="suppliers-tab" data-bs-toggle="tab" data-bs-target="#suppliers" type="button" role="tab">
                    <i class="fa-solid fa-truck-field me-1"></i> @Loc["Suppliers & Vendors"] (@suppliers.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "depts" ? "active" : "") fw-semibold" id="depts-tab" data-bs-toggle="tab" data-bs-target="#depts" type="button" role="tab">
                    <i class="fa-solid fa-building me-1"></i> @Loc["Departments"] (@departments.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="dirTabsContent">
            <!-- 1. Users Tab -->
            <div class="tab-pane fade @(activeTab == "users" ? "show active" : "")" id="users" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0">@Loc["Hospital Staff & Users"]</h6>
                        <small class="text-muted">@(Loc.IsArabic ? "المستخدمون النشطون يتم التحقق من هويتهم تلقائياً عبر اسم مستخدم حاسوبهم. المستخدمون المعطلون يتم رفضهم." : "Users with Active status are automatically authenticated via their PC username. Inactive users are rejected.")</small>
                    </div>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
                        <i class="fa-solid fa-plus me-1"></i> @Loc["Add User"]
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Loc["Full Name"]</th>
                                <th>@Loc["PC / Windows Username"]</th>
                                <th>@Loc["Department Name"]</th>
                                <th>@Loc["System Role"]</th>
                                <th>@Loc["Maintenance Team"]</th>
                                <th>@Loc["Auto-Login Status"]</th>
                                <th class="text-end">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in users)
                            {
                                <tr>
                                    <td>@u.Id</td>
                                    <td class="fw-semibold">@u.DisplayFullName</td>
                                    <td><code class="text-primary fw-bold bg-light px-2 py-1 rounded">@(u.DomainUser ?? "-")</code></td>
                                    <td>@(u.Department?.DisplayName ?? Loc["Unassigned"])</td>
                                    <td>
                                        @switch (u.Role?.ToUpperInvariant())
                                        {
                                            case "ADMIN":
                                                <span class="badge bg-danger"><i class="fa-solid fa-shield-halved me-1"></i> @(Loc.IsArabic ? "مدير النظام (ADMIN)" : "ADMIN")</span>
                                                break;
                                            case "MAINTENANCE":
                                                <span class="badge bg-primary"><i class="fa-solid fa-wrench me-1"></i> @(Loc.IsArabic ? "صيانة" : "MAINTENANCE") (@Loc.TargetTeam(u.MaintenanceTeam ?? "GENERAL"))</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary"><i class="fa-solid fa-user me-1"></i> @(Loc.IsArabic ? "مستخدم قياسي" : "END_USER")</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (u.Role?.ToUpperInvariant() == "MAINTENANCE")
                                        {
                                            <div>
                                                <span class="badge @(u.MaintenanceTeam == "BIOMEDICAL" ? "bg-info text-dark" : u.MaintenanceTeam == "GENERAL" ? "bg-warning text-dark" : "bg-dark")">
                                                    @Loc.TargetTeam(u.MaintenanceTeam ?? "IT")
                                                </span>
                                            </div>
                                            <div class="mt-1 d-flex flex-wrap gap-1">
                                                <span class="badge @(u.CanPrintAssetTags ? "bg-light text-primary border" : "bg-light text-muted opacity-50")" title="@(Loc.IsArabic ? "صلاحية طباعة الملصقات" : "Print Tags Privilege")">
                                                    <i class="fa-solid fa-print"></i>
                                                </span>
                                                <span class="badge @(u.CanEditAssetTags ? "bg-light text-success border" : "bg-light text-muted opacity-50")" title="@(Loc.IsArabic ? "صلاحية تعديل الأجهزة" : "Edit Assets Privilege")">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </span>
                                                <span class="badge @(u.CanAccessTeamAnalytics ? "bg-light text-info border" : "bg-light text-muted opacity-50")" title="@(Loc.IsArabic ? "تحليلات الفريق" : "Team Analytics Privilege")">
                                                    <i class="fa-solid fa-chart-line"></i>
                                                </span>
                                                <span class="badge @(u.CanViewOwnAnalytics ? "bg-light text-warning border" : "bg-light text-muted opacity-50")" title="@(Loc.IsArabic ? "التحليلات الشخصية" : "Personal Analytics Privilege")">
                                                    <i class="fa-solid fa-user-check"></i>
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsActive == true)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                                <i class="fa-solid fa-circle-check me-1"></i> @Loc["Active (Auto-Login)"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                                <i class="fa-solid fa-ban me-1"></i> @Loc["Inactive (Rejected)"]
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-warning me-1" data-bs-toggle="modal" data-bs-target="#resetPasswordModal-@u.Id" title="@Loc["Reset Password"]">
                                            <i class="fa-solid fa-key"></i> @Loc["Reset Password"]
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#editRoleModal-@u.Id" title="@Loc["Manage Role & Team"]">
                                            <i class="fa-solid fa-user-gear"></i> @Loc["Manage Role & Team"]
                                        </button>
                                        <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm @(u.IsActive == true ? "btn-outline-danger" : "btn-outline-success")" title="@Loc["Active Status"]">
                                                @(u.IsActive == true ? Loc["Deactivate"] : Loc["Activate"])
                                            </button>
                                        </form>

                                        <!-- Modal: Reset Password -->
                                        <div class="modal fade text-start" id="resetPasswordModal-@u.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="ResetPassword" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@u.Id" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">
                                                                <i class="fa-solid fa-key text-warning me-2"></i> @Loc["Reset Password"]: @u.DisplayFullName
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="alert alert-info py-2 small mb-3">
                                                                <i class="fa-solid fa-circle-info me-1"></i>
                                                                @(Loc.IsArabic ? $"إعادة تعيين كلمة المرور للمستخدم ({u.DomainUser}). سيتمكن المستخدم من تسجيل الدخول بها فوراً." : $"Reset password for ({u.DomainUser}). The user will be able to log in with this new password immediately.")
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold small">@Loc["New Password"] <span class="text-danger">*</span></label>
                                                                <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required minlength="6" />
                                                                <div class="form-text small text-muted">@(Loc.IsArabic ? "الحد الأدنى 6 أحرف" : "Minimum 6 characters")</div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold small">@Loc["Confirm Password"] <span class="text-danger">*</span></label>
                                                                <input type="password" name="confirmPassword" class="form-control" placeholder="••••••••" required minlength="6" />
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                                                            <button type="submit" class="btn btn-warning btn-sm">
                                                                <i class="fa-solid fa-check me-1"></i> @Loc["Reset Password"]
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Modal: Edit Role & Team -->
                                        <div class="modal fade text-start" id="editRoleModal-@u.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="UpdateUserRole" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@u.Id" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">@Loc["Manage Role & Team"]: @u.DisplayFullName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold">@Loc["System Role"]</label>
                                                                <select name="role" id="role-select-@u.Id" class="form-select" onchange="toggleTeamSelect(@u.Id)">
                                                                    <option value="ADMIN" selected="@(u.Role?.ToUpperInvariant() == "ADMIN")">@(Loc.IsArabic ? "مدير النظام (صلاحيات كاملة)" : "ADMIN (Full System Access)")</option>
                                                                    <option value="MAINTENANCE" selected="@(u.Role?.ToUpperInvariant() == "MAINTENANCE")">@(Loc.IsArabic ? "مهندس / فني صيانة (فريق محدد)" : "MAINTENANCE (Assigned Maintenance Team)")</option>
                                                                    <option value="END_USER" selected="@(u.Role?.ToUpperInvariant() == "END_USER" || string.IsNullOrWhiteSpace(u.Role))">@(Loc.IsArabic ? "مستخدم عادي (كادر المستشفى)" : "END_USER (Standard Staff)")</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3" id="team-container-@u.Id" style="@(u.Role?.ToUpperInvariant() == "MAINTENANCE" ? "" : "display:none;")">
                                                                <label class="form-label fw-semibold">@Loc["Target Maintenance Team"]</label>
                                                                <select name="maintenanceTeam" class="form-select">
                                                                    <option value="IT" selected="@(u.MaintenanceTeam == "IT" || string.IsNullOrWhiteSpace(u.MaintenanceTeam))">@Loc.TargetTeam("IT")</option>
                                                                    <option value="BIOMEDICAL" selected="@(u.MaintenanceTeam == "BIOMEDICAL")">@Loc.TargetTeam("BIOMEDICAL")</option>
                                                                    <option value="GENERAL" selected="@(u.MaintenanceTeam == "GENERAL")">@Loc.TargetTeam("GENERAL")</option>
                                                                </select>
                                                                <div class="form-text small mb-3">@(Loc.IsArabic ? "مستخدمو الصيانة يمكنهم معالجة تذاكر فريقهم فقط." : "Maintenance users can view and handle tickets directed to their team only.")</div>

                                                                <div class="border rounded p-3 bg-light">
                                                                    <label class="form-label fw-bold text-dark mb-2">
                                                                        <i class="fa-solid fa-user-shield me-1 text-primary"></i> @Loc["Maintenance Team Privileges"]
                                                                    </label>
                                                                    <div class="form-check form-switch mb-2">
                                                                        <input class="form-check-input" type="checkbox" role="switch" name="canPrintAssetTags" id="printTags-@u.Id" value="true" @(u.CanPrintAssetTags ? "checked" : "") />
                                                                        <input type="hidden" name="canPrintAssetTags" value="false" />
                                                                        <label class="form-check-label fw-semibold" for="printTags-@u.Id">
                                                                            <i class="fa-solid fa-print me-1 text-primary"></i> @Loc["Print Asset Tags"]
                                                                        </label>
                                                                        <div class="form-text small text-muted">@Loc["Print QR & thermal asset tags without changing parameters (headers, footers and data fields locked)."]</div>
                                                                    </div>
                                                                    <div class="form-check form-switch mb-2">
                                                                        <input class="form-check-input" type="checkbox" role="switch" name="canEditAssetTags" id="editTags-@u.Id" value="true" @(u.CanEditAssetTags ? "checked" : "") />
                                                                        <input type="hidden" name="canEditAssetTags" value="false" />
                                                                        <label class="form-check-label fw-semibold" for="editTags-@u.Id">
                                                                            <i class="fa-solid fa-pen-to-square me-1 text-success"></i> @Loc["Edit Asset Tags"]
                                                                        </label>
                                                                        <div class="form-text small text-muted">@Loc["Edit asset details & customize printable tag parameters (headers, footers, and data fields)."]</div>
                                                                    </div>
                                                                    <div class="form-check form-switch mb-2">
                                                                        <input class="form-check-input" type="checkbox" role="switch" name="canAccessTeamAnalytics" id="teamAnalytics-@u.Id" value="true" @(u.CanAccessTeamAnalytics ? "checked" : "") />
                                                                        <input type="hidden" name="canAccessTeamAnalytics" value="false" />
                                                                        <label class="form-check-label fw-semibold" for="teamAnalytics-@u.Id">
                                                                            <i class="fa-solid fa-chart-line me-1 text-info"></i> @Loc["Maintenance Team Analytics Tab"]
                                                                        </label>
                                                                        <div class="form-text small text-muted">@Loc["Access the team-wide analytics dashboard for this maintenance discipline."]</div>
                                                                    </div>
                                                                    <div class="form-check form-switch mb-1">
                                                                        <input class="form-check-input" type="checkbox" role="switch" name="canViewOwnAnalytics" id="ownAnalytics-@u.Id" value="true" @(u.CanViewOwnAnalytics ? "checked" : "") />
                                                                        <input type="hidden" name="canViewOwnAnalytics" value="false" />
                                                                        <label class="form-check-label fw-semibold" for="ownAnalytics-@u.Id">
                                                                            <i class="fa-solid fa-user-check me-1 text-warning"></i> @Loc["View Personal Analytics"]
                                                                        </label>
                                                                        <div class="form-text small text-muted">@Loc["View own individual technician workload statistics and generate member activity report."]</div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                                                            <button type="submit" class="btn btn-primary">@Loc["Save Role & Team"]</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Rooms Tab -->
            <div class="tab-pane fade @(activeTab == "rooms" ? "show active" : "")" id="rooms" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">@Loc["Hospital Rooms & Floors"]</h6>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addRoomModal">
                        <i class="fa-solid fa-plus me-1"></i> @Loc["Add Room"]
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Loc["Room Number"]</th>
                                <th>@Loc["Floor"]</th>
                                <th>@Loc["Display Reference"]</th>
                                <th class="text-end">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in rooms)
                            {
                                <tr>
                                    <td>@r.Id</td>
                                    <td class="fw-semibold"><i class="fa-solid fa-door-closed text-muted me-2"></i> @Loc["Room Number"] @r.RoomNo</td>
                                    <td>@Loc["Floor"] @r.Floor</td>
                                    <td><span class="badge bg-light text-dark border">@r.DisplayName</span></td>
                                    <td class="text-end">
                                        <form asp-action="DeleteRoom" method="post" class="d-inline" onsubmit="return confirm('@(Loc.IsArabic ? $"هل أنت متأكد من حذف الغرفة {r.RoomNo}؟" : $"Delete Room {r.RoomNo}?")');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash me-1"></i> @Loc["Delete"]
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. Suppliers Tab -->
            <div class="tab-pane fade @(activeTab == "suppliers" ? "show active" : "")" id="suppliers" role="tabpanel">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h6 class="fw-bold mb-0">@Loc["Approved Suppliers & Vendors"]</h6>
                        <small class="text-muted">@(Loc.IsArabic ? "مفروزين حسب تخصصات الصيانة المدعومة (تقنية المعلومات، الأجهزة الطبية، الصيانة العامة)" : "Filtered by supported maintenance teams (IT, Biomedical, General) with common multi-department vendors")</small>
                    </div>
                    @if (ViewBag.CanManageUsers != false)
                    {
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
                            <i class="fa-solid fa-plus me-1"></i> @Loc["Add Vendor / Supplier"]
                        </button>
                    }
                </div>

                <!-- Department Filter Controls -->
                <div class="card bg-light border-0 mb-3 shadow-none">
                    <div class="card-body p-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="btn-group btn-group-sm" role="group" id="supplierDeptFilterGroup">
                            <button type="button" class="btn btn-outline-dark active" onclick="filterSuppliersByDept('ALL', this)">
                                <i class="fa-solid fa-border-all me-1"></i> @Loc["All Vendors"] (@suppliers.Count)
                            </button>
                            <button type="button" class="btn btn-outline-primary" onclick="filterSuppliersByDept('IT', this)">
                                <i class="fa-solid fa-laptop me-1"></i> @Loc["IT Support"] (@suppliers.Count(s => s.SupportsDepartment("IT")))
                            </button>
                            <button type="button" class="btn btn-outline-info" onclick="filterSuppliersByDept('BIOMEDICAL', this)">
                                <i class="fa-solid fa-heart-pulse me-1"></i> @Loc["Biomedical"] (@suppliers.Count(s => s.SupportsDepartment("BIOMEDICAL")))
                            </button>
                            <button type="button" class="btn btn-outline-warning text-dark" onclick="filterSuppliersByDept('GENERAL', this)">
                                <i class="fa-solid fa-wrench me-1"></i> @Loc["General"] (@suppliers.Count(s => s.SupportsDepartment("GENERAL")))
                            </button>
                            <button type="button" class="btn btn-outline-success" onclick="filterSuppliersByDept('COMMON', this)">
                                <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> @Loc["Common / Shared"] (@suppliers.Count(s => !s.DepartmentList.Any() || s.DepartmentList.Count > 1))
                            </button>
                        </div>

                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" id="supplierSearchInput" class="form-control" placeholder="@Loc["Search vendor name..."]" onkeyup="filterSupplierTableByKeyword()" />
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="suppliersTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Loc["Vendor / Company Name"]</th>
                                <th>@Loc["Focal Point / Contact"]</th>
                                <th>@Loc["Service Scope"]</th>
                                <th>@Loc["Authorized Maintenance Departments"]</th>
                                <th>@Loc["Status"]</th>
                                <th class="text-end">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in suppliers)
                            {
                                var depts = s.DepartmentList;
                                string deptsAttr = string.IsNullOrWhiteSpace(s.Departments) ? "[]" : s.Departments;
                                <tr class="supplier-row"
                                    data-supplier-id="@s.Id"
                                    data-name="@s.Name"
                                    data-type="@(s.Type ?? 3)"
                                    data-departments='@deptsAttr'
                                    data-isactive="@(s.IsActive == true ? "true" : "false")"
                                    data-fp-name="@s.FocalPointName"
                                    data-fp-pos="@s.FocalPointPosition"
                                    data-fp-phone1="@s.FocalPointPhone1"
                                    data-fp-phone2="@s.FocalPointPhone2"
                                    data-fp-email="@s.FocalPointEmail">
                                    <td>@s.Id</td>
                                    <td class="fw-semibold">
                                        <i class="fa-solid fa-truck text-muted me-2"></i>
                                        <span class="supplier-name-cell">@s.DisplayName</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.FocalPointName) || !string.IsNullOrWhiteSpace(s.FocalPointPhone1) || !string.IsNullOrWhiteSpace(s.FocalPointPhone2) || !string.IsNullOrWhiteSpace(s.FocalPointEmail))
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                @if (!string.IsNullOrWhiteSpace(s.FocalPointName))
                                                {
                                                    <div class="fw-semibold text-dark">
                                                        <i class="fa-solid fa-user-tie text-primary me-1"></i> @s.FocalPointName
                                                        @if (!string.IsNullOrWhiteSpace(s.FocalPointPosition))
                                                        {
                                                            <span class="badge bg-light text-secondary border ms-1 font-monospace" style="font-size: 0.72rem;">@s.FocalPointPosition</span>
                                                        }
                                                    </div>
                                                }
                                                <div class="small text-muted d-flex flex-wrap gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(s.FocalPointPhone1))
                                                    {
                                                        <span title="@Loc["Phone 1 (with Ext)"]"><i class="fa-solid fa-phone text-secondary me-1"></i> @s.FocalPointPhone1</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(s.FocalPointPhone2))
                                                    {
                                                        <span title="@Loc["Phone 2 (Mobile)"]"><i class="fa-solid fa-mobile-screen text-success me-1"></i> <a href="tel:@s.FocalPointPhone2" class="text-decoration-none text-success">@s.FocalPointPhone2</a></span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(s.FocalPointEmail))
                                                    {
                                                        <span title="@Loc["Email Address"]"><i class="fa-solid fa-envelope text-info me-1"></i> <a href="mailto:@s.FocalPointEmail" class="text-decoration-none text-info">@s.FocalPointEmail</a></span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><em>@Loc["No focal point recorded"]</em></span>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@s.DisplayTypeName</span></td>
                                    <td>
                                        @if (!depts.Any())
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                                <i class="fa-solid fa-globe me-1"></i> @Loc["Common to All Departments"]
                                            </span>
                                        }
                                        else
                                        {
                                            @if (depts.Any(d => string.Equals(d, "IT", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <span class="badge bg-primary me-1"><i class="fa-solid fa-laptop me-1"></i> @Loc["IT"]</span>
                                            }
                                            @if (depts.Any(d => string.Equals(d, "BIOMEDICAL", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <span class="badge bg-info text-dark me-1"><i class="fa-solid fa-heart-pulse me-1"></i> @Loc["BIOMEDICAL"]</span>
                                            }
                                            @if (depts.Any(d => string.Equals(d, "GENERAL", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <span class="badge bg-warning text-dark me-1"><i class="fa-solid fa-wrench me-1"></i> @Loc["GENERAL"]</span>
                                            }
                                            @foreach (var extra in depts.Where(d => !string.Equals(d, "IT", StringComparison.OrdinalIgnoreCase) && !string.Equals(d, "BIOMEDICAL", StringComparison.OrdinalIgnoreCase) && !string.Equals(d, "GENERAL", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <span class="badge bg-secondary me-1">@extra</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(s.IsActive == true ? "bg-success" : "bg-secondary")">
                                            @(s.IsActive == true ? Loc["Active Vendor"] : Loc["Inactive"])
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (ViewBag.CanManageUsers != false)
                                        {
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-primary me-1 btn-edit-supplier" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#editSupplierModal"
                                                    data-id="@s.Id"
                                                    data-name="@s.Name"
                                                    data-type="@(s.Type ?? 3)"
                                                    data-departments="@deptsAttr"
                                                    data-isactive="@(s.IsActive == true ? "true" : "false")"
                                                    data-fp-name="@s.FocalPointName"
                                                    data-fp-pos="@s.FocalPointPosition"
                                                    data-fp-phone1="@s.FocalPointPhone1"
                                                    data-fp-phone2="@s.FocalPointPhone2"
                                                    data-fp-email="@s.FocalPointEmail"
                                                    title="@Loc["Edit"]">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> @Loc["Edit"]
                                            </button>
                                            <form asp-action="ToggleSupplierStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm @(s.IsActive == true ? "btn-outline-secondary" : "btn-outline-success")">
                                                    @(s.IsActive == true ? Loc["Deactivate"] : Loc["Activate"])
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="fa-solid fa-check text-success me-1"></i> @(Loc.IsArabic ? "مصرح" : "Authorized")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. Departments Tab -->
            <div class="tab-pane fade @(activeTab == "depts" ? "show active" : "")" id="depts" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">@Loc["Hospital Departments"]</h6>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addDeptModal">
                        <i class="fa-solid fa-plus me-1"></i> @Loc["Add Department"]
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Loc["Department Name"]</th>
                                <th>@Loc["Department Head"]</th>
                                <th class="text-end">@Loc["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in departments)
                            {
                                <tr>
                                    <td>@d.Id</td>
                                    <td class="fw-semibold">@d.DisplayName</td>
                                    <td>@(d.HeadUser?.DisplayFullName ?? Loc["None assigned"])</td>
                                    <td class="text-end">
                                        <form asp-action="DeleteDepartment" method="post" class="d-inline" onsubmit="return confirm('@(Loc.IsArabic ? $"هل أنت متأكد من حذف القسم {d.DisplayName}؟" : $"Remove department {d.Name}?")');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash me-1"></i> @Loc["Remove"]
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add User -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">@Loc["Add User"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["Full Name"] <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" placeholder="@(Loc.IsArabic ? "مثال: د. محمد أحمد" : "e.g. John Doe")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["PC / Windows Username"] <span class="text-danger">*</span></label>
                        <input type="text" name="DomainUser" class="form-control font-monospace" placeholder="e.g. @Environment.UserName" required />
                        <div class="form-text small text-muted">
                            <i class="fa-solid fa-circle-info me-1"></i> @(Loc.IsArabic ? "يجب أن يتطابق مع اسم حساب ويندوز للكمبيوتر لتسجيل الدخول التلقائي." : "Must match the user's computer account name. Auto-login grants instant access when they open the site from their PC.")
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["System Role"] <span class="text-danger">*</span></label>
                        <select name="Role" id="newRoleSelect" class="form-select" onchange="toggleNewUserTeam()">
                            <option value="END_USER" selected>@(Loc.IsArabic ? "مستخدم عادي (كادر المستشفى)" : "END_USER (Standard Staff)")</option>
                            <option value="MAINTENANCE">@(Loc.IsArabic ? "مهندس / فني صيانة" : "MAINTENANCE (Assigned Maintenance Team)")</option>
                            <option value="ADMIN">@(Loc.IsArabic ? "مدير النظام (صلاحيات كاملة)" : "ADMIN (Full System Access)")</option>
                        </select>
                    </div>
                    <div class="mb-3" id="newUserTeamContainer" style="display: none;">
                        <label class="form-label fw-semibold">@Loc["Target Maintenance Team"]</label>
                        <select name="MaintenanceTeam" class="form-select mb-3">
                            <option value="IT" selected>@Loc.TargetTeam("IT")</option>
                            <option value="BIOMEDICAL">@Loc.TargetTeam("BIOMEDICAL")</option>
                            <option value="GENERAL">@Loc.TargetTeam("GENERAL")</option>
                        </select>
                        <div class="border rounded p-3 bg-light">
                            <label class="form-label fw-bold text-dark mb-2">
                                <i class="fa-solid fa-user-shield me-1 text-primary"></i> @Loc["Maintenance Team Privileges"]
                            </label>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch" name="CanPrintAssetTags" id="newPrintTags" value="true" checked />
                                <input type="hidden" name="CanPrintAssetTags" value="false" />
                                <label class="form-check-label fw-semibold" for="newPrintTags">
                                    <i class="fa-solid fa-print me-1 text-primary"></i> @Loc["Print Asset Tags"]
                                </label>
                                <div class="form-text small text-muted">@Loc["Print QR & thermal asset tags without changing parameters (headers, footers and data fields locked)."]</div>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch" name="CanEditAssetTags" id="newEditTags" value="true" checked />
                                <input type="hidden" name="CanEditAssetTags" value="false" />
                                <label class="form-check-label fw-semibold" for="newEditTags">
                                    <i class="fa-solid fa-pen-to-square me-1 text-success"></i> @Loc["Edit Asset Tags"]
                                </label>
                                <div class="form-text small text-muted">@Loc["Edit asset details & customize printable tag parameters (headers, footers, and data fields)."]</div>
                            </div>
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" role="switch" name="CanAccessTeamAnalytics" id="newTeamAnalytics" value="true" checked />
                                <input type="hidden" name="CanAccessTeamAnalytics" value="false" />
                                <label class="form-check-label fw-semibold" for="newTeamAnalytics">
                                    <i class="fa-solid fa-chart-line me-1 text-info"></i> @Loc["Maintenance Team Analytics Tab"]
                                </label>
                                <div class="form-text small text-muted">@Loc["Access the team-wide analytics dashboard for this maintenance discipline."]</div>
                            </div>
                            <div class="form-check form-switch mb-1">
                                <input class="form-check-input" type="checkbox" role="switch" name="CanViewOwnAnalytics" id="newOwnAnalytics" value="true" checked />
                                <input type="hidden" name="CanViewOwnAnalytics" value="false" />
                                <label class="form-check-label fw-semibold" for="newOwnAnalytics">
                                    <i class="fa-solid fa-user-check me-1 text-warning"></i> @Loc["View Personal Analytics"]
                                </label>
                                <div class="form-text small text-muted">@Loc["View own individual technician workload statistics and generate member activity report."]</div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["Department Name"]</label>
                        <select name="DepartmentId" class="form-select">
                            <option value="">-- @(Loc.IsArabic ? "بدون قسم" : "None") --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.Id">@d.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-key me-1 text-primary"></i> @Loc["Initial Password"]
                        </label>
                        <input type="password" name="initialPassword" class="form-control" placeholder="••••••••" minlength="6" />
                        <div class="form-text small text-muted">
                            @(Loc.IsArabic ? "اختياري لتسجيل الدخول من الهواتف والأجهزة غير المرتبطة بالدومين. إذا تُرك فارغاً سيتم تعيين كلمة مرور افتراضية تلقائياً." : "Optional for login on mobile devices or outside Windows SSO. Defaults to standard password if left blank.")
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Loc["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Loc["Save User"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

