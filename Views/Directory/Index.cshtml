@section Scripts {
<script>
    function toggleTeamSelect(userId) {
        var roleSelect = document.getElementById('role-select-' + userId);
        var container = document.getElementById('team-container-' + userId);
        if (roleSelect && container) {
            container.style.display = (roleSelect.value === 'MAINTENANCE') ? 'block' : 'none';
        }
    }

    function toggleNewUserTeam() {
        var roleSelect = document.getElementById('newRoleSelect');
        var container = document.getElementById('newUserTeamContainer');
        if (roleSelect && container) {
            container.style.display = (roleSelect.value === 'MAINTENANCE') ? 'block' : 'none';
        }
    }

    // Modal Edit Supplier form population
    function populateEditSupplierForm(id, name, type, deptsJson, isActive) {
        document.getElementById('editSupplierId').value = id;
        document.getElementById('editSupplierName').value = name || '';
        document.getElementById('editSupplierType').value = type || '3';
        document.getElementById('editSupplierActive').value = (isActive === true || isActive === 'true') ? 'true' : 'false';

        // Reset checkboxes
        document.getElementById('editDeptIT').checked = false;
        document.getElementById('editDeptBio').checked = false;
        document.getElementById('editDeptGen').checked = false;

        try {
            var depts = typeof deptsJson === 'string' ? JSON.parse(deptsJson) : deptsJson;
            if (Array.isArray(depts)) {
                depts.forEach(function (d) {
                    var upper = (d || '').toUpperCase();
                    if (upper === 'IT') document.getElementById('editDeptIT').checked = true;
                    if (upper === 'BIOMEDICAL') document.getElementById('editDeptBio').checked = true;
                    if (upper === 'GENERAL') document.getElementById('editDeptGen').checked = true;
                });
            }
        } catch (e) {
            console.error('Error parsing supplier departments:', e);
        }
    }

    // Direct event listener for Bootstrap modal show
    var editModalElement = document.getElementById('editSupplierModal');
    if (editModalElement) {
        editModalElement.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            if (!button) return;

            var id = button.getAttribute('data-id');
            var name = button.getAttribute('data-name');
            var type = button.getAttribute('data-type');
            var depts = button.getAttribute('data-departments');
            var isActive = button.getAttribute('data-isactive') === 'true';

            populateEditSupplierForm(id, name, type, depts, isActive);
        });
    }

    // Delegated click handler as backup
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.btn-edit-supplier');
        if (btn) {
            var id = btn.getAttribute('data-id');
            var name = btn.getAttribute('data-name');
            var type = btn.getAttribute('data-type');
            var depts = btn.getAttribute('data-departments');
            var isActive = btn.getAttribute('data-isactive') === 'true';

            populateEditSupplierForm(id, name, type, depts, isActive);
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editSupplierModal'));
            modal.show();
        }
    });

    // Global function fallback
    window.openEditSupplierModal = function(id, name, type, deptsJson, isActive) {
        populateEditSupplierForm(id, name, type, deptsJson, isActive);
        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editSupplierModal'));
        modal.show();
    };

    // Dynamic Filter for Supplier Table
    var currentSupplierDeptFilter = 'ALL';

    function filterSuppliersByDept(dept, btnElement) {
        currentSupplierDeptFilter = dept;

        // Toggle active button style
        if (btnElement) {
            var group = document.getElementById('supplierDeptFilterGroup');
            if (group) {
                var buttons = group.querySelectorAll('button');
                buttons.forEach(function (btn) { btn.classList.remove('active'); });
                btnElement.classList.add('active');
            }
        }

        applySupplierFilters();
    }

    function filterSupplierTableByKeyword() {
        applySupplierFilters();
    }

    function applySupplierFilters() {
        var keyword = (document.getElementById('supplierSearchInput')?.value || '').toLowerCase().trim();
        var rows = document.querySelectorAll('#suppliersTable tbody tr.supplier-row');

        rows.forEach(function (row) {
            var name = (row.getAttribute('data-name') || '').toLowerCase();
            var deptsAttr = row.getAttribute('data-departments') || '[]';
            var depts = [];
            try { depts = JSON.parse(deptsAttr); } catch (e) { depts = []; }
            var upperDepts = depts.map(function(d) { return (d || '').toUpperCase(); });

            var matchesDept = false;
            if (currentSupplierDeptFilter === 'ALL') {
                matchesDept = true;
            } else if (currentSupplierDeptFilter === 'COMMON') {
                matchesDept = (upperDepts.length === 0 || upperDepts.length > 1 || upperDepts.indexOf('COMMON') >= 0 || upperDepts.indexOf('ALL') >= 0);
            } else {
                matchesDept = (upperDepts.length === 0 || upperDepts.indexOf(currentSupplierDeptFilter) >= 0 || upperDepts.indexOf('COMMON') >= 0 || upperDepts.indexOf('ALL') >= 0);
            }

            var matchesKeyword = (!keyword || name.indexOf(keyword) >= 0);

            if (matchesDept && matchesKeyword) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    // Remember active tab when user clicks tabs
    document.querySelectorAll('#dirTabs button[data-bs-toggle="tab"]').forEach(function (tabBtn) {
        tabBtn.addEventListener('shown.bs.tab', function (e) {
            var target = e.target.getAttribute('data-bs-target');
            if (target) {
                var tabName = target.replace('#', '');
                localStorage.setItem('activeDirectoryTab', tabName);
                var url = new URL(window.location);
                url.searchParams.set('tab', tabName);
                window.history.replaceState({}, '', url);
            }
        });
    });

    // Restore active tab on page load (URL param > hash > localStorage)
    document.addEventListener('DOMContentLoaded', function () {
        var urlParams = new URLSearchParams(window.location.search);
        var tabParam = urlParams.get('tab');
        var hash = window.location.hash ? window.location.hash.replace('#', '') : null;
        var savedTab = localStorage.getItem('activeDirectoryTab');

        var targetTab = tabParam || hash || savedTab;
        if (targetTab) {
            var tabBtn = document.getElementById(targetTab + '-tab') || document.querySelector('#dirTabs button[data-bs-target="#' + targetTab + '"]');
            if (tabBtn) {
                var tabInstance = bootstrap.Tab.getOrCreateInstance(tabBtn);
                tabInstance.show();
            }
        }
    });
</script>
}
