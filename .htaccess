# SOLVIS Apache / LiteSpeed Web Server Configuration
# Optimized for hosting.com cPanel Shared Hosting (PHP 8.2+)

Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html

# Prevent direct browser access to sensitive files and database files
<FilesMatch "^(config\.php|\.env|\.git.*|.*\.db|.*\.sqlite|.*\.sql|.*\.csproj|.*\.cs)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect database directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to database folder
    RewriteRule ^database/ - [F,L]

    # Allow direct access to existing files and directories (CSS, JS, images in wwwroot, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# MIME Types for WebM & MP4 logo animation
<IfModule mod_mime.c>
    AddType video/webm .webm
    AddType video/mp4 .mp4
    AddType image/svg+xml .svg
    AddType text/css .css
    AddType application/javascript .js
</IfModule>

# Security & Compression Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
